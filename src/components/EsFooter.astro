---
import { esSeoLandingPages } from "../data/esSeoLandingPages";
import { brand } from "@/lib/brand";

const totalSpanishCount = esSeoLandingPages.length + 7;
---

<footer class="border-t border-white/10 bg-ocean-950/95 py-12 text-xs text-slate-400 font-body">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-5">
      <div>
        <a href="/es" class="inline-flex min-h-[44px] items-center gap-2.5 font-bold text-white font-display text-sm">
          <span class="flex h-7 w-7 items-center justify-center rounded-lg bg-gradient-to-tr from-gold-500 to-amber-300 text-ocean-950 font-black text-xs">
            G
          </span>
          <span>{brand.productName} Español</span>
        </a>
        <p class="mt-2 leading-relaxed">
          Transferencia de archivos pesados de 5 GB a 500 GB+ con descarga en 1 clic sin registro, paquetes prepagos de 12 meses ($20/100GB • $180/1TB) y servidores CDN Anycast en Madrid, Ciudad de México, Bogotá, Buenos Aires y Santiago.
        </p>
      </div>

      <div>
        <p class="font-bold text-white font-display uppercase tracking-wider text-[11px]">
          Nodos Regionales Anycast
        </p>
        <ul class="mt-3 space-y-1.5">
          <li><a class="inline-flex min-h-[36px] items-center hover:text-gold-400 transition-colors" href="/es">Central Español ({totalSpanishCount} Guías)</a></li>
          <li><a class="inline-flex min-h-[36px] items-center hover:text-gold-400 transition-colors" href="/es/mexico">🇲🇽 Nodo México (MEX • GDL • MTY)</a></li>
          <li><a class="inline-flex min-h-[36px] items-center hover:text-gold-400 transition-colors" href="/es/espana">🇪🇸 Nodo España (MAD • BCN • VLC)</a></li>
          <li><a class="inline-flex min-h-[36px] items-center hover:text-gold-400 transition-colors" href="/es/colombia">🇨🇴 Nodo Colombia (BOG • MDE • CLO)</a></li>
          <li><a class="inline-flex min-h-[36px] items-center hover:text-gold-400 transition-colors" href="/es/argentina">🇦🇷 Nodo Argentina (EZE • COR • ROS)</a></li>
        </ul>
      </div>

      <div>
        <p class="font-bold text-white font-display uppercase tracking-wider text-[11px]">
          Capacidades y Tamaños
        </p>
        <ul class="mt-3 space-y-1.5">
          <li><a class="inline-flex min-h-[36px] items-center hover:text-gold-400 transition-colors" href="/es/enviar-archivos-mas-de-2gb">Enviar Archivos de Más de 2 GB</a></li>
          <li><a class="inline-flex min-h-[36px] items-center hover:text-gold-400 transition-colors" href="/es/enviar-archivos-10gb">Enviar Archivos de 10 GB Gratis</a></li>
          <li><a class="inline-flex min-h-[36px] items-center hover:text-gold-400 transition-colors" href="/es/enviar-archivos-20gb">Enviar Archivos de 20 GB Gratis</a></li>
          <li><a class="inline-flex min-h-[36px] items-center hover:text-gold-400 transition-colors" href="/es/enviar-archivos-50gb">Mandar Archivos de 50 GB ($10)</a></li>
          <li><a class="inline-flex min-h-[36px] items-center hover:text-gold-400 transition-colors" href="/es/enviar-archivos-100gb">Enviar Archivos de 100 GB ($20)</a></li>
        </ul>
      </div>

      <div>
        <p class="font-bold text-white font-display uppercase tracking-wider text-[11px]">
          Alternativas y Soluciones
        </p>
        <ul class="mt-3 space-y-1.5">
          <li><a class="inline-flex min-h-[36px] items-center hover:text-gold-400 transition-colors" href="/es/alternativas-a-wetransfer">Alternativas a WeTransfer Gratis</a></li>
          <li><a class="inline-flex min-h-[36px] items-center hover:text-gold-400 transition-colors" href="/es/superar-limite-2gb-wetransfer">Superar Límite 2 GB WeTransfer</a></li>
          <li><a class="inline-flex min-h-[36px] items-center hover:text-gold-400 transition-colors" href="/es/enviar-archivos-whatsapp-sin-perder-calidad">Videos 4K por WhatsApp Sin Comprimir</a></li>
          <li><a class="inline-flex min-h-[36px] items-center hover:text-gold-400 transition-colors" href="/es/enviar-video-largo-correo">Enviar Video Largo por Correo</a></li>
          <li><a class="inline-flex min-h-[36px] items-center hover:text-gold-400 transition-colors" href="/es/transferencia-archivos-pago-por-uso">Pago por Uso (Sin Suscripción)</a></li>
        </ul>
      </div>

      <div>
        <p class="font-bold text-white font-display uppercase tracking-wider text-[11px]">
          Formatos Profesionales
        </p>
        <ul class="mt-3 space-y-1.5">
          <li><a class="inline-flex min-h-[36px] items-center hover:text-gold-400 transition-colors" href="/es/enviar-videos-sin-perder-calidad">Videos 4K/8K Sin Perder Calidad</a></li>
          <li><a class="inline-flex min-h-[36px] items-center hover:text-gold-400 transition-colors" href="/es/enviar-archivos-prores">Apple ProRes 422 HQ & RAW</a></li>
          <li><a class="inline-flex min-h-[36px] items-center hover:text-gold-400 transition-colors" href="/es/transferir-proyectos-davinci-resolve">DaVinci Resolve & BRAW</a></li>
          <li><a class="inline-flex min-h-[36px] items-center hover:text-gold-400 transition-colors" href="/es/transferir-archivos-cad-bim">Proyectos AutoCAD & Revit BIM</a></li>
          <li><a class="inline-flex min-h-[36px] items-center hover:text-gold-400 transition-colors" href="/es/enviar-archivos-sin-registro">Entrega Ejecutiva Sin Registro</a></li>
        </ul>
      </div>
    </div>

    <div class="mt-8 flex flex-wrap items-center justify-between gap-4 border-t border-white/10 pt-6">
      <p>© {new Date().getFullYear()} {brand.productName}. Todos los derechos reservados.</p>
      <div class="flex flex-wrap items-center gap-4">
        <a
          class="inline-flex min-h-[40px] items-center hover:text-gold-400 transition-colors"
          href="/?lang=en"
          onclick="document.cookie='gigasend_lang=en; path=/; max-age=31536000; SameSite=Lax'"
        >
          🇺🇸 English (Global)
        </a>
        <a
          class="inline-flex min-h-[40px] items-center text-gold-400 font-bold"
          href="/es"
          onclick="document.cookie='gigasend_lang=es; path=/; max-age=31536000; SameSite=Lax'"
        >
          🇪🇸 Español ({totalSpanishCount} Páginas)
        </a>
        <a
          class="inline-flex min-h-[40px] items-center hover:text-gold-400 transition-colors"
          href="/pt"
          onclick="document.cookie='gigasend_lang=pt; path=/; max-age=31536000; SameSite=Lax'"
        >
          🇧🇷 Português (Brasil)
        </a>
        <a class="inline-flex min-h-[40px] items-center hover:text-gold-400 transition-colors" href="/directory">
          Directorio Completo
        </a>
        <a class="inline-flex min-h-[40px] items-center hover:text-gold-400 transition-colors" href="/sitemap-es.xml">
          Sitemap ES
        </a>
      </div>
    </div>
  </div>
</footer>
