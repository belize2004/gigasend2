---
import { brand } from "@/lib/brand";
---

<footer class="border-t border-white/10 bg-ocean-950/95 py-12 text-xs text-slate-400 font-body">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
      <div>
        <a href="/es" class="inline-flex min-h-[44px] items-center gap-2.5 font-bold text-white font-display text-sm">
          <span aria-hidden="true" class="flex h-7 w-7 items-center justify-center rounded-lg bg-gradient-to-tr from-gold-500 to-amber-300 text-ocean-950 font-black text-xs">
            G
          </span>
          <span>{brand.productName}</span>
        </a>
        <p class="mt-2 leading-relaxed">
          Envía archivos pesados con hasta 10 GB gratis (retención de 3 días), descarga en un clic sin registro y paquetes prepagos válidos por 12 meses con servidores locales de alta velocidad en España y Latinoamérica.
        </p>
      </div>

      <div>
        <p class="font-bold text-white font-display tracking-wider text-xs">
          Regiones
        </p>
        <ul class="mt-3 space-y-1.5">
          <li><a class="inline-flex min-h-[36px] items-center hover:text-gold-400 transition-colors" href="/es">Central en español</a></li>
          <li><a class="inline-flex min-h-[36px] items-center hover:text-gold-400 transition-colors" href="/es/mexico">🇲🇽 México</a></li>
          <li><a class="inline-flex min-h-[36px] items-center hover:text-gold-400 transition-colors" href="/es/espana">🇪🇸 España</a></li>
          <li><a class="inline-flex min-h-[36px] items-center hover:text-gold-400 transition-colors" href="/es/colombia">🇨🇴 Colombia</a></li>
          <li><a class="inline-flex min-h-[36px] items-center hover:text-gold-400 transition-colors" href="/es/argentina">🇦🇷 Argentina</a></li>
        </ul>
      </div>

      <div>
        <p class="font-bold text-white font-display tracking-wider text-xs">
          Casos de uso y guías
        </p>
        <ul class="mt-3 space-y-1.5">
          <li><a class="inline-flex min-h-[36px] items-center hover:text-gold-400 transition-colors" href="/es/enviar-archivos-mas-de-2gb">Enviar archivos de más de 2 GB</a></li>
          <li><a class="inline-flex min-h-[36px] items-center hover:text-gold-400 transition-colors" href="/es/enviar-videos-sin-perder-calidad">Vídeos 4K y 8K sin comprimir</a></li>
          <li><a class="inline-flex min-h-[36px] items-center hover:text-gold-400 transition-colors" href="/es/alternativas-a-wetransfer">Alternativa a WeTransfer</a></li>
          <li><a class="inline-flex min-h-[36px] items-center hover:text-gold-400 transition-colors" href="/es/enviar-archivos-sin-registro">Enviar archivos sin registro</a></li>
          <li><a class="inline-flex min-h-[36px] items-center hover:text-gold-400 transition-colors" href="/es#guias-completas">Todas las guías en español</a></li>
        </ul>
      </div>

      <div>
        <p class="font-bold text-white font-display tracking-wider text-xs">
          Producto y legal
        </p>
        <ul class="mt-3 space-y-1.5">
          <li><a class="inline-flex min-h-[36px] items-center hover:text-gold-400 transition-colors" href="/plans">Planes y precios</a></li>
          <li><a class="inline-flex min-h-[36px] items-center hover:text-gold-400 transition-colors" href="/compare">Comparar servicios</a></li>
          <li><a class="inline-flex min-h-[36px] items-center hover:text-gold-400 transition-colors" href="/security">Seguridad y privacidad</a></li>
          <li><a class="inline-flex min-h-[36px] items-center hover:text-gold-400 transition-colors" href="/terms">Términos de servicio</a></li>
          <li><a class="inline-flex min-h-[36px] items-center hover:text-gold-400 transition-colors" href="/privacy">Política de privacidad</a></li>
        </ul>
      </div>
    </div>

    <div class="mt-8 flex flex-wrap items-center justify-between gap-4 border-t border-white/10 pt-6">
      <p>© {new Date().getFullYear()} {brand.productName}. Todos los derechos reservados.</p>
      <div class="flex flex-wrap items-center gap-4">
        <a
          class="inline-flex min-h-[40px] items-center hover:text-gold-400 transition-colors"
          href="/?lang=en"
          onclick="document.cookie='gigasend_lang=en; path=/; max-age=31536000; SameSite=Lax'"
        >
          🇺🇸 English
        </a>
        <a
          class="inline-flex min-h-[40px] items-center text-gold-400 font-bold"
          href="/es"
          onclick="document.cookie='gigasend_lang=es; path=/; max-age=31536000; SameSite=Lax'"
        >
          🇪🇸 Español
        </a>
        <a
          class="inline-flex min-h-[40px] items-center hover:text-gold-400 transition-colors"
          href="/pt"
          onclick="document.cookie='gigasend_lang=pt; path=/; max-age=31536000; SameSite=Lax'"
        >
          🇧🇷 Português
        </a>
      </div>
    </div>
  </div>
</footer>
