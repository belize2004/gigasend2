---
interface Props {
  currentSlug: string;
  internalLinks?: Array<{ href: string; label: string }>;
  title?: string;
  category?: string;
}

const {
  currentSlug,
  internalLinks = [],
  title = "Related Transfer Solutions & Workflows",
} = Astro.props;

// Filter out any self-linking
const normalizedCurrent = currentSlug.replace(/^\/(bypass|send)\//, "").replace(/\/$/, "");

const safeInternalLinks = internalLinks.filter((link) => {
  const normTarget = link.href.replace(/^\/(bypass|send)\//, "").replace(/\/$/, "").replace(/^\//, "");
  return normTarget !== normalizedCurrent;
});

const fallbackLinks = [
  { href: "/send-large-files-free", label: "Send Large Files Free" },
  { href: "/wetransfer-alternative", label: "WeTransfer Alternative" },
  { href: "/send-large-video-files", label: "Send Large Video Files" },
  { href: "/dropbox-transfer-alternative", label: "Dropbox Transfer Alternative" },
  { href: "/google-drive-download-quota-exceeded-fix", label: "Google Drive Quota Fix" },
  { href: "/fastest-way-to-send-large-files", label: "Fastest File Transfer" },
].filter((link) => {
  const normTarget = link.href.replace(/^\/(bypass|send)\//, "").replace(/\/$/, "").replace(/^\//, "");
  return normTarget !== normalizedCurrent;
});

const displayedLinks = (safeInternalLinks.length > 0 ? safeInternalLinks : fallbackLinks).slice(0, 6);
---

<section class="border-t border-white/10 bg-ocean-950 py-12 font-body">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <div>
        <p class="text-xs font-semibold uppercase tracking-wider text-gold-400 label-caps">Related Workflows</p>
        <h2 class="mt-1 text-xl font-black text-white font-display sm:text-2xl">{title}</h2>
      </div>
      <a
        href="/directory"
        class="inline-flex items-center gap-1.5 text-sm font-semibold text-gold-400 hover:text-gold-300 transition-colors"
      >
        <span>Explore all workflows →</span>
      </a>
    </div>

    <div class="mt-6 flex flex-wrap gap-3">
      {displayedLinks.map((link) => (
        <a
          class="apple-subtle-glass rounded-xl border border-white/10 bg-ocean-900/70 px-4 py-2.5 text-xs font-semibold text-slate-200 shadow-sm transition hover:border-gold-500/50 hover:bg-ocean-900 hover:text-gold-400 tap-tactile"
          href={link.href}
        >
          {link.label}
        </a>
      ))}
    </div>
  </div>
</section>

