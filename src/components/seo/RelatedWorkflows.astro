---
interface Props {
  currentSlug: string;
  internalLinks?: Array<{ href: string; label: string }>;
  title?: string;
  category?: string;
}

const {
  currentSlug,
  internalLinks = [],
  title = "Related Transfer Solutions & Workflows",
} = Astro.props;

// Filter out any self-linking
const normalizedCurrent = currentSlug.replace(/^\/(bypass|send)\//, "").replace(/\/$/, "");

const safeInternalLinks = internalLinks.filter((link) => {
  const normTarget = link.href.replace(/^\/(bypass|send)\//, "").replace(/\/$/, "").replace(/^\//, "");
  return normTarget !== normalizedCurrent;
});

// Curated technical guide recommendations
const guideRecommendations = [
  {
    href: "/tools/transfer-speed-calculator",
    label: "Transfer Speed Calculator",
    desc: "Calculate exact upload times for 1GB to 2TB across 10M to 10G pipes.",
  },
  {
    href: "/guides/why-large-file-transfers-are-slow",
    label: "Why Transfers Are Slow",
    desc: "Network engineering deep-dive on TCP window scaling & latency.",
  },
  {
    href: "/guides/transfer-large-files-without-failed-uploads",
    label: "Prevent Failed Uploads",
    desc: "How chunked multi-part streaming avoids midway browser drops.",
  },
  {
    href: "/plans",
    label: "Plans & 25GB Free Tier",
    desc: "Free 25GB transfers with zero signup; Edge Pro 100GB & Studio 250GB.",
  },
];
---

<section class="border-t border-slate-200 bg-white py-14">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <div>
        <p class="text-xs font-semibold uppercase tracking-wider text-blue-600">Cross-Cluster Navigation</p>
        <h2 class="mt-1 text-2xl font-bold text-slate-950 sm:text-3xl">{title}</h2>
      </div>
      <a
        href="/directory"
        class="inline-flex items-center gap-1 text-sm font-semibold text-blue-600 hover:text-blue-800"
      >
        <span>Explore all 46 codecs & guides</span>
        <span>→</span>
      </a>
    </div>

    {safeInternalLinks.length > 0 && (
      <div class="mt-8">
        <h3 class="text-xs font-semibold uppercase tracking-wider text-slate-500">Complementary Transfer Channels</h3>
        <div class="mt-3 flex flex-wrap gap-3">
          {safeInternalLinks.map((link) => (
            <a
              class="rounded-lg border border-slate-300 bg-slate-50 px-4 py-2.5 text-sm font-semibold text-slate-800 shadow-sm transition hover:border-blue-500 hover:bg-white hover:text-blue-700"
              href={link.href}
            >
              {link.label}
            </a>
          ))}
        </div>
      </div>
    )}

    <div class="mt-10">
      <h3 class="text-xs font-semibold uppercase tracking-wider text-slate-500">Network Engineering & Tools</h3>
      <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {guideRecommendations.map((rec) => (
          <a
            href={rec.href}
            class="group rounded-xl border border-slate-200 bg-white p-5 shadow-sm transition hover:border-blue-500 hover:shadow-md"
          >
            <h4 class="font-bold text-slate-950 group-hover:text-blue-600 text-sm">
              {rec.label}
            </h4>
            <p class="mt-1 text-xs text-slate-500 leading-relaxed">
              {rec.desc}
            </p>
          </a>
        ))}
      </div>
    </div>
  </div>
</section>
