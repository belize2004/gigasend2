---
import { brand } from "@/lib/brand";
---

<footer class="border-t border-white/10 bg-ocean-950 py-14 text-xs text-slate-300">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
      <div>
        <a
          href="/pt"
          class="inline-flex min-h-[44px] items-center gap-2.5 text-base font-extrabold font-display text-white hover:text-gold-400 transition-colors tap-tactile"
        >
          <span aria-hidden="true" class="flex h-8 w-8 items-center justify-center rounded-lg bg-gradient-to-tr from-gold-500 to-amber-300 text-ocean-900 font-black text-sm">
            G
          </span>
          <span>{brand.productName} Brasil</span>
        </a>
        <p class="mt-3 leading-relaxed text-slate-300">
          Envie arquivos pesados com até 10 GB grátis (retenção de 3 dias), download em um clique sem cadastro para o destinatário e pacotes pré-pagos válidos por 12 meses com servidores locais de alta velocidade em São Paulo e Rio de Janeiro.
        </p>
      </div>

      <div>
        <h3 class="font-bold tracking-wider text-gold-400 text-xs">Ferramentas e guias</h3>
        <ul class="mt-3 space-y-1">
          <li><a class="inline-flex min-h-[36px] items-center hover:text-gold-400 transition-colors" href="/pt">Central Brasil</a></li>
          <li><a class="inline-flex min-h-[36px] items-center hover:text-gold-400 transition-colors" href="/pt/planos">Planos e preços</a></li>
          <li><a class="inline-flex min-h-[36px] items-center hover:text-gold-400 transition-colors" href="/pt/comparar">Comparar serviços</a></li>
          <li><a class="inline-flex min-h-[36px] items-center hover:text-gold-400 transition-colors" href="/pt/calculadora-tempo-upload">Calculadora de upload</a></li>
          <li><a class="inline-flex min-h-[36px] items-center hover:text-gold-400 transition-colors" href="/pt/guias">Guias práticos</a></li>
        </ul>
      </div>

      <div>
        <h3 class="font-bold tracking-wider text-white text-xs">Comparações e casos de uso</h3>
        <ul class="mt-3 space-y-1">
          <li><a class="inline-flex min-h-[36px] items-center hover:text-gold-400 transition-colors" href="/pt/enviar-arquivos-pesados">Enviar arquivos pesados</a></li>
          <li><a class="inline-flex min-h-[36px] items-center hover:text-gold-400 transition-colors" href="/pt/enviar-arquivo-10gb-gratis">Enviar arquivo de 10 GB grátis</a></li>
          <li><a class="inline-flex min-h-[36px] items-center hover:text-gold-400 transition-colors" href="/pt/alternativa-wetransfer">Alternativa ao WeTransfer</a></li>
          <li><a class="inline-flex min-h-[36px] items-center hover:text-gold-400 transition-colors" href="/pt/alternativa-google-drive-arquivos-grandes">Alternativa ao Google Drive</a></li>
          <li><a class="inline-flex min-h-[36px] items-center hover:text-gold-400 transition-colors" href="/pt/enviar-arquivos-para-clientes-sem-cadastro">Entrega para clientes sem cadastro</a></li>
        </ul>
      </div>

      <div>
        <h3 class="font-bold tracking-wider text-white text-xs">Segurança e legal</h3>
        <ul class="mt-3 space-y-1">
          <li><a class="inline-flex min-h-[36px] items-center hover:text-gold-400 transition-colors" href="/security">Segurança e privacidade</a></li>
          <li><a class="inline-flex min-h-[36px] items-center hover:text-gold-400 transition-colors" href="/terms">Termos de serviço</a></li>
          <li><a class="inline-flex min-h-[36px] items-center hover:text-gold-400 transition-colors" href="/privacy">Política de privacidade</a></li>
          <li><a class="inline-flex min-h-[36px] items-center hover:text-gold-400 transition-colors" href="/directory">Diretório completo</a></li>
        </ul>
      </div>
    </div>

    <div class="pt-footer-bottom mt-8 flex flex-wrap items-center justify-between gap-4 border-t border-white/10 pt-6">
      <p>© {new Date().getFullYear()} {brand.productName}. Todos os direitos reservados.</p>
      <div class="flex flex-wrap items-center gap-4">
        <a
          class="inline-flex min-h-[40px] items-center hover:text-gold-400 transition-colors"
          href="/"
          onclick="document.cookie='gigasend_lang=en; path=/; max-age=31536000; SameSite=Lax'"
        >
          🇺🇸 English
        </a>
        <a
          class="inline-flex min-h-[40px] items-center hover:text-gold-400 transition-colors"
          href="/es"
          onclick="document.cookie='gigasend_lang=es; path=/; max-age=31536000; SameSite=Lax'"
        >
          🇪🇸 Español
        </a>
        <a
          class="inline-flex min-h-[40px] items-center text-gold-400 font-bold"
          href="/pt"
          onclick="document.cookie='gigasend_lang=pt; path=/; max-age=31536000; SameSite=Lax'"
        >
          🇧🇷 Português (Brasil)
        </a>
      </div>
    </div>
  </div>
</footer>
