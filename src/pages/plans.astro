---
import BaseLayout from "../layouts/BaseLayout.astro";
import PlansApp from "@/src/components/PlansApp";
import { brand } from "@/lib/brand";

const canonical = `${brand.siteUrl}/plans`;
const hreflang = [
  { lang: "en", href: canonical },
  { lang: "pt-BR", href: `${brand.siteUrl}/pt/planos` },
  { lang: "x-default", href: canonical },
];
---

<BaseLayout title="Plans | GigaSend" canonical={canonical} hreflang={hreflang}>
  <PlansApp client:load />
</BaseLayout>
