---
export const prerender = true;
import BaseLayout from "../layouts/BaseLayout.astro";
import { brand } from "@/lib/brand";

const canonical = `${brand.siteUrl}/compare`;
const hreflang = [
  { lang: "en", href: canonical },
  { lang: "es", href: `${brand.siteUrl}/es/alternativas-a-wetransfer` },
  { lang: "pt-BR", href: `${brand.siteUrl}/pt/comparar` },
  { lang: "x-default", href: canonical },
];
---

<BaseLayout
  title={`Compare File Transfer Services — Send Large Files for Less | ${brand.productName}`}
  description="See how Gigasend compares with WeTransfer, Dropbox, Google Drive, and Frame.io on speed, storage, and price. Start with 10 GB free and transfer up to 5 TB."
  canonical={canonical}
  hreflang={hreflang}
>
  <main class="min-h-screen bg-ocean-950 text-slate-100 font-body">
    <header class="sticky top-0 z-50 border-b border-white/10 bg-ocean-950/85 backdrop-blur-2xl">
      <nav class="mx-auto flex max-w-7xl items-center justify-between px-4 py-4 sm:px-6 lg:px-8" aria-label="Primary">
        <a href="/" class="flex items-center gap-3 text-xl font-extrabold font-display tracking-tight text-white group tap-tactile">
          <span class="flex h-8 w-8 items-center justify-center rounded-xl bg-gradient-to-tr from-gold-500 to-amber-300 text-ocean-900 font-black font-display text-base shadow-lg shadow-gold-500/20 group-hover:scale-105 transition-transform">G</span>
          <span class="group-hover:text-gold-400 transition-colors">{brand.productName}</span>
        </a>
        <div class="flex items-center gap-4 sm:gap-6 text-xs font-medium text-slate-300">
          <a class="hidden md:inline hover:text-gold-400 transition-colors" href="/transfer">Transfer</a>
          <a class="hidden md:inline hover:text-gold-400 transition-colors" href="/plans">Plans</a>
          <a class="hidden sm:inline text-gold-400 font-bold" href="/compare">Compare</a>
          <a class="hidden lg:inline hover:text-gold-400 transition-colors" href="/directory">Directory</a>
          <a class="hidden lg:inline hover:text-gold-400 transition-colors" href="/guides">Guides</a>
          <a class="hidden xl:inline hover:text-gold-400 transition-colors" href="/tools/transfer-speed-calculator">Speed Calculator</a>
          <a class="hidden lg:inline hover:text-gold-400 transition-colors" href="/contact">Contact</a>
          <div class="inline-flex items-center rounded-xl border border-white/15 bg-ocean-900/90 p-1 text-xs font-mono" role="group" aria-label="Language switcher">
            <a href="/compare?lang=en" onclick="document.cookie='gigasend_lang=en; path=/; max-age=31536000; SameSite=Lax'" class="inline-flex min-h-[36px] min-w-[36px] items-center justify-center rounded-lg px-2.5 py-1.5 font-bold bg-gold-500/15 text-gold-400" aria-current="true">EN</a>
            <span class="mx-0.5 text-slate-600" aria-hidden="true">|</span>
            <a href="/es/alternativas-a-wetransfer?lang=es" onclick="document.cookie='gigasend_lang=es; path=/; max-age=31536000; SameSite=Lax'" class="inline-flex min-h-[36px] min-w-[36px] items-center justify-center rounded-lg px-2.5 py-1.5 text-slate-300 hover:text-white transition-colors">ES</a>
            <span class="mx-0.5 text-slate-600" aria-hidden="true">|</span>
            <a href="/pt/comparar?lang=pt" onclick="document.cookie='gigasend_lang=pt; path=/; max-age=31536000; SameSite=Lax'" class="inline-flex min-h-[36px] min-w-[36px] items-center justify-center rounded-lg px-2.5 py-1.5 text-slate-300 hover:text-white transition-colors">PT</a>
          </div>
          <a class="btn-gold px-3.5 py-2 rounded-xl text-xs font-bold shadow-md shadow-gold-500/10 tap-tactile" href="/transfer">Send Files</a>
        </div>
      </nav>
    </header>

    <!-- Breadcrumb Navigation -->
    <nav aria-label="Breadcrumb" class="border-b border-white/10 bg-ocean-950/90 px-4 py-3 sm:px-6 lg:px-8">
      <ol class="mx-auto flex max-w-7xl items-center gap-2 text-xs font-mono text-slate-400">
        <li><a href="/" class="hover:text-gold-400 transition-colors">Home</a></li>
        <li aria-hidden="true">/</li>
        <li class="text-gold-400 font-semibold" aria-current="page">Compare</li>
      </ol>
    </nav>

    <!-- Section 1: Clean Hero -->
    <section class="pt-20 pb-20 px-6 bg-gradient-to-b from-ocean-950 via-ocean-900 to-ocean-950 text-center border-b border-white/10">
      <div class="max-w-4xl mx-auto space-y-6">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-gold-500/10 border border-gold-500/30 text-gold-400 label-caps text-xs">
          Compare File Transfer Services
        </div>
        <h1 class="text-4xl sm:text-6xl font-black text-white font-display tracking-tight leading-[1.1]">
          Send Large Files for Less
        </h1>
        <p class="text-lg sm:text-xl text-slate-300 max-w-2xl mx-auto font-body leading-relaxed">
          See how {brand.productName} compares with WeTransfer, Dropbox, Google Drive, and Frame.io on speed, storage, and price.
        </p>

        <div class="pt-4 flex flex-wrap items-center justify-center gap-4">
          <a href="/transfer" class="btn-gold px-8 py-4 rounded-xl text-xs shadow-xl shadow-gold-500/20 font-bold tap-tactile">
            Send Files Free
          </a>
          <a href="/plans" class="btn-outline-gold px-8 py-4 rounded-xl text-xs font-bold tap-tactile">
            View Pricing
          </a>
        </div>
      </div>
    </section>

    <!-- Section 2: 5-Row Comparison Table -->
    <section id="compare" class="py-20 px-6 bg-ocean-950">
      <div class="max-w-6xl mx-auto space-y-10">
        <div class="text-center space-y-3">
          <span class="label-caps text-gold-400 text-xs">Provider Comparison</span>
          <h2 class="text-3xl sm:text-4xl font-black text-white font-display tracking-tight">
            Side-by-Side Comparison
          </h2>
          <p class="text-sm text-slate-300 max-w-xl mx-auto font-body">
            Compare free allowances, entry pricing, transfer limits, and recipient experience across leading services.
          </p>
        </div>

        <div class="rounded-3xl border border-white/10 bg-ocean-900/80 overflow-hidden shadow-2xl apple-glass backdrop-blur-2xl">
          <div class="overflow-x-auto">
            <table class="w-full text-left text-sm text-slate-300 font-body">
              <thead class="bg-ocean-950/90 text-slate-400 border-b border-white/10">
                <tr>
                  <th class="px-6 py-5 label-caps text-xs text-white">Feature</th>
                  <th class="px-6 py-5 label-caps text-xs text-gold-400 bg-ocean-900/90 border-x border-gold-500/30">{brand.productName}</th>
                  <th class="px-6 py-5 label-caps text-xs text-slate-300">WeTransfer</th>
                  <th class="px-6 py-5 label-caps text-xs text-slate-300">Dropbox</th>
                  <th class="px-6 py-5 label-caps text-xs text-slate-300">Google Drive</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-white/10">
                <tr class="hover:bg-ocean-800/30 transition">
                  <td class="px-6 py-4 font-semibold text-white font-display">Free Allowance</td>
                  <td class="px-6 py-4 text-gold-400 font-bold bg-ocean-900/50 border-x border-gold-500/30">
                    10 GB free <span class="text-xs text-emerald-400 font-normal block">(3-day retention)</span>
                  </td>
                  <td class="px-6 py-4 text-slate-300">2 GB–3 GB cap</td>
                  <td class="px-6 py-4 text-slate-300">2 GB Basic storage</td>
                  <td class="px-6 py-4 text-slate-300">15 GB shared with Gmail</td>
                </tr>

                <tr class="hover:bg-ocean-800/30 transition">
                  <td class="px-6 py-4 font-semibold text-white font-display">Entry Price</td>
                  <td class="px-6 py-4 text-gold-400 font-bold bg-ocean-900/50 border-x border-gold-500/30">
                    $10/mo (30 GB) or $10 for 50 GB pack
                  </td>
                  <td class="px-6 py-4 text-slate-300">$15–$25/mo subscription</td>
                  <td class="px-6 py-4 text-slate-300">$12–$20/mo subscription</td>
                  <td class="px-6 py-4 text-slate-300">$2–$10/mo storage plan</td>
                </tr>

                <tr class="hover:bg-ocean-800/30 transition">
                  <td class="px-6 py-4 font-semibold text-white font-display">Max Transfer Size</td>
                  <td class="px-6 py-4 text-white font-semibold bg-ocean-900/50 border-x border-gold-500/30">
                    Up to 5 TB
                  </td>
                  <td class="px-6 py-4 text-slate-300">200 GB–unlimited (paid)</td>
                  <td class="px-6 py-4 text-slate-300">100 GB–250 GB with add-on</td>
                  <td class="px-6 py-4 text-slate-300">Up to plan storage limit</td>
                </tr>

                <tr class="hover:bg-ocean-800/30 transition">
                  <td class="px-6 py-4 font-semibold text-white font-display">Recipient Experience</td>
                  <td class="px-6 py-4 text-white font-semibold bg-ocean-900/50 border-x border-gold-500/30">
                    Direct browser download, no account required
                  </td>
                  <td class="px-6 py-4 text-slate-300">Ad-heavy landing page on free tier</td>
                  <td class="px-6 py-4 text-slate-300">Account sign-in prompts & daily bandwidth caps</td>
                  <td class="px-6 py-4 text-slate-300">24-hour "Download quota exceeded" lockouts</td>
                </tr>

                <tr class="hover:bg-ocean-800/30 transition">
                  <td class="px-6 py-4 font-semibold text-white font-display">Pricing Model</td>
                  <td class="px-6 py-4 text-gold-400 font-bold bg-ocean-900/50 border-x border-gold-500/30">
                    Monthly plans (30-day retention) or 12-month credit packs ($0.16–$0.20/GB)
                  </td>
                  <td class="px-6 py-4 text-slate-300">Recurring monthly or annual subscription</td>
                  <td class="px-6 py-4 text-slate-300">Recurring per-user subscription</td>
                  <td class="px-6 py-4 text-slate-300">Recurring cloud storage subscription</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </section>

    <!-- Section 3: 3 Switch Cards + Bottom CTA -->
    <section class="py-20 px-6 bg-ocean-900/60 border-t border-white/10">
      <div class="max-w-6xl mx-auto space-y-12">
        <div class="text-center max-w-2xl mx-auto space-y-2">
          <span class="label-caps text-gold-400 text-xs">Switch in Seconds</span>
          <h2 class="text-3xl sm:text-4xl font-black text-white font-display">
            Compare by Provider
          </h2>
          <p class="text-sm text-slate-300">
            See how {brand.productName} solves the most common limits of legacy file sharing tools.
          </p>
        </div>

        <div class="grid gap-6 md:grid-cols-3">
          <a href="/wetransfer-alternative" class="group apple-glass flex flex-col justify-between rounded-2xl border border-white/10 bg-ocean-900/80 p-6 shadow-xl transition hover:border-gold-500/50 hover:bg-ocean-900 tap-tactile">
            <div>
              <span class="inline-block rounded-md bg-gold-500/10 border border-gold-500/30 px-2.5 py-0.5 text-[10px] font-semibold uppercase tracking-wider text-gold-400 font-mono">WeTransfer</span>
              <h3 class="mt-3 text-lg font-bold text-white group-hover:text-gold-400 font-display transition-colors">Switching from WeTransfer</h3>
              <p class="mt-2 text-sm text-slate-300 leading-relaxed">Send 5× larger free transfers (10 GB vs. 2 GB) without mandatory recurring Pro subscriptions.</p>
            </div>
            <div class="mt-6 pt-3 border-t border-white/10 flex items-center justify-between text-xs font-mono font-semibold text-gold-400">
              <span>Compare WeTransfer</span>
              <span class="transition-transform group-hover:translate-x-1" aria-hidden="true">→</span>
            </div>
          </a>

          <a href="/dropbox-transfer-alternative" class="group apple-glass flex flex-col justify-between rounded-2xl border border-white/10 bg-ocean-900/80 p-6 shadow-xl transition hover:border-gold-500/50 hover:bg-ocean-900 tap-tactile">
            <div>
              <span class="inline-block rounded-md bg-gold-500/10 border border-gold-500/30 px-2.5 py-0.5 text-[10px] font-semibold uppercase tracking-wider text-gold-400 font-mono">Dropbox</span>
              <h3 class="mt-3 text-lg font-bold text-white group-hover:text-gold-400 font-display transition-colors">Switching from Dropbox</h3>
              <p class="mt-2 text-sm text-slate-300 leading-relaxed">Deliver large client packages without filling up your personal cloud storage or forcing recipients to sign in.</p>
            </div>
            <div class="mt-6 pt-3 border-t border-white/10 flex items-center justify-between text-xs font-mono font-semibold text-gold-400">
              <span>Compare Dropbox</span>
              <span class="transition-transform group-hover:translate-x-1" aria-hidden="true">→</span>
            </div>
          </a>

          <a href="/google-drive-download-quota-exceeded-fix" class="group apple-glass flex flex-col justify-between rounded-2xl border border-white/10 bg-ocean-900/80 p-6 shadow-xl transition hover:border-gold-500/50 hover:bg-ocean-900 tap-tactile">
            <div>
              <span class="inline-block rounded-md bg-gold-500/10 border border-gold-500/30 px-2.5 py-0.5 text-[10px] font-semibold uppercase tracking-wider text-gold-400 font-mono">Google Drive</span>
              <h3 class="mt-3 text-lg font-bold text-white group-hover:text-gold-400 font-display transition-colors">Switching from Google Drive</h3>
              <p class="mt-2 text-sm text-slate-300 leading-relaxed">Avoid 24-hour download quota lockouts and virus-scan warnings when sharing multi-gigabyte archives.</p>
            </div>
            <div class="mt-6 pt-3 border-t border-white/10 flex items-center justify-between text-xs font-mono font-semibold text-gold-400">
              <span>Compare Google Drive</span>
              <span class="transition-transform group-hover:translate-x-1" aria-hidden="true">→</span>
            </div>
          </a>
        </div>

        <!-- Clean Final CTA Box -->
        <div class="apple-glass rounded-3xl border border-gold-500/30 bg-ocean-900/90 p-10 text-center shadow-2xl space-y-5">
          <span class="label-caps text-gold-400 text-xs">10 GB Free • 3-Day Retention</span>
          <h2 class="text-3xl sm:text-4xl font-black text-white font-display">
            Ready to Send Your First Transfer?
          </h2>
          <p class="text-slate-300 text-sm sm:text-base max-w-xl mx-auto font-body">
            Start with 10 GB free right in your browser, or scale up to 5 TB with flexible monthly plans and pay-as-you-go credit packs.
          </p>
          <div class="pt-2 flex flex-wrap justify-center gap-4">
            <a href="/transfer" class="btn-gold px-8 py-4 rounded-xl text-xs font-bold shadow-xl shadow-gold-500/20 inline-flex tap-tactile">
              Send Files Free →
            </a>
            <a href="/plans" class="btn-outline-gold px-8 py-4 rounded-xl text-xs font-bold inline-flex tap-tactile">
              View Plans & Pricing
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Apple HIG Dark Blue SEO Footer -->
    <footer class="border-t border-white/10 bg-ocean-950 py-14 text-xs text-slate-400">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
          <div>
            <a href="/" class="flex items-center gap-2.5 text-base font-extrabold font-display text-white">
              <span class="flex h-7 w-7 items-center justify-center rounded-lg bg-gradient-to-tr from-gold-500 to-amber-300 text-ocean-900 font-black text-sm">G</span>
              <span>{brand.productName}</span>
            </a>
            <p class="mt-3 text-slate-400 leading-relaxed">
              Fast, reliable large file transfer across 335+ global server locations. Send up to 10 GB free.
            </p>
          </div>
          <div>
            <h3 class="font-bold text-white uppercase tracking-wider font-mono text-[11px]">Platform & Tools</h3>
            <ul class="mt-3 space-y-2">
              <li><a href="/transfer" class="hover:text-gold-400 transition-colors">Send Large Files</a></li>
              <li><a href="/plans" class="hover:text-gold-400 transition-colors">Plans & Pricing</a></li>
              <li><a href="/compare" class="hover:text-gold-400 transition-colors">Provider Comparison</a></li>
              <li><a href="/tools/transfer-speed-calculator" class="hover:text-gold-400 transition-colors">Transfer Speed Calculator</a></li>
              <li><a href="/directory" class="hover:text-gold-400 transition-colors">Workflow & Codec Directory</a></li>
            </ul>
          </div>
          <div>
            <h3 class="font-bold text-white uppercase tracking-wider font-mono text-[11px]">Guides</h3>
            <ul class="mt-3 space-y-2">
              <li><a href="/guides" class="hover:text-gold-400 transition-colors">All Guides</a></li>
              <li><a href="/guides/why-large-file-transfers-are-slow" class="hover:text-gold-400 transition-colors">Why Transfers Are Slow</a></li>
              <li><a href="/guides/large-file-transfer-cost-calculator" class="hover:text-gold-400 transition-colors">Transfer Cost Calculator</a></li>
              <li><a href="/guides/transfer-large-files-without-failed-uploads" class="hover:text-gold-400 transition-colors">Prevent Failed Uploads</a></li>
              <li><a href="/guides/file-transfer-vs-cloud-storage-vs-media-review" class="hover:text-gold-400 transition-colors">Transfer vs. Cloud vs. Review</a></li>
              <li><a href="/guides/send-large-files-without-filling-computer" class="hover:text-gold-400 transition-colors">Send Without Filling Disk Space</a></li>
            </ul>
          </div>
          <div>
            <h3 class="font-bold text-white uppercase tracking-wider font-mono text-[11px]">Popular Workflows & Support</h3>
            <ul class="mt-3 space-y-2">
              <li><a href="/send-large-files-free" class="hover:text-gold-400 transition-colors">Send Large Files Free (10 GB)</a></li>
              <li><a href="/wetransfer-alternative" class="hover:text-gold-400 transition-colors">WeTransfer Alternative</a></li>
              <li><a href="/send-large-video-files" class="hover:text-gold-400 transition-colors">Send Large Video Files</a></li>
              <li><a href="/blogs" class="hover:text-gold-400 transition-colors">Blog</a></li>
              <li><a href="/contact" class="hover:text-gold-400 transition-colors">Contact Support</a></li>
              <li><a href="/terms" class="hover:text-gold-400 transition-colors">Terms</a> · <a href="/privacy-policy" class="hover:text-gold-400 transition-colors">Privacy</a></li>
            </ul>
          </div>
        </div>
        <div class="mt-10 border-t border-white/10 pt-6 flex flex-col sm:flex-row items-center justify-between gap-4">
          <p>© {new Date().getFullYear()} {brand.productName}. All rights reserved.</p>
          <div class="flex gap-4">
            <a href="/security" class="hover:text-gold-400 transition-colors">Security</a>
            <a href="/privacy-policy" class="hover:text-gold-400 transition-colors">Privacy Policy</a>
            <a href="/terms" class="hover:text-gold-400 transition-colors">Terms of Service</a>
            <a href="/contact" class="hover:text-gold-400 transition-colors">Contact</a>
          </div>
        </div>
      </div>
    </footer>
  </main>
</BaseLayout>

