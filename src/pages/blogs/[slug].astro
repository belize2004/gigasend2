---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AppLayout from "@/components/AppLayout";
import { blogPosts, getBlogPost } from "@/src/data/blogPosts";
import { brand } from "@/lib/brand";

const { slug } = Astro.params;
const post = getBlogPost(slug);
const morePosts = blogPosts.filter((related) => related.slug !== slug).slice(0, 3);
const canonical = post ? `${brand.siteUrl}/blogs/${post.slug}` : undefined;
---

<BaseLayout title={post ? `${post.title} | ${brand.productName}` : `Article Unavailable | ${brand.productName}`} description={post?.excerpt} canonical={canonical}>
  <AppLayout client:load>
    <div class="min-h-screen bg-ocean-950 text-slate-100 font-body">
      <!-- Breadcrumb Navigation -->
      <nav aria-label="Breadcrumb" class="border-b border-white/10 bg-ocean-950/90 px-4 py-3 sm:px-6 lg:px-8">
        <ol class="mx-auto flex max-w-4xl items-center gap-2 text-xs font-mono text-slate-400">
          <li><a href="/" class="hover:text-gold-400 transition-colors">Home</a></li>
          <li aria-hidden="true">/</li>
          <li><a href="/blogs" class="hover:text-gold-400 transition-colors">Blog</a></li>
          {post && (
            <>
              <li aria-hidden="true">/</li>
              <li class="text-gold-400 font-semibold truncate max-w-xs" aria-current="page">{post.title}</li>
            </>
          )}
        </ol>
      </nav>

      <div class="py-16 px-6">
        {!post ? (
          <div class="max-w-3xl mx-auto apple-glass rounded-2xl border border-white/10 bg-ocean-900/80 p-8 text-center">
            <p class="text-slate-300 text-lg">This article isn’t available. It may have been moved or removed.</p>
            <a href="/blogs" class="btn-gold mt-6 inline-flex rounded-xl px-6 py-3 text-xs font-bold tap-tactile">
              Browse All Articles
            </a>
          </div>
        ) : (
          <article class="max-w-3xl mx-auto apple-glass rounded-3xl border border-white/10 bg-ocean-900/80 p-8 sm:p-12 shadow-2xl">
            <div class="mb-6">
              <a href="/blogs" class="text-xs font-mono text-gold-400 hover:text-gold-300 transition-colors">
                ← Back to Blog
              </a>
            </div>
            <h1 class="text-3xl sm:text-4xl font-black text-white font-display tracking-tight leading-tight">{post.title}</h1>
            <p class="text-xs font-mono text-gold-400 mt-3 mb-8 pb-6 border-b border-white/10">
              {post.author} · {new Date(post.publishedAt).toLocaleDateString()}
            </p>
            <div class="space-y-5 text-slate-200 leading-8 text-base">
              {post.body.map((paragraph) => <p>{paragraph}</p>)}
            </div>
          </article>
        )}

        <section class="max-w-4xl mx-auto mt-16 border-t border-white/10 pt-12">
          <div class="flex items-center justify-between mb-6">
            <h2 class="text-2xl font-black text-white font-display">More Articles</h2>
            <a href="/blogs" class="text-xs font-mono text-gold-400 hover:text-gold-300">View All →</a>
          </div>
          {morePosts.length === 0 ? (
            <p class="text-slate-400 text-base">
              No additional articles have been published yet. In the meantime, explore our <a href="/guides" class="text-gold-400 hover:text-gold-300 underline">Engineering Guides</a>.
            </p>
          ) : (
            <ul class="grid grid-cols-1 md:grid-cols-3 gap-6">
              {morePosts.map((related) => (
                <li>
                  <a
                    href={`/blogs/${related.slug}`}
                    class="group h-full flex flex-col justify-between apple-glass rounded-2xl border border-white/10 bg-ocean-900/80 p-6 shadow-lg transition hover:border-gold-500/50 hover:bg-ocean-900 tap-tactile"
                  >
                    <div class="space-y-2">
                      <p class="text-xs font-mono text-gold-400">
                        By {related.author} · {new Date(related.publishedAt).toLocaleDateString()}
                      </p>
                      <h3 class="text-lg font-bold text-white group-hover:text-gold-400 font-display transition-colors">
                        {related.title}
                      </h3>
                      <p class="mt-2 text-xs text-slate-300 leading-relaxed">{related.excerpt}</p>
                    </div>
                    <span class="mt-4 pt-3 border-t border-white/10 text-xs font-mono text-gold-400 flex items-center justify-between">
                      <span>Read Article</span>
                      <span class="group-hover:translate-x-1 transition-transform">→</span>
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          )}
        </section>
      </div>

      <!-- Related Engineering Guides & Transfer Solutions -->
      <section class="border-t border-white/10 bg-ocean-900/60 py-16 px-6">
        <div class="max-w-4xl mx-auto space-y-8">
          <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 border-b border-white/10 pb-6">
            <div>
              <span class="label-caps text-gold-400 text-xs">Technical Ecosystem</span>
              <h2 class="mt-1 text-2xl sm:text-3xl font-black text-white font-display">
                Related Engineering Guides & Transfer Solutions
              </h2>
              <p class="mt-2 text-sm text-slate-300">
                Explore interactive telemetry calculators, WAN protocol diagnostics, and codec-specific transfer channels.
              </p>
            </div>
            <a href="/guides" class="text-xs font-mono font-bold text-gold-400 hover:text-gold-300 transition-colors">
              All Engineering Guides →
            </a>
          </div>

          <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            <a href="/guides/why-large-file-transfers-are-slow" class="group apple-glass rounded-2xl border border-white/10 bg-ocean-900/80 p-5 shadow-lg transition hover:border-gold-500/50 hover:bg-ocean-900 tap-tactile">
              <span class="text-[10px] font-mono uppercase tracking-wider text-gold-400">WAN & Latency</span>
              <h3 class="mt-2 font-bold text-white group-hover:text-gold-400 font-display text-sm transition-colors">Why Large File Transfers Are So Slow</h3>
              <p class="mt-1.5 text-xs text-slate-300">Diagnosing TCP window scaling, peering latency, and packet loss bottlenecks.</p>
            </a>
            <a href="/guides/large-file-transfer-cost-calculator" class="group apple-glass rounded-2xl border border-white/10 bg-ocean-900/80 p-5 shadow-lg transition hover:border-gold-500/50 hover:bg-ocean-900 tap-tactile">
              <span class="text-[10px] font-mono uppercase tracking-wider text-gold-400">Cost & Billing</span>
              <h3 class="mt-2 font-bold text-white group-hover:text-gold-400 font-display text-sm transition-colors">Large File Transfer Cost Calculator</h3>
              <p class="mt-1.5 text-xs text-slate-300">Pay-as-you-go rates vs. recurring subscriptions and cloud egress fees.</p>
            </a>
            <a href="/guides/transfer-large-files-without-failed-uploads" class="group apple-glass rounded-2xl border border-white/10 bg-ocean-900/80 p-5 shadow-lg transition hover:border-gold-500/50 hover:bg-ocean-900 tap-tactile">
              <span class="text-[10px] font-mono uppercase tracking-wider text-gold-400">Reliability</span>
              <h3 class="mt-2 font-bold text-white group-hover:text-gold-400 font-display text-sm transition-colors">Transfer Large Files Without Failed Uploads</h3>
              <p class="mt-1.5 text-xs text-slate-300">Client-side chunking, multi-part parallel streams, and auto-retry.</p>
            </a>
            <a href="/guides/file-transfer-vs-cloud-storage-vs-media-review" class="group apple-glass rounded-2xl border border-white/10 bg-ocean-900/80 p-5 shadow-lg transition hover:border-gold-500/50 hover:bg-ocean-900 tap-tactile">
              <span class="text-[10px] font-mono uppercase tracking-wider text-gold-400">Workflow Architecture</span>
              <h3 class="mt-2 font-bold text-white group-hover:text-gold-400 font-display text-sm transition-colors">File Transfer vs. Cloud Storage vs. Review</h3>
              <p class="mt-1.5 text-xs text-slate-300">When to use ephemeral transfer vs. cloud sync vs. video review.</p>
            </a>
            <a href="/guides/send-large-files-without-filling-computer" class="group apple-glass rounded-2xl border border-white/10 bg-ocean-900/80 p-5 shadow-lg transition hover:border-gold-500/50 hover:bg-ocean-900 tap-tactile">
              <span class="text-[10px] font-mono uppercase tracking-wider text-gold-400">Storage Optimization</span>
              <h3 class="mt-2 font-bold text-white group-hover:text-gold-400 font-display text-sm transition-colors">Send Large Files Without Filling Hard Drive</h3>
              <p class="mt-1.5 text-xs text-slate-300">Protect local SSD disk space with zero-cache browser streaming.</p>
            </a>
            <a href="/tools/transfer-speed-calculator" class="group apple-glass rounded-2xl border border-white/10 bg-ocean-900/80 p-5 shadow-lg transition hover:border-gold-500/50 hover:bg-ocean-900 tap-tactile">
              <span class="text-[10px] font-mono uppercase tracking-wider text-gold-400">Interactive Tool</span>
              <h3 class="mt-2 font-bold text-white group-hover:text-gold-400 font-display text-sm transition-colors">Transfer Speed Calculator</h3>
              <p class="mt-1.5 text-xs text-slate-300">Calculate exact upload durations for 1 GB to 2 TB across 10 Mbps to 10 Gbps uplinks.</p>
            </a>
          </div>

          <div class="pt-4 flex flex-wrap gap-3">
            <a href="/guides" class="apple-subtle-glass rounded-xl border border-white/10 bg-ocean-900/70 px-4 py-2 text-xs font-semibold text-slate-200 hover:border-gold-500/50 hover:text-gold-400 transition tap-tactile">
              All Engineering Guides
            </a>
            <a href="/directory" class="apple-subtle-glass rounded-xl border border-white/10 bg-ocean-900/70 px-4 py-2 text-xs font-semibold text-slate-200 hover:border-gold-500/50 hover:text-gold-400 transition tap-tactile">
              Codec & Format Directory
            </a>
            <a href="/compare" class="apple-subtle-glass rounded-xl border border-white/10 bg-ocean-900/70 px-4 py-2 text-xs font-semibold text-slate-200 hover:border-gold-500/50 hover:text-gold-400 transition tap-tactile">
              Cloudflare Edge vs. AWS Relays
            </a>
            <a href="/send-large-files-free" class="apple-subtle-glass rounded-xl border border-white/10 bg-ocean-900/70 px-4 py-2 text-xs font-semibold text-slate-200 hover:border-gold-500/50 hover:text-gold-400 transition tap-tactile">
              Send Large Files Free (10 GB)
            </a>
          </div>
        </div>
      </section>

      <!-- Apple HIG Dark Blue SEO Footer -->
      <footer class="border-t border-white/10 bg-ocean-950 py-14 px-6 text-xs text-slate-400">
        <div class="mx-auto max-w-4xl">
          <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
            <div>
              <a href="/" class="flex items-center gap-2.5 text-base font-extrabold font-display text-white">
                <span class="flex h-7 w-7 items-center justify-center rounded-lg bg-gradient-to-tr from-gold-500 to-amber-300 text-ocean-900 font-black text-sm">G</span>
                <span>{brand.productName}</span>
              </a>
              <p class="mt-3 text-slate-400 leading-relaxed">
                Zero-egress large file transfer powered by Cloudflare's 335+ Anycast edge network. Send up to 10 GB free.
              </p>
            </div>
            <div>
              <h3 class="font-bold text-white uppercase tracking-wider font-mono text-[11px]">Platform & Tools</h3>
              <ul class="mt-3 space-y-2">
                <li><a href="/transfer" class="hover:text-gold-400 transition-colors">Send Large Files</a></li>
                <li><a href="/plans" class="hover:text-gold-400 transition-colors">Plans & Pricing</a></li>
                <li><a href="/compare" class="hover:text-gold-400 transition-colors">Architecture Comparison</a></li>
                <li><a href="/tools/transfer-speed-calculator" class="hover:text-gold-400 transition-colors">Transfer Speed Calculator</a></li>
                <li><a href="/directory" class="hover:text-gold-400 transition-colors">Codec & Format Directory</a></li>
              </ul>
            </div>
            <div>
              <h3 class="font-bold text-white uppercase tracking-wider font-mono text-[11px]">Engineering Guides</h3>
              <ul class="mt-3 space-y-2">
                <li><a href="/guides" class="hover:text-gold-400 transition-colors">All Engineering Guides</a></li>
                <li><a href="/guides/why-large-file-transfers-are-slow" class="hover:text-gold-400 transition-colors">Why Transfers Are Slow</a></li>
                <li><a href="/guides/large-file-transfer-cost-calculator" class="hover:text-gold-400 transition-colors">Transfer Cost Calculator</a></li>
                <li><a href="/guides/transfer-large-files-without-failed-uploads" class="hover:text-gold-400 transition-colors">Prevent Failed Uploads</a></li>
                <li><a href="/guides/file-transfer-vs-cloud-storage-vs-media-review" class="hover:text-gold-400 transition-colors">Transfer vs. Cloud vs. Review</a></li>
                <li><a href="/guides/send-large-files-without-filling-computer" class="hover:text-gold-400 transition-colors">Zero-Cache Browser Streaming</a></li>
              </ul>
            </div>
            <div>
              <h3 class="font-bold text-white uppercase tracking-wider font-mono text-[11px]">Popular Workflows & Support</h3>
              <ul class="mt-3 space-y-2">
                <li><a href="/send-large-files-free" class="hover:text-gold-400 transition-colors">Send Large Files Free (10 GB)</a></li>
                <li><a href="/wetransfer-alternative" class="hover:text-gold-400 transition-colors">WeTransfer Alternative</a></li>
                <li><a href="/send-large-video-files" class="hover:text-gold-400 transition-colors">Send Large Video Files</a></li>
                <li><a href="/blogs" class="hover:text-gold-400 transition-colors">Engineering Blog</a></li>
                <li><a href="/contact" class="hover:text-gold-400 transition-colors">Contact Support</a></li>
              </ul>
            </div>
          </div>
        </div>
      </footer>
    </div>
  </AppLayout>
</BaseLayout>
