---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AppLayout from "@/components/AppLayout";
import { blogPosts } from "@/src/data/blogPosts";
import { brand } from "@/lib/brand";
---

<BaseLayout title={`Blog | ${brand.productName}`} canonical={`${brand.siteUrl}/blogs`}>
  <AppLayout client:load>
    <main class="min-h-screen bg-ocean-950 text-slate-100 font-body">
      <!-- Breadcrumb Navigation -->
      <nav aria-label="Breadcrumb" class="border-b border-white/10 bg-ocean-950/90 px-4 py-3 sm:px-6 lg:px-8">
        <ol class="mx-auto flex max-w-5xl items-center gap-2 text-xs font-mono text-slate-400">
          <li><a href="/" class="hover:text-gold-400 transition-colors">Home</a></li>
          <li aria-hidden="true">/</li>
          <li class="text-gold-400 font-semibold" aria-current="page">Blog</li>
        </ol>
      </nav>

      <div class="max-w-5xl mx-auto py-16 px-6 space-y-10">
        <div class="space-y-3 border-b border-white/10 pb-8">
          <span class="inline-flex items-center gap-2 rounded-full bg-gold-500/10 border border-gold-500/30 px-3.5 py-1 text-xs font-semibold uppercase tracking-wider text-gold-400 label-caps">
            Engineering & Workflow Dispatches
          </span>
          <h1 class="text-4xl sm:text-5xl font-black text-white font-display tracking-tight">Blog</h1>
          <p class="text-slate-300 text-base max-w-2xl">
            Practical guides on creative production workflows, large file sharing, and high-speed media delivery.
          </p>
        </div>

        {blogPosts.length === 0 ? (
          <div class="apple-glass rounded-2xl border border-white/10 bg-ocean-900/80 p-8 text-center">
            <p class="text-slate-300 text-lg">
              No articles are available yet. Check back soon for engineering deep dives and workflow guides.
            </p>
          </div>
        ) : (
          <ul class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {blogPosts.map((post) => (
              <li>
                <a
                  href={`/blogs/${post.slug}`}
                  class="group h-full flex flex-col justify-between apple-glass rounded-2xl border border-white/10 bg-ocean-900/80 p-6 shadow-xl transition hover:border-gold-500/50 hover:bg-ocean-900 tap-tactile"
                >
                  <div class="space-y-3">
                    <p class="text-xs font-mono text-gold-400">
                      By {post.author} · {new Date(post.publishedAt).toLocaleDateString()}
                    </p>
                    <h2 class="text-xl font-bold text-white group-hover:text-gold-400 font-display transition-colors leading-snug">
                      {post.title}
                    </h2>
                    <p class="text-sm text-slate-300 leading-relaxed">{post.excerpt}</p>
                  </div>
                  <div class="mt-6 pt-3 border-t border-white/10 flex items-center justify-between text-xs font-mono font-bold text-gold-400">
                    <span>Read Article</span>
                    <span class="group-hover:translate-x-1 transition-transform" aria-hidden="true">→</span>
                  </div>
                </a>
              </li>
            ))}
          </ul>
        )}
      </div>

      <!-- Curated Guides -->
      <section class="border-t border-white/10 bg-ocean-900/60 py-14 px-6">
        <div class="max-w-5xl mx-auto space-y-6">
          <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4">
            <div>
              <span class="label-caps text-gold-400 text-xs">Resources</span>
              <h2 class="mt-1 text-2xl font-black text-white font-display">
                Popular Transfer Guides
              </h2>
            </div>
            <a href="/guides" class="text-xs font-mono font-bold text-gold-400 hover:text-gold-300 transition-colors">
              All Guides →
            </a>
          </div>

          <div class="grid gap-4 sm:grid-cols-3">
            <a href="/guides/why-large-file-transfers-are-slow" class="group apple-glass rounded-2xl border border-white/10 bg-ocean-900/80 p-5 shadow-lg transition hover:border-gold-500/50 hover:bg-ocean-900 tap-tactile">
              <span class="text-[10px] font-mono uppercase tracking-wider text-gold-400">Speed</span>
              <h3 class="mt-2 font-bold text-white group-hover:text-gold-400 font-display text-sm transition-colors">Why Large File Transfers Are So Slow</h3>
              <p class="mt-1.5 text-xs text-slate-300">How nearest regional servers and parallel upload streams speed up large deliveries.</p>
            </a>
            <a href="/guides/large-file-transfer-cost-calculator" class="group apple-glass rounded-2xl border border-white/10 bg-ocean-900/80 p-5 shadow-lg transition hover:border-gold-500/50 hover:bg-ocean-900 tap-tactile">
              <span class="text-[10px] font-mono uppercase tracking-wider text-gold-400">Pricing</span>
              <h3 class="mt-2 font-bold text-white group-hover:text-gold-400 font-display text-sm transition-colors">Large File Transfer Cost Calculator</h3>
              <p class="mt-1.5 text-xs text-slate-300">Compare pay-as-you-go credit packs and monthly plans against legacy subscriptions.</p>
            </a>
            <a href="/guides/transfer-large-files-without-failed-uploads" class="group apple-glass rounded-2xl border border-white/10 bg-ocean-900/80 p-5 shadow-lg transition hover:border-gold-500/50 hover:bg-ocean-900 tap-tactile">
              <span class="text-[10px] font-mono uppercase tracking-wider text-gold-400">Reliability</span>
              <h3 class="mt-2 font-bold text-white group-hover:text-gold-400 font-display text-sm transition-colors">Transfer Large Files Without Failed Uploads</h3>
              <p class="mt-1.5 text-xs text-slate-300">How parallel block streaming and automatic retry prevent interrupted uploads.</p>
            </a>
          </div>
        </div>
      </section>
    </main>
  </AppLayout>
</BaseLayout>

