---
export const prerender = true;
import BaseLayout from "../../layouts/BaseLayout.astro";
import EsHeader from "../../components/EsHeader.astro";
import EsFooter from "../../components/EsFooter.astro";
import TransferEmbed from "@/src/components/TransferEmbed";
import { esSeoLandingPages, type EsSeoLandingPage } from "../../data/esSeoLandingPages";
import { brand } from "@/lib/brand";

export function getStaticPaths() {
  return esSeoLandingPages.map((page) => ({
    params: { slug: page.slug },
    props: { page },
  }));
}

interface Props {
  page: EsSeoLandingPage;
}

const { page } = Astro.props;
const canonical = `${brand.siteUrl}/es/${page.slug}`;

const currentIdx = Math.max(0, esSeoLandingPages.findIndex((p) => p.slug === page.slug));
const relatedMap = new Map<string, EsSeoLandingPage>();

for (let offset = 1; offset <= 4; offset++) {
  const candidate = esSeoLandingPages[(currentIdx + offset) % esSeoLandingPages.length];
  if (candidate && candidate.slug !== page.slug) {
    relatedMap.set(candidate.slug, candidate);
  }
}

const relatedSpanishPages = Array.from(relatedMap.values()).slice(0, 3);
const benefitPoints = (page.gigasendSolutionPoints || []).slice(0, 3);

const hreflang = page.isCanonicalEnPair
  ? [
      { lang: "es", href: canonical },
      { lang: "en", href: `${brand.siteUrl}${page.enEquivalent}` },
      { lang: "pt-BR", href: `${brand.siteUrl}${page.ptEquivalent}` },
      { lang: "x-default", href: `${brand.siteUrl}${page.enEquivalent}` },
    ]
  : [{ lang: "es", href: canonical }];

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": `${canonical}/#webpage`,
      url: canonical,
      name: page.metaTitle,
      description: page.metaDescription,
      inLanguage: "es",
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${canonical}/#breadcrumb`,
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Español",
          item: `${brand.siteUrl}/es`,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: page.category || "Guías",
          item: `${brand.siteUrl}/es#guias-completas`,
        },
        {
          "@type": "ListItem",
          position: 3,
          name: page.h1,
          item: canonical,
        },
      ],
    },
    {
      "@type": "FAQPage",
      "@id": `${canonical}/#faq`,
      mainEntity: (page.faqs || []).map((faq) => ({
        "@type": "Question",
        name: faq.question,
        acceptedAnswer: {
          "@type": "Answer",
          text: faq.answer,
        },
      })),
    },
  ],
};
---

<BaseLayout
  title={page.metaTitle}
  description={page.metaDescription}
  canonical={canonical}
  lang="es"
  hreflang={hreflang}
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <div class="relative overflow-hidden bg-ocean-950 text-slate-100 min-h-screen font-body">
    <EsHeader
      activeNav="slug"
      enHref={page.enEquivalent}
      esHref={`/es/${page.slug}`}
      ptHref={page.ptEquivalent}
    />

    <main id="main-content" class="relative max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-10 pb-24">
      <!-- Section 1: 2-Column Hero + Immediate Uploader -->
      <section class="grid lg:grid-cols-12 gap-8 lg:gap-12 items-start mb-20">
        <div class="lg:col-span-6 space-y-5">
          <nav aria-label="Ruta de navegación" class="flex flex-wrap items-center gap-1.5 text-xs text-slate-400">
            <a href="/es" class="min-h-[44px] px-2 -ml-2 inline-flex items-center hover:text-gold-400 transition-colors tap-tactile">
              Español
            </a>
            <span aria-hidden="true">/</span>
            <a href="/es#guias-completas" class="min-h-[44px] px-2 inline-flex items-center hover:text-gold-400 transition-colors tap-tactile">
              {page.category || "Guías"}
            </a>
            <span aria-hidden="true">/</span>
            <span class="text-slate-200 font-medium">{page.h1}</span>
          </nav>

          <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-white leading-tight font-display">
            {page.h1}
          </h1>

          <p class="text-base sm:text-lg text-slate-300 leading-relaxed">
            {page.directAnswer}
          </p>

          <ul class="space-y-3 pt-2 text-sm text-slate-200">
            {benefitPoints.map((pt) => (
              <li class="flex items-start gap-2.5">
                <span class="text-gold-400 font-bold mt-0.5">✓</span>
                <span>{pt}</span>
              </li>
            ))}
          </ul>
        </div>

        <div id="uploader" class="lg:col-span-6">
          <div class="apple-glass rounded-3xl p-4 sm:p-6 relative z-10 shadow-2xl shadow-ocean-950/90 border border-white/10">
            <TransferEmbed client:idle />
          </div>
          <p class="mt-3 text-center text-xs text-slate-400">
            Hasta 10 GB gratis (retención de 3 días) • Descarga en 1 clic sin registro • Cifrado TLS 1.3 + AES-256
          </p>
        </div>
      </section>

      <!-- Section 2: 4-Row Comparison Table -->
      <section class="mb-20">
        <h2 class="text-2xl sm:text-3xl font-extrabold text-white mb-6 font-display">
          Por qué los equipos se pasan a Gigasend
        </h2>
        <div class="overflow-x-auto rounded-2xl border border-white/10 bg-ocean-900/50">
          <table class="w-full min-w-[600px] text-left text-xs sm:text-sm divide-y divide-white/10">
            <thead class="bg-ocean-950/90 text-slate-300">
              <tr>
                <th scope="col" class="p-4 font-bold text-white">Característica</th>
                <th scope="col" class="p-4 font-bold text-gold-400">Gigasend</th>
                <th scope="col" class="p-4 font-bold text-slate-300">WeTransfer</th>
                <th scope="col" class="p-4 font-bold text-slate-300">Google Drive / Dropbox</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-white/10 text-slate-200">
              <tr>
                <th scope="row" class="p-4 font-semibold text-white">Envío gratuito</th>
                <td class="p-4 text-emerald-400 font-semibold">Hasta 10 GB gratis (retención de 3 días)</td>
                <td class="p-4 text-slate-300">2 GB a 3 GB</td>
                <td class="p-4 text-slate-300">Consume el espacio de tu cuenta</td>
              </tr>
              <tr>
                <th scope="row" class="p-4 font-semibold text-white">Planes y recargas</th>
                <td class="p-4 text-emerald-400 font-semibold">Desde 10 US$ (50 GB por 12 meses o 30 GB/mes)</td>
                <td class="p-4 text-slate-300">Suscripción mensual de ~23 US$/mes</td>
                <td class="p-4 text-slate-300">Suscripción mensual recurrente</td>
              </tr>
              <tr>
                <th scope="row" class="p-4 font-semibold text-white">Descarga para el cliente</th>
                <td class="p-4 text-emerald-400 font-semibold">1 clic sin crear cuenta ni iniciar sesión</td>
                <td class="p-4 text-slate-300">Caduca rápido en plan gratuito</td>
                <td class="p-4 text-slate-300">Suele pedir cuenta o permisos de acceso</td>
              </tr>
              <tr>
                <th scope="row" class="p-4 font-semibold text-white">Calidad y estabilidad</th>
                <td class="p-4 text-emerald-400 font-semibold">Sin compresión y con reanudación automática</td>
                <td class="p-4 text-slate-300">Se interrumpe ante cortes de red</td>
                <td class="p-4 text-slate-300">Falla al comprimir carpetas grandes en ZIP</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      <!-- Section 3: FAQ Accordion -->
      {page.faqs && page.faqs.length > 0 && (
        <section class="mb-20">
          <h2 class="text-2xl sm:text-3xl font-extrabold text-white mb-6 font-display">Preguntas frecuentes</h2>
          <div class="space-y-4">
            {page.faqs.map((faq, idx) => (
              <details open={idx === 0} class="group rounded-2xl apple-subtle-glass border border-white/10 p-5 transition-colors hover:border-gold-500/30">
                <summary class="font-semibold text-white cursor-pointer list-none flex justify-between items-center text-base font-display min-h-[36px]">
                  <span>{faq.question}</span>
                  <span class="transition-transform group-open:rotate-180 text-gold-400 text-lg">▾</span>
                </summary>
                <p class="mt-3 text-slate-300 text-sm leading-relaxed border-t border-white/10 pt-3 font-body">
                  {faq.answer}
                </p>
              </details>
            ))}
          </div>
        </section>
      )}

      <!-- Section 4: 3 Curated Related Links -->
      <section class="pt-10 border-t border-white/10">
        <div class="flex flex-wrap items-center justify-between gap-4 mb-6">
          <h2 class="text-xl sm:text-2xl font-extrabold text-white font-display">
            Guías relacionadas
          </h2>
          <a href="/es#guias-completas" class="text-xs font-semibold text-gold-400 hover:underline min-h-[44px] inline-flex items-center">
            Ver todas las guías en español →
          </a>
        </div>

        <div class="grid sm:grid-cols-3 gap-4">
          {relatedSpanishPages.map((rel) => (
            <a
              href={`/es/${rel.slug}`}
              class="group p-5 rounded-2xl apple-glass border border-white/10 hover:border-gold-500/50 transition-all flex flex-col justify-between space-y-3 tap-tactile"
            >
              <div class="space-y-1.5">
                <span class="text-[11px] font-mono font-bold text-gold-400/90">
                  {rel.category || "Guía"}
                </span>
                <h3 class="text-base font-bold text-white group-hover:text-gold-400 transition-colors font-display leading-snug">
                  {rel.h1}
                </h3>
                <p class="text-xs text-slate-400 line-clamp-2 font-body">
                  {rel.metaDescription}
                </p>
              </div>
              <span class="text-xs font-semibold text-gold-400">
                Leer guía →
              </span>
            </a>
          ))}
        </div>
      </section>
    </main>

    <EsFooter />
  </div>
</BaseLayout>
