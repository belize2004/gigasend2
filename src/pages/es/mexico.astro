---
export const prerender = true;
import BaseLayout from "../../layouts/BaseLayout.astro";
import EsHeader from "../../components/EsHeader.astro";
import EsFooter from "../../components/EsFooter.astro";
import TransferEmbed from "@/src/components/TransferEmbed";
import SavingsCalculatorEs from "@/src/components/SavingsCalculatorEs";
import EdgeLocationBadge from "@/src/components/EdgeLocationBadge";
import { brand } from "@/lib/brand";

const pageTitle = "Enviar archivos grandes en México (CDMX/MTY) | Gigasend";
const pageDescription =
  "Transfiere videos 4K y archivos pesados en México sin el límite de 2 GB vía nodos Anycast en CDMX, Guadalajara, Monterrey y Querétaro. Hasta 10 GB gratis.";
const canonical = `${brand.siteUrl}/es/mexico`;

const faqs = [
  {
    question: "¿Qué tan rápido sube un archivo en Telmex Infinitum, Totalplay o Izzi?",
    answer:
      "Al conectarse directamente a los nodos perimetrales en Ciudad de México (MEX), Guadalajara (GDL), Monterrey (MTY) y Querétaro (QRO), Gigasend aprovecha el máximo ancho de banda de tu fibra local sin cruzar hasta servidores lejanos.",
  },
  {
    question: "¿Cómo pago desde México sin suscripciones mensuales forzosas?",
    answer:
      "Puedes enviar hasta 10 GB totalmente gratis (retención de 3 días). Si necesitas paquetes de 50 GB (10 US$), 100 GB (20 US$), 1 TB (180 US$) o 5 TB (800 US$) válidos por 12 meses, pagas en un toque con Apple Pay o tarjetas mexicanas (BBVA, Banamex, Santander, Nu) vía Stripe.",
  },
  {
    question: "¿Puedo mandar el enlace de descarga por WhatsApp a mi destinatario?",
    answer:
      "Sí. Generas un enlace directo HTTPS que pegas en WhatsApp o correo. Tu destinatario descarga el video 4K, proyecto BIM o galería RAW con 1 clic sin perder calidad y sin crear cuenta.",
  },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": `${canonical}/#webpage`,
      url: canonical,
      name: pageTitle,
      description: pageDescription,
      inLanguage: "es-MX",
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${canonical}/#breadcrumb`,
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Inicio (Español)", item: `${brand.siteUrl}/es` },
        { "@type": "ListItem", position: 2, name: "Infraestructura regional", item: `${brand.siteUrl}/es` },
        { "@type": "ListItem", position: 3, name: "México (MEX / GDL / MTY)", item: canonical },
      ],
    },
    {
      "@type": "FAQPage",
      "@id": `${canonical}/#faq`,
      mainEntity: faqs.map((faq) => ({
        "@type": "Question",
        name: faq.question,
        acceptedAnswer: { "@type": "Answer", text: faq.answer },
      })),
    },
  ],
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonical={canonical}
  lang="es-MX"
  hreflang={[
    { lang: "en", href: `${brand.siteUrl}/` },
    { lang: "es-MX", href: canonical },
    { lang: "es", href: `${brand.siteUrl}/es` },
    { lang: "pt-BR", href: `${brand.siteUrl}/pt` },
    { lang: "x-default", href: `${brand.siteUrl}/` },
  ]}
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <div class="relative overflow-hidden bg-ocean-950 text-slate-100 min-h-screen font-body">
    <EsHeader activeNav="mexico" enHref="/" esHref="/es/mexico" ptHref="/pt" />

    <main class="relative max-w-5xl mx-auto px-4 sm:px-6 pt-10 pb-24">
      <nav aria-label="Ruta de navegación" class="flex flex-wrap items-center gap-1.5 text-xs text-slate-400 mb-6 font-body">
        <a href="/es" class="min-h-[44px] px-2 -ml-2 inline-flex items-center hover:text-gold-400 transition-colors tap-tactile">Inicio (Español)</a>
        <span aria-hidden="true">/</span>
        <span class="text-slate-400">Infraestructura perimetral</span>
        <span aria-hidden="true">/</span>
        <span class="text-slate-200 font-medium">México 🇲🇽</span>
      </nav>

      <header class="max-w-3xl mb-12 space-y-4">
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-ocean-900/80 border border-gold-500/30 text-gold-400 label-caps shadow-lg shadow-ocean-950/60">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
          Nodos Anycast en CDMX (MEX), Guadalajara (GDL), Monterrey (MTY) y Querétaro (QRO)
        </div>

        <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-white mb-6 leading-tight font-display">
          Envía archivos pesados en México <span class="text-gold-400">sin límites ni mensualidades.</span>
        </h1>

        <div class="p-6 rounded-2xl apple-glass border border-white/10 text-slate-200 text-base sm:text-lg leading-relaxed font-body shadow-xl shadow-ocean-950/80">
          <p>
            <strong class="text-white font-display">Para mandar archivos grandes en México:</strong> conéctate directamente a los centros de datos perimetrales en CDMX, Guadalajara, Monterrey y Querétaro. Transfiere hasta 10 GB gratis (retención de 3 días) o hasta 5 TB con paquetes de 12 meses (10 US$ / 50 GB • 20 US$ / 100 GB • 180 US$ / 1 TB) en Telmex, Totalplay, Izzi o Starlink sin obligar a tu destinatario a crear cuenta.
          </p>
        </div>
      </header>

      <section id="uploader" class="mb-16">
        <div class="text-center mb-6 space-y-3">
          <EdgeLocationBadge client:load />
          <div>
            <span class="label-caps text-gold-400/90 text-xs">Carga perimetral en México</span>
            <p class="text-xs text-slate-400 font-body">Arrastra archivos o carpetas para transferir a máxima velocidad local.</p>
          </div>
        </div>

        <div class="apple-glass rounded-3xl p-4 sm:p-6 relative z-10 shadow-2xl shadow-ocean-950/90 border border-white/10">
          <TransferEmbed client:idle />
        </div>
      </section>

      <section class="my-16">
        <h2 class="text-2xl font-bold text-white mb-6 font-display">Puntos de presencia perimetral en México</h2>
        <div class="grid md:grid-cols-3 gap-6">
          <div class="p-6 rounded-2xl apple-glass border border-white/10 space-y-2">
            <span class="text-xs text-gold-400 font-mono font-bold">MEX & QRO • CENTRO</span>
            <h3 class="text-lg font-bold text-white font-display">CDMX y Querétaro</h3>
            <p class="text-xs text-slate-300 font-body leading-relaxed">Baja latencia directa con Telmex, Totalplay e Izzi para casas productoras, agencias y despachos en el Valle de México y el Bajío.</p>
          </div>
          <div class="p-6 rounded-2xl apple-glass border border-white/10 space-y-2">
            <span class="text-xs text-gold-400 font-mono font-bold">GDL • OCCIDENTE</span>
            <h3 class="text-lg font-bold text-white font-display">Guadalajara</h3>
            <p class="text-xs text-slate-300 font-body leading-relaxed">Nodo dedicado para estudios de animación, desarrollo de software, drones y fotografía en Jalisco y el Pacífico.</p>
          </div>
          <div class="p-6 rounded-2xl apple-glass border border-white/10 space-y-2">
            <span class="text-xs text-gold-400 font-mono font-bold">MTY • NORTE</span>
            <h3 class="text-lg font-bold text-white font-display">Monterrey</h3>
            <p class="text-xs text-slate-300 font-body leading-relaxed">Interconexión de alta capacidad para ingeniería industrial, arquitectura BIM y manufactura en Nuevo León y la frontera norte.</p>
          </div>
        </div>
      </section>

      <section class="my-20">
        <SavingsCalculatorEs client:visible />
      </section>

      <section class="my-16">
        <h2 class="text-2xl font-bold text-white mb-6 font-display">Preguntas frecuentes en México</h2>
        <div class="space-y-4">
          {faqs.map((faq, idx) => (
            <details open={idx === 0} class="group rounded-2xl apple-subtle-glass border border-white/10 p-5">
              <summary class="font-semibold text-white cursor-pointer list-none flex justify-between items-center text-base font-display min-h-[36px]">
                <span>{faq.question}</span>
                <span class="transition-transform group-open:rotate-180 text-gold-400 text-lg">▾</span>
              </summary>
              <p class="mt-3 text-slate-300 text-sm leading-relaxed border-t border-white/10 pt-3 font-body">{faq.answer}</p>
            </details>
          ))}
        </div>
      </section>

      <section class="mt-16 pt-12 border-t border-white/10 space-y-6">
        <h2 class="text-2xl font-bold text-white font-display">Flujos populares en México</h2>
        <div class="flex flex-wrap gap-2.5">
          <a href="/es/enviar-archivos-whatsapp-sin-perder-calidad" class="min-h-[44px] px-4 py-2.5 inline-flex items-center rounded-xl bg-ocean-900/70 hover:bg-ocean-800 border border-white/10 text-xs text-slate-200 hover:text-gold-400 transition-colors tap-tactile">Mandar video pesado por WhatsApp</a>
          <a href="/es/enviar-video-largo-correo" class="min-h-[44px] px-4 py-2.5 inline-flex items-center rounded-xl bg-ocean-900/70 hover:bg-ocean-800 border border-white/10 text-xs text-slate-200 hover:text-gold-400 transition-colors tap-tactile">Enviar video largo por correo</a>
          <a href="/es/enviar-archivos-10gb" class="min-h-[44px] px-4 py-2.5 inline-flex items-center rounded-xl bg-ocean-900/70 hover:bg-ocean-800 border border-white/10 text-xs text-slate-200 hover:text-gold-400 transition-colors tap-tactile">Enviar archivos de 10 GB gratis</a>
          <a href="/es/programas-como-wetransfer" class="min-h-[44px] px-4 py-2.5 inline-flex items-center rounded-xl bg-ocean-900/70 hover:bg-ocean-800 border border-white/10 text-xs text-slate-200 hover:text-gold-400 transition-colors tap-tactile">Programas como WeTransfer sin límite</a>
          <a href="/es/enviar-fotos-raw-clientes" class="min-h-[44px] px-4 py-2.5 inline-flex items-center rounded-xl bg-ocean-900/70 hover:bg-ocean-800 border border-white/10 text-xs text-slate-200 hover:text-gold-400 transition-colors tap-tactile">Mandar fotos RAW sin comprimir</a>
        </div>
      </section>
    </main>

    <EsFooter />
  </div>
</BaseLayout>
