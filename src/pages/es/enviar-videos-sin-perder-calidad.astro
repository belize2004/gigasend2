---
export const prerender = true;
import BaseLayout from "../../layouts/BaseLayout.astro";
import EsHeader from "../../components/EsHeader.astro";
import EsFooter from "../../components/EsFooter.astro";
import TransferEmbed from "@/src/components/TransferEmbed";
import SavingsCalculatorEs from "@/src/components/SavingsCalculatorEs";
import EdgeLocationBadge from "@/src/components/EdgeLocationBadge";
import { brand } from "@/lib/brand";

const pageTitle = "Enviar videos pesados sin perder calidad | Gigasend";
const pageDescription =
  "Transfiere videos 4K/8K, Apple ProRes, Blackmagic RAW (BRAW) y RED R3D sin compresión y con verificación SHA-256 bit a bit. Hasta 10 GB gratis.";
const canonical = `${brand.siteUrl}/es/enviar-videos-sin-perder-calidad`;

const faqs = [
  {
    question: "¿Gigasend comprime o reduce la resolución de mis videos 4K o 8K?",
    answer:
      "Jamás. Gigasend funciona como un túnel binario verificando cada bloque con hash criptográfico SHA-256. Tus archivos .MOV, .MP4, ProRes 422 HQ, ProRes 4444 XQ, BRAW y R3D llegan exactamente con el mismo bitrate, perfil de color 10-bit/12-bit y metadatos de cámara.",
  },
  {
    question: "¿Cómo mando un video pesado por WhatsApp sin que pierda calidad?",
    answer:
      "Sube el archivo original en Gigasend y pega el enlace generado en tu chat de WhatsApp. Tu cliente toca el enlace y descarga el archivo master original en 1 clic sin sufrir la compresión destructiva de WhatsApp.",
  },
  {
    question: "¿Cuánto cuesta enviar proyectos de video de 50 GB, 100 GB o 500 GB?",
    answer:
      "Hasta 10 GB el envío es 100 % gratuito (con 3 días de retención). Para rodajes mayores, activas paquetes prepagos de 10 US$ (50 GB), 20 US$ (100 GB) o 180 US$ (1 TB) con validez de 12 meses y sin pagar suscripciones mensuales.",
  },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": `${canonical}/#webpage`,
      url: canonical,
      name: pageTitle,
      description: pageDescription,
      inLanguage: "es",
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${canonical}/#breadcrumb`,
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Inicio (Español)", item: `${brand.siteUrl}/es` },
        { "@type": "ListItem", position: 2, name: "Enviar videos sin perder calidad", item: canonical },
      ],
    },
    {
      "@type": "FAQPage",
      "@id": `${canonical}/#faq`,
      mainEntity: faqs.map((faq) => ({
        "@type": "Question",
        name: faq.question,
        acceptedAnswer: { "@type": "Answer", text: faq.answer },
      })),
    },
  ],
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonical={canonical}
  lang="es"
  hreflang={[
    { lang: "en", href: `${brand.siteUrl}/send-large-video-files` },
    { lang: "es", href: canonical },
    { lang: "pt-BR", href: `${brand.siteUrl}/pt/transferir-videos-4k` },
    { lang: "x-default", href: `${brand.siteUrl}/send-large-video-files` },
  ]}
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <div class="relative overflow-hidden bg-ocean-950 text-slate-100 min-h-screen font-body">
    <EsHeader
      activeNav="videos"
      enHref="/send-large-video-files"
      esHref="/es/enviar-videos-sin-perder-calidad"
      ptHref="/pt/transferir-videos-4k"
    />

    <main class="relative max-w-5xl mx-auto px-4 sm:px-6 pt-10 pb-24">
      <nav aria-label="Ruta de navegación" class="flex flex-wrap items-center gap-1.5 text-xs text-slate-400 mb-6 font-body">
        <a href="/es" class="min-h-[44px] px-2 -ml-2 inline-flex items-center hover:text-gold-400 transition-colors tap-tactile">Inicio (Español)</a>
        <span aria-hidden="true">/</span>
        <span class="text-slate-200 font-medium">Enviar videos sin perder calidad</span>
      </nav>

      <header class="max-w-3xl mb-12 space-y-4">
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-ocean-900/80 border border-gold-500/30 text-gold-400 label-caps shadow-lg shadow-ocean-950/60">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
          Integridad SHA-256 bit a bit • ProRes, BRAW, R3D y 4K/8K Master
        </div>

        <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-white mb-6 leading-tight font-display">
          Envía videos pesados <span class="text-gold-400">sin perder calidad.</span>
        </h1>

        <div class="p-6 rounded-2xl apple-glass border border-white/10 text-slate-200 text-base sm:text-lg leading-relaxed font-body shadow-xl shadow-ocean-950/80">
          <p>
            <strong class="text-white font-display">Para enviar videos 4K, 8K y brutos de cine sin compresión:</strong> arrastra tus archivos .MOV, .MP4, ProRes, Blackmagic RAW o RED R3D a Gigasend. Tus masters se transmiten bit a bit con verificación SHA-256 y descarga directa en 1 clic sin obligar al cliente o editor a iniciar sesión.
          </p>
        </div>
      </header>

      <section id="uploader" class="mb-16">
        <div class="text-center mb-6 space-y-3">
          <EdgeLocationBadge client:load />
          <div>
            <span class="label-caps text-gold-400/90 text-xs">Transmisión binaria sin recodificación</span>
            <p class="text-xs text-slate-400 font-body">Sube tus clips o carpetas de rodaje manteniendo el 100 % del rango dinámico y metadatos.</p>
          </div>
        </div>

        <div class="apple-glass rounded-3xl p-4 sm:p-6 relative z-10 shadow-2xl shadow-ocean-950/90 border border-white/10">
          <TransferEmbed client:idle />
        </div>
      </section>

      <section class="my-20">
        <SavingsCalculatorEs client:visible />
      </section>

      <section class="my-16">
        <h2 class="text-2xl font-bold text-white mb-6 font-display">Preguntas frecuentes de video y cine</h2>
        <div class="space-y-4">
          {faqs.map((faq, idx) => (
            <details open={idx === 0} class="group rounded-2xl apple-subtle-glass border border-white/10 p-5">
              <summary class="font-semibold text-white cursor-pointer list-none flex justify-between items-center text-base font-display min-h-[36px]">
                <span>{faq.question}</span>
                <span class="transition-transform group-open:rotate-180 text-gold-400 text-lg">▾</span>
              </summary>
              <p class="mt-3 text-slate-300 text-sm leading-relaxed border-t border-white/10 pt-3 font-body">{faq.answer}</p>
            </details>
          ))}
        </div>
      </section>

      <section class="mt-16 pt-12 border-t border-white/10 space-y-6">
        <h2 class="text-2xl font-bold text-white font-display">Formatos audiovisuales relacionados</h2>
        <div class="flex flex-wrap gap-2.5">
          <a href="/es/enviar-archivos-prores" class="min-h-[44px] px-4 py-2.5 inline-flex items-center rounded-xl bg-ocean-900/70 hover:bg-ocean-800 border border-white/10 text-xs text-slate-200 hover:text-gold-400 transition-colors tap-tactile">Enviar archivos ProRes 4K</a>
          <a href="/es/transferir-proyectos-premiere-pro" class="min-h-[44px] px-4 py-2.5 inline-flex items-center rounded-xl bg-ocean-900/70 hover:bg-ocean-800 border border-white/10 text-xs text-slate-200 hover:text-gold-400 transition-colors tap-tactile">Transferir proyectos Premiere Pro</a>
          <a href="/es/transferir-proyectos-davinci-resolve" class="min-h-[44px] px-4 py-2.5 inline-flex items-center rounded-xl bg-ocean-900/70 hover:bg-ocean-800 border border-white/10 text-xs text-slate-200 hover:text-gold-400 transition-colors tap-tactile">Proyectos DaVinci Resolve y BRAW</a>
          <a href="/es/enviar-video-mp4-5gb" class="min-h-[44px] px-4 py-2.5 inline-flex items-center rounded-xl bg-ocean-900/70 hover:bg-ocean-800 border border-white/10 text-xs text-slate-200 hover:text-gold-400 transition-colors tap-tactile">Enviar video MP4 de más de 5 GB</a>
          <a href="/es/enviar-archivos-whatsapp-sin-perder-calidad" class="min-h-[44px] px-4 py-2.5 inline-flex items-center rounded-xl bg-ocean-900/70 hover:bg-ocean-800 border border-white/10 text-xs text-slate-200 hover:text-gold-400 transition-colors tap-tactile">Video pesado por WhatsApp sin comprimir</a>
        </div>
      </section>
    </main>

    <EsFooter />
  </div>
</BaseLayout>
