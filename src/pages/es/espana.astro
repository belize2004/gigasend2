---
export const prerender = true;
import BaseLayout from "../../layouts/BaseLayout.astro";
import EsHeader from "../../components/EsHeader.astro";
import EsFooter from "../../components/EsFooter.astro";
import TransferEmbed from "@/src/components/TransferEmbed";
import { brand } from "@/lib/brand";

const pageTitle = "Enviar archivos grandes en España (MAD/BCN) | Gigasend";
const pageDescription =
  "Transfiere vídeos 4K y archivos de más de 2 GB en España a velocidad de fibra con servidores locales en Madrid, Barcelona y Valencia. Hasta 10 GB gratis.";
const canonical = `${brand.siteUrl}/es/espana`;

const faqs = [
  {
    question: "¿Dónde se procesan mis transferencias dentro de España?",
    answer:
      "Tus archivos se suben directamente a servidores locales de alta velocidad en Madrid (MAD), Barcelona (BCN) y Valencia (VLC) para aprovechar al máximo tu conexión de fibra óptica.",
  },
  {
    question: "¿Cómo pago desde España y qué métodos se aceptan?",
    answer:
      "Envías hasta 10 GB completamente gratis (retención de 3 días). Para paquetes prepagos de 12 meses —50 GB por 10 US$ (~9,20 €), 100 GB por 20 US$ (~18,40 €), 1 TB por 180 US$ (~165 €) o 5 TB por 800 US$—, puedes pagar al instante con Apple Pay o cualquier tarjeta Visa/Mastercard europea vía Stripe, sin cuotas fijas mensuales.",
  },
  {
    question: "¿Cumple con el RGPD (GDPR) para empresas y estudios españoles?",
    answer:
      "Sí. Toda la transmisión está cifrada con TLS 1.3 y los datos en reposo se almacenan con cifrado AES-256, cumpliendo con los estándares europeos de privacidad.",
  },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": `${canonical}/#webpage`,
      url: canonical,
      name: pageTitle,
      description: pageDescription,
      inLanguage: "es-ES",
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${canonical}/#breadcrumb`,
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Español", item: `${brand.siteUrl}/es` },
        { "@type": "ListItem", position: 2, name: "Regiones", item: `${brand.siteUrl}/es` },
        { "@type": "ListItem", position: 3, name: "España", item: canonical },
      ],
    },
    {
      "@type": "FAQPage",
      "@id": `${canonical}/#faq`,
      mainEntity: faqs.map((faq) => ({
        "@type": "Question",
        name: faq.question,
        acceptedAnswer: { "@type": "Answer", text: faq.answer },
      })),
    },
  ],
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonical={canonical}
  lang="es-ES"
  hreflang={[
    { lang: "en", href: `${brand.siteUrl}/` },
    { lang: "es-ES", href: canonical },
    { lang: "es", href: `${brand.siteUrl}/es` },
    { lang: "pt-BR", href: `${brand.siteUrl}/pt` },
    { lang: "x-default", href: `${brand.siteUrl}/` },
  ]}
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <div class="relative overflow-hidden bg-ocean-950 text-slate-100 min-h-screen font-body">
    <EsHeader activeNav="espana" enHref="/" esHref="/es/espana" ptHref="/pt" />

    <main id="main-content" class="relative max-w-5xl mx-auto px-4 sm:px-6 pt-10 pb-24">
      <nav aria-label="Ruta de navegación" class="flex flex-wrap items-center gap-1.5 text-xs text-slate-400 mb-6 font-body">
        <a href="/es" class="min-h-[44px] px-2 -ml-2 inline-flex items-center hover:text-gold-400 transition-colors tap-tactile">Español</a>
        <span aria-hidden="true">/</span>
        <span class="text-slate-200 font-medium">España 🇪🇸</span>
      </nav>

      <header class="max-w-3xl mb-10 space-y-4">
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-ocean-900/80 border border-gold-500/30 text-gold-400 text-xs font-semibold">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
          Servidores locales de alta velocidad en Madrid, Barcelona y Valencia
        </div>

        <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-white mb-6 leading-tight font-display">
          Envía archivos grandes en España <span class="text-gold-400">a velocidad gigabit.</span>
        </h1>

        <p class="text-slate-300 text-base sm:text-lg leading-relaxed font-body">
          Sube vídeos 4K, brutos ProRes y proyectos completos con Movistar Fibra, MasOrange, Vodafone o Digi. Envía hasta 10 GB gratis (retención de 3 días) o paquetes prepagos desde 10 US$ (~9,20 €) sin cuotas mensuales recurrentes.
        </p>
      </header>

      <section id="uploader" class="mb-16">
        <div class="apple-glass rounded-3xl p-4 sm:p-6 relative z-10 shadow-2xl shadow-ocean-950/90 border border-white/10">
          <TransferEmbed client:idle />
        </div>
      </section>

      <section class="my-16">
        <h2 class="text-2xl font-bold text-white mb-6 font-display">Cobertura de alta velocidad en España</h2>
        <div class="grid md:grid-cols-3 gap-6">
          <div class="p-6 rounded-2xl apple-glass border border-white/10 space-y-2">
            <span class="text-xs text-gold-400 font-mono font-bold">Madrid</span>
            <h3 class="text-lg font-bold text-white font-display">Centro peninsular</h3>
            <p class="text-xs text-slate-300 font-body leading-relaxed">Conexión directa con los principales operadores de fibra en la península para transferencias con menos de 10 ms de latencia.</p>
          </div>
          <div class="p-6 rounded-2xl apple-glass border border-white/10 space-y-2">
            <span class="text-xs text-gold-400 font-mono font-bold">Barcelona</span>
            <h3 class="text-lg font-bold text-white font-display">Arco mediterráneo</h3>
            <p class="text-xs text-slate-300 font-body leading-relaxed">Servidores locales optimizados para estudios de diseño, agencias de publicidad y productoras audiovisuales.</p>
          </div>
          <div class="p-6 rounded-2xl apple-glass border border-white/10 space-y-2">
            <span class="text-xs text-gold-400 font-mono font-bold">Valencia</span>
            <h3 class="text-lg font-bold text-white font-display">Levante y Sur</h3>
            <p class="text-xs text-slate-300 font-body leading-relaxed">Baja latencia y subida con reanudación automática para envíos directos en toda la Comunidad Valenciana y Andalucía.</p>
          </div>
        </div>
      </section>

      <section class="my-16">
        <h2 class="text-2xl font-bold text-white mb-6 font-display">Preguntas frecuentes en España</h2>
        <div class="space-y-4">
          {faqs.map((faq, idx) => (
            <details open={idx === 0} class="group rounded-2xl apple-subtle-glass border border-white/10 p-5">
              <summary class="font-semibold text-white cursor-pointer list-none flex justify-between items-center text-base font-display min-h-[36px]">
                <span>{faq.question}</span>
                <span class="transition-transform group-open:rotate-180 text-gold-400 text-lg">▾</span>
              </summary>
              <p class="mt-3 text-slate-300 text-sm leading-relaxed border-t border-white/10 pt-3 font-body">{faq.answer}</p>
            </details>
          ))}
        </div>
      </section>

      <section class="mt-16 pt-12 border-t border-white/10 space-y-6">
        <h2 class="text-2xl font-bold text-white font-display">Guías destacadas en España</h2>
        <div class="flex flex-wrap gap-2.5">
          <a href="/es/enviar-videos-sin-perder-calidad" class="min-h-[44px] px-4 py-2.5 inline-flex items-center rounded-xl bg-ocean-900/70 hover:bg-ocean-800 border border-white/10 text-xs text-slate-200 hover:text-gold-400 transition-colors tap-tactile">Enviar vídeos 4K sin perder calidad</a>
          <a href="/es/enviar-archivos-mas-de-2gb" class="min-h-[44px] px-4 py-2.5 inline-flex items-center rounded-xl bg-ocean-900/70 hover:bg-ocean-800 border border-white/10 text-xs text-slate-200 hover:text-gold-400 transition-colors tap-tactile">Enviar archivos de más de 2 GB</a>
          <a href="/es/alternativas-a-wetransfer" class="min-h-[44px] px-4 py-2.5 inline-flex items-center rounded-xl bg-ocean-900/70 hover:bg-ocean-800 border border-white/10 text-xs text-slate-200 hover:text-gold-400 transition-colors tap-tactile">Alternativa a WeTransfer en España</a>
        </div>
      </section>
    </main>

    <EsFooter />
  </div>
</BaseLayout>
