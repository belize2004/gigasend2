---
export const prerender = true;
import BaseLayout from "../../layouts/BaseLayout.astro";
import EsHeader from "../../components/EsHeader.astro";
import EsFooter from "../../components/EsFooter.astro";
import TransferEmbed from "@/src/components/TransferEmbed";
import SavingsCalculatorEs from "@/src/components/SavingsCalculatorEs";
import EdgeLocationBadge from "@/src/components/EdgeLocationBadge";
import { brand } from "@/lib/brand";

const pageTitle = "Enviar Archivos Grandes en España (MAD/BCN) | Gigasend";
const pageDescription =
  "Transfiere videos 4K y archivos de más de 2 GB en España a velocidad de fibra vía nodos Anycast en Madrid, Barcelona y Valencia. Hasta 25 GB gratis.";
const canonical = `${brand.siteUrl}/es/espana`;

const faqs = [
  {
    question: "¿Dónde se procesan mis transferencias dentro de España?",
    answer:
      "Tus archivos ingresan directamente en los centros perimetrales de Cloudflare en Madrid (MAD), Barcelona (BCN) o Valencia (VLC), conectados a ESpanix y CATNIX para evitar latencia transatlántica.",
  },
  {
    question: "¿Cómo pago desde España y qué métodos se aceptan?",
    answer:
      "Envías hasta 25 GB completamente gratis. Para paquetes prepagos de 12 meses ($10/50GB, $20/100GB, $180/1TB), puedes pagar al instante con Apple Pay o cualquier tarjeta Visa/Mastercard europea vía Stripe, sin cuotas fijas mensuales.",
  },
  {
    question: "¿Cumple con el RGPD (GDPR) para empresas y estudios españoles?",
    answer:
      "Sí. Toda la transmisión está cifrada con TLS 1.3 y los datos en reposo se almacenan con cifrado AES-256 en almacenamiento perimetral seguro de Cloudflare, cumpliendo con los estándares europeos de privacidad.",
  },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": `${canonical}/#webpage`,
      url: canonical,
      name: pageTitle,
      description: pageDescription,
      inLanguage: "es-ES",
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${canonical}/#breadcrumb`,
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Inicio (Español)", item: `${brand.siteUrl}/es` },
        { "@type": "ListItem", position: 2, name: "Infraestructura Regional", item: `${brand.siteUrl}/es` },
        { "@type": "ListItem", position: 3, name: "España (MAD / BCN / VLC)", item: canonical },
      ],
    },
    {
      "@type": "FAQPage",
      "@id": `${canonical}/#faq`,
      mainEntity: faqs.map((faq) => ({
        "@type": "Question",
        name: faq.question,
        acceptedAnswer: { "@type": "Answer", text: faq.answer },
      })),
    },
  ],
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonical={canonical}
  lang="es-ES"
  hreflang={[{ lang: "es-ES", href: canonical }, { lang: "es", href: `${brand.siteUrl}/es` }]}
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <div class="relative overflow-hidden bg-ocean-950 text-slate-100 min-h-screen font-body">
    <EsHeader activeNav="espana" enHref="/?lang=en" esHref="/es/espana" ptHref="/pt/transferencia-arquivos-grandes-sao-paulo-sp-cdn" />

    <main class="relative max-w-5xl mx-auto px-4 sm:px-6 pt-10 pb-24">
      <nav aria-label="Migas de pan" class="flex flex-wrap items-center gap-1.5 text-xs text-slate-400 mb-6 font-body">
        <a href="/es" class="min-h-[44px] px-2 -ml-2 inline-flex items-center hover:text-gold-400 transition-colors tap-tactile">Inicio (Español)</a>
        <span aria-hidden="true">/</span>
        <span class="text-slate-400">Infraestructura Perimetral</span>
        <span aria-hidden="true">/</span>
        <span class="text-slate-200 font-medium">España 🇪🇸</span>
      </nav>

      <header class="max-w-3xl mb-12 space-y-4">
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-ocean-900/80 border border-gold-500/30 text-gold-400 label-caps shadow-lg shadow-ocean-950/60">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
          Nodos Anycast en Madrid (MAD), Barcelona (BCN) y Valencia (VLC)
        </div>

        <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-white mb-6 leading-tight font-display">
          Envía Archivos Grandes en España <span class="text-gold-400">a Velocidad Gigabit.</span>
        </h1>

        <div class="p-6 rounded-2xl apple-glass border border-white/10 text-slate-200 text-base sm:text-lg leading-relaxed font-body shadow-xl shadow-ocean-950/80">
          <p>
            <strong class="text-white font-display">Para transferir archivos pesados en España:</strong> aprovecha la red perimetral Anycast de Cloudflare conectada directamente a ESpanix y CATNIX (Movistar Fibra, MasOrange, Vodafone, Digi). Sube videos 4K, brutos ProRes y proyectos completos con hasta 25 GB gratis y sin cuotas mensuales de $23 USD.
          </p>
        </div>
      </header>

      <section class="mb-16">
        <div class="text-center mb-6 space-y-3">
          <EdgeLocationBadge client:load />
          <div>
            <span class="label-caps text-gold-400/90 text-xs">Carga Perimetral España</span>
            <p class="text-xs text-slate-400 font-body">Arrastra archivos o carpetas para transferir por fibra óptica a velocidad de línea.</p>
          </div>
        </div>

        <div class="apple-glass rounded-3xl p-4 sm:p-6 relative z-10 shadow-2xl shadow-ocean-950/90 border border-white/10">
          <TransferEmbed client:idle />
        </div>
      </section>

      <section class="my-16">
        <h2 class="text-2xl font-bold text-white mb-6 font-display">Puntos de Presencia Perimetral en España</h2>
        <div class="grid md:grid-cols-3 gap-6">
          <div class="p-6 rounded-2xl apple-glass border border-white/10 space-y-2">
            <span class="text-xs text-gold-400 font-mono font-bold">MAD • MADRID</span>
            <h3 class="text-lg font-bold text-white font-display">Hub Central Ibérico</h3>
            <p class="text-xs text-slate-300 font-body leading-relaxed">Conexión directa con ESpanix y los principales operadores de fibra en la península para transferencias de menos de 10ms.</p>
          </div>
          <div class="p-6 rounded-2xl apple-glass border border-white/10 space-y-2">
            <span class="text-xs text-gold-400 font-mono font-bold">BCN • BARCELONA</span>
            <h3 class="text-lg font-bold text-white font-display">Arco Mediterráneo</h3>
            <p class="text-xs text-slate-300 font-body leading-relaxed">Enrutamiento optimizado mediante CATNIX para estudios de diseño, agencias de publicidad y productoras audiovisuales catalanas.</p>
          </div>
          <div class="p-6 rounded-2xl apple-glass border border-white/10 space-y-2">
            <span class="text-xs text-gold-400 font-mono font-bold">VLC • VALENCIA</span>
            <h3 class="text-lg font-bold text-white font-display">Nodo Levante</h3>
            <p class="text-xs text-slate-300 font-body leading-relaxed">Baja latencia y reanudación automática de bloques para envíos directos a clientes en toda la Comunidad Valenciana y Andalucía.</p>
          </div>
        </div>
      </section>

      <section class="my-20">
        <SavingsCalculatorEs client:visible />
      </section>

      <section class="my-16">
        <h2 class="text-2xl font-bold text-white mb-6 font-display">Preguntas Frecuentes en España</h2>
        <div class="space-y-4">
          {faqs.map((faq, idx) => (
            <details open={idx === 0} class="group rounded-2xl apple-subtle-glass border border-white/10 p-5">
              <summary class="font-semibold text-white cursor-pointer list-none flex justify-between items-center text-base font-display min-h-[36px]">
                <span>{faq.question}</span>
                <span class="transition-transform group-open:rotate-180 text-gold-400 text-lg">▾</span>
              </summary>
              <p class="mt-3 text-slate-300 text-sm leading-relaxed border-t border-white/10 pt-3 font-body">{faq.answer}</p>
            </details>
          ))}
        </div>
      </section>

      <section class="mt-16 pt-12 border-t border-white/10 space-y-6">
        <h2 class="text-2xl font-bold text-white font-display">Flujos Destacados en España</h2>
        <div class="flex flex-wrap gap-2.5">
          <a href="/es/enviar-videos-sin-perder-calidad" class="min-h-[44px] px-4 py-2.5 inline-flex items-center rounded-xl bg-ocean-900/70 hover:bg-ocean-800 border border-white/10 text-xs text-slate-200 hover:text-gold-400 transition-colors tap-tactile">Enviar Videos 4K Sin Perder Calidad</a>
          <a href="/es/enviar-archivos-mas-de-2gb" class="min-h-[44px] px-4 py-2.5 inline-flex items-center rounded-xl bg-ocean-900/70 hover:bg-ocean-800 border border-white/10 text-xs text-slate-200 hover:text-gold-400 transition-colors tap-tactile">Enviar Archivos de Más de 2 GB</a>
          <a href="/es/alternativas-a-wetransfer" class="min-h-[44px] px-4 py-2.5 inline-flex items-center rounded-xl bg-ocean-900/70 hover:bg-ocean-800 border border-white/10 text-xs text-slate-200 hover:text-gold-400 transition-colors tap-tactile">Alternativas a WeTransfer en España</a>
          <a href="/es/enviar-archivos-10gb" class="min-h-[44px] px-4 py-2.5 inline-flex items-center rounded-xl bg-ocean-900/70 hover:bg-ocean-800 border border-white/10 text-xs text-slate-200 hover:text-gold-400 transition-colors tap-tactile">Enviar Archivos de 10 GB Gratis</a>
          <a href="/es/transferir-archivos-cad-bim" class="min-h-[44px] px-4 py-2.5 inline-flex items-center rounded-xl bg-ocean-900/70 hover:bg-ocean-800 border border-white/10 text-xs text-slate-200 hover:text-gold-400 transition-colors tap-tactile">Transferir Modelos BIM y AutoCAD</a>
        </div>
      </section>
    </main>

    <EsFooter />
  </div>
</BaseLayout>
