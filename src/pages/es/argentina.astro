---
export const prerender = true;
import BaseLayout from "../../layouts/BaseLayout.astro";
import EsHeader from "../../components/EsHeader.astro";
import EsFooter from "../../components/EsFooter.astro";
import TransferEmbed from "@/src/components/TransferEmbed";
import SavingsCalculatorEs from "@/src/components/SavingsCalculatorEs";
import EdgeLocationBadge from "@/src/components/EdgeLocationBadge";
import { brand } from "@/lib/brand";

const pageTitle = "Enviar archivos grandes en Argentina (EZE/COR) | Gigasend";
const pageDescription =
  "Transferí archivos de 10 GB a 500 GB+ en Argentina por nodos CABASE en Buenos Aires, Córdoba y Rosario. Hasta 10 GB gratis y sin abonos fijos en dólares.";
const canonical = `${brand.siteUrl}/es/argentina`;

const faqs = [
  {
    question: "¿Por qué Gigasend conviene más en Argentina que una suscripción mensual en dólares?",
    answer:
      "Con WeTransfer Pro o Dropbox pagás todos los meses un abono recurrente en dólares en tu tarjeta aunque no tengas rodajes. En Gigasend enviás hasta 10 GB gratis (con 3 días de retención) y los paquetes de 50 GB (10 US$) o 100 GB (20 US$) duran 12 meses enteros.",
  },
  {
    question: "¿Qué velocidad alcanza en Personal Flow, Movistar Fibra, Telecentro o Claro?",
    answer:
      "Al ingresar directamente por los nodos de Cloudflare conectados a CABASE en Buenos Aires (EZE), Córdoba (COR) y Rosario (ROS), evitás el cuello de botella internacional hacia Miami y aprovechás el máximo de tu fibra simétrica.",
  },
  {
    question: "¿Mi cliente necesita registrarse para descargar los archivos?",
    answer:
      "No. Tu cliente en Argentina o en el exterior hace un solo clic en el enlace y descarga directo en su navegador sin crear cuenta.",
  },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": `${canonical}/#webpage`,
      url: canonical,
      name: pageTitle,
      description: pageDescription,
      inLanguage: "es-AR",
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${canonical}/#breadcrumb`,
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Inicio (Español)", item: `${brand.siteUrl}/es` },
        { "@type": "ListItem", position: 2, name: "Infraestructura regional", item: `${brand.siteUrl}/es` },
        { "@type": "ListItem", position: 3, name: "Argentina (EZE / COR / ROS)", item: canonical },
      ],
    },
    {
      "@type": "FAQPage",
      "@id": `${canonical}/#faq`,
      mainEntity: faqs.map((faq) => ({
        "@type": "Question",
        name: faq.question,
        acceptedAnswer: { "@type": "Answer", text: faq.answer },
      })),
    },
  ],
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonical={canonical}
  lang="es-AR"
  hreflang={[
    { lang: "en", href: `${brand.siteUrl}/` },
    { lang: "es-AR", href: canonical },
    { lang: "es", href: `${brand.siteUrl}/es` },
    { lang: "pt-BR", href: `${brand.siteUrl}/pt` },
    { lang: "x-default", href: `${brand.siteUrl}/` },
  ]}
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <div class="relative overflow-hidden bg-ocean-950 text-slate-100 min-h-screen font-body">
    <EsHeader activeNav="argentina" enHref="/" esHref="/es/argentina" ptHref="/pt" />

    <main class="relative max-w-5xl mx-auto px-4 sm:px-6 pt-10 pb-24">
      <nav aria-label="Ruta de navegación" class="flex flex-wrap items-center gap-1.5 text-xs text-slate-400 mb-6 font-body">
        <a href="/es" class="min-h-[44px] px-2 -ml-2 inline-flex items-center hover:text-gold-400 transition-colors tap-tactile">Inicio (Español)</a>
        <span aria-hidden="true">/</span>
        <span class="text-slate-400">Infraestructura perimetral</span>
        <span aria-hidden="true">/</span>
        <span class="text-slate-200 font-medium">Argentina 🇦🇷</span>
      </nav>

      <header class="max-w-3xl mb-12 space-y-4">
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-ocean-900/80 border border-gold-500/30 text-gold-400 label-caps shadow-lg shadow-ocean-950/60">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
          Nodos Anycast en Buenos Aires (EZE), Córdoba (COR) y Rosario (ROS)
        </div>

        <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-white mb-6 leading-tight font-display">
          Transferencia en Argentina <span class="text-gold-400">sin abonos fijos en dólares.</span>
        </h1>

        <div class="p-6 rounded-2xl apple-glass border border-white/10 text-slate-200 text-base sm:text-lg leading-relaxed font-body shadow-xl shadow-ocean-950/80">
          <p>
            <strong class="text-white font-display">Para enviar archivos grandes desde Argentina:</strong> transmití tus proyectos a través de los nodos locales CABASE en Buenos Aires, Córdoba y Rosario. Enviá hasta 10 GB gratis o usá paquetes prepagos válidos por 12 meses para exportar audiovisuales, VFX y software al mundo sin suscripciones mensuales.
          </p>
        </div>
      </header>

      <section id="uploader" class="mb-16">
        <div class="text-center mb-6 space-y-3">
          <EdgeLocationBadge client:load />
          <div>
            <span class="label-caps text-gold-400/90 text-xs">Carga perimetral en Argentina</span>
            <p class="text-xs text-slate-400 font-body">Arrastrá tus archivos o carpetas para subir a velocidad de fibra local.</p>
          </div>
        </div>

        <div class="apple-glass rounded-3xl p-4 sm:p-6 relative z-10 shadow-2xl shadow-ocean-950/90 border border-white/10">
          <TransferEmbed client:idle />
        </div>
      </section>

      <section class="my-16">
        <h2 class="text-2xl font-bold text-white mb-6 font-display">Puntos de presencia perimetral en Argentina</h2>
        <div class="grid md:grid-cols-3 gap-6">
          <div class="p-6 rounded-2xl apple-glass border border-white/10 space-y-2">
            <span class="text-xs text-gold-400 font-mono font-bold">EZE • BUENOS AIRES</span>
            <h3 class="text-lg font-bold text-white font-display">CABASE / CABA y AMBA</h3>
            <p class="text-xs text-slate-300 font-body leading-relaxed">Interconexión directa con Personal Flow, Movistar Fibra, Telecentro e Iplan para productoras de Palermo, Belgrano y todo el AMBA.</p>
          </div>
          <div class="p-6 rounded-2xl apple-glass border border-white/10 space-y-2">
            <span class="text-xs text-gold-400 font-mono font-bold">COR • CÓRDOBA</span>
            <h3 class="text-lg font-bold text-white font-display">Nodo región Centro</h3>
            <p class="text-xs text-slate-300 font-body leading-relaxed">Baja latencia para estudios de arquitectura, desarrollo de videojuegos e ingeniería en Córdoba y Cuyo.</p>
          </div>
          <div class="p-6 rounded-2xl apple-glass border border-white/10 space-y-2">
            <span class="text-xs text-gold-400 font-mono font-bold">ROS • ROSARIO</span>
            <h3 class="text-lg font-bold text-white font-display">Corredor Litoral y agro</h3>
            <p class="text-xs text-slate-300 font-body leading-relaxed">Subida resiliente para mapeo con drones agrícolas, topografía y empresas agroindustriales en Santa Fe y Entre Ríos.</p>
          </div>
        </div>
      </section>

      <section class="my-20">
        <SavingsCalculatorEs client:visible />
      </section>

      <section class="my-16">
        <h2 class="text-2xl font-bold text-white mb-6 font-display">Preguntas frecuentes en Argentina</h2>
        <div class="space-y-4">
          {faqs.map((faq, idx) => (
            <details open={idx === 0} class="group rounded-2xl apple-subtle-glass border border-white/10 p-5">
              <summary class="font-semibold text-white cursor-pointer list-none flex justify-between items-center text-base font-display min-h-[36px]">
                <span>{faq.question}</span>
                <span class="transition-transform group-open:rotate-180 text-gold-400 text-lg">▾</span>
              </summary>
              <p class="mt-3 text-slate-300 text-sm leading-relaxed border-t border-white/10 pt-3 font-body">{faq.answer}</p>
            </details>
          ))}
        </div>
      </section>

      <section class="mt-16 pt-12 border-t border-white/10 space-y-6">
        <h2 class="text-2xl font-bold text-white font-display">Flujos destacados en Argentina</h2>
        <div class="flex flex-wrap gap-2.5">
          <a href="/es/enviar-archivos-100gb" class="min-h-[44px] px-4 py-2.5 inline-flex items-center rounded-xl bg-ocean-900/70 hover:bg-ocean-800 border border-white/10 text-xs text-slate-200 hover:text-gold-400 transition-colors tap-tactile">Enviar archivos de 100 GB online</a>
          <a href="/es/enviar-archivos-clientes-sin-cuenta" class="min-h-[44px] px-4 py-2.5 inline-flex items-center rounded-xl bg-ocean-900/70 hover:bg-ocean-800 border border-white/10 text-xs text-slate-200 hover:text-gold-400 transition-colors tap-tactile">Enviar a clientes sin cuenta</a>
          <a href="/es/transferencia-archivos-pago-por-uso" class="min-h-[44px] px-4 py-2.5 inline-flex items-center rounded-xl bg-ocean-900/70 hover:bg-ocean-800 border border-white/10 text-xs text-slate-200 hover:text-gold-400 transition-colors tap-tactile">Pago por uso (sin suscripción)</a>
          <a href="/es/enviar-videos-sin-perder-calidad" class="min-h-[44px] px-4 py-2.5 inline-flex items-center rounded-xl bg-ocean-900/70 hover:bg-ocean-800 border border-white/10 text-xs text-slate-200 hover:text-gold-400 transition-colors tap-tactile">Enviar videos 4K sin perder calidad</a>
        </div>
      </section>
    </main>

    <EsFooter />
  </div>
</BaseLayout>
