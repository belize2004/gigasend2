---
export const prerender = true;
import BaseLayout from "../../layouts/BaseLayout.astro";
import EsHeader from "../../components/EsHeader.astro";
import EsFooter from "../../components/EsFooter.astro";
import TransferEmbed from "@/src/components/TransferEmbed";
import SavingsCalculatorEs from "@/src/components/SavingsCalculatorEs";
import EdgeLocationBadge from "@/src/components/EdgeLocationBadge";
import { brand } from "@/lib/brand";

const pageTitle = "Enviar archivos grandes en Colombia (BOG/MDE) | Gigasend";
const pageDescription =
  "Transfiere archivos pesados de 10 GB a 500 GB+ en Colombia a través del NAP Colombia en Bogotá, Medellín, Cali y Barranquilla. Hasta 10 GB gratis.";
const canonical = `${brand.siteUrl}/es/colombia`;

const faqs = [
  {
    question: "¿Cómo evita Gigasend los cortes de subida en Claro, Movistar, ETB y Tigo?",
    answer:
      "Al conectarse a los nodos locales de Cloudflare en Bogotá (BOG), Medellín (MDE), Cali (CLO) y Barranquilla (BAQ), los fragmentos viajan por el NAP Colombia con menos de 12 ms de latencia y reanudación automática de bloques.",
  },
  {
    question: "¿Puedo enviar archivos de 20 GB o 50 GB sin pagar suscripción mensual?",
    answer:
      "Sí. Las transferencias de hasta 10 GB son gratuitas (con 3 días de retención). Para paquetes de 50 GB (10 US$), 100 GB (20 US$) o 1 TB (180 US$), tus créditos duran 12 meses enteros sin cobros recurrentes.",
  },
  {
    question: "¿Mi cliente en Colombia necesita cuenta para descargar?",
    answer:
      "No. Tu cliente abre el enlace y descarga directamente a máxima velocidad desde su navegador sin registrarse ni iniciar sesión.",
  },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": `${canonical}/#webpage`,
      url: canonical,
      name: pageTitle,
      description: pageDescription,
      inLanguage: "es-CO",
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${canonical}/#breadcrumb`,
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Inicio (Español)", item: `${brand.siteUrl}/es` },
        { "@type": "ListItem", position: 2, name: "Infraestructura regional", item: `${brand.siteUrl}/es` },
        { "@type": "ListItem", position: 3, name: "Colombia (BOG / MDE / CLO)", item: canonical },
      ],
    },
    {
      "@type": "FAQPage",
      "@id": `${canonical}/#faq`,
      mainEntity: faqs.map((faq) => ({
        "@type": "Question",
        name: faq.question,
        acceptedAnswer: { "@type": "Answer", text: faq.answer },
      })),
    },
  ],
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonical={canonical}
  lang="es-CO"
  hreflang={[
    { lang: "en", href: `${brand.siteUrl}/` },
    { lang: "es-CO", href: canonical },
    { lang: "es", href: `${brand.siteUrl}/es` },
    { lang: "pt-BR", href: `${brand.siteUrl}/pt` },
    { lang: "x-default", href: `${brand.siteUrl}/` },
  ]}
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <div class="relative overflow-hidden bg-ocean-950 text-slate-100 min-h-screen font-body">
    <EsHeader activeNav="colombia" enHref="/" esHref="/es/colombia" ptHref="/pt" />

    <main class="relative max-w-5xl mx-auto px-4 sm:px-6 pt-10 pb-24">
      <nav aria-label="Ruta de navegación" class="flex flex-wrap items-center gap-1.5 text-xs text-slate-400 mb-6 font-body">
        <a href="/es" class="min-h-[44px] px-2 -ml-2 inline-flex items-center hover:text-gold-400 transition-colors tap-tactile">Inicio (Español)</a>
        <span aria-hidden="true">/</span>
        <span class="text-slate-400">Infraestructura perimetral</span>
        <span aria-hidden="true">/</span>
        <span class="text-slate-200 font-medium">Colombia 🇨🇴</span>
      </nav>

      <header class="max-w-3xl mb-12 space-y-4">
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-ocean-900/80 border border-gold-500/30 text-gold-400 label-caps shadow-lg shadow-ocean-950/60">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
          Nodos Anycast en Bogotá (BOG), Medellín (MDE), Cali (CLO) y Barranquilla (BAQ)
        </div>

        <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-white mb-6 leading-tight font-display">
          Envía archivos pesados en Colombia <span class="text-gold-400">vía NAP Colombia.</span>
        </h1>

        <div class="p-6 rounded-2xl apple-glass border border-white/10 text-slate-200 text-base sm:text-lg leading-relaxed font-body shadow-xl shadow-ocean-950/80">
          <p>
            <strong class="text-white font-display">Para mandar archivos de 10 GB a 500 GB+ en Colombia:</strong> utiliza la red perimetral de Gigasend con presencia directa en Bogotá, Medellín, Cali y Barranquilla. Envía hasta 10 GB gratis sin contratos mensuales y con descarga directa en 1 clic.
          </p>
        </div>
      </header>

      <section id="uploader" class="mb-16">
        <div class="text-center mb-6 space-y-3">
          <EdgeLocationBadge client:load />
          <div>
            <span class="label-caps text-gold-400/90 text-xs">Carga perimetral en Colombia</span>
            <p class="text-xs text-slate-400 font-body">Arrastra archivos o carpetas para transferir por fibra óptica local.</p>
          </div>
        </div>

        <div class="apple-glass rounded-3xl p-4 sm:p-6 relative z-10 shadow-2xl shadow-ocean-950/90 border border-white/10">
          <TransferEmbed client:idle />
        </div>
      </section>

      <section class="my-16">
        <h2 class="text-2xl font-bold text-white mb-6 font-display">Puntos de presencia perimetral en Colombia</h2>
        <div class="grid md:grid-cols-3 gap-6">
          <div class="p-6 rounded-2xl apple-glass border border-white/10 space-y-2">
            <span class="text-xs text-gold-400 font-mono font-bold">BOG • BOGOTÁ</span>
            <h3 class="text-lg font-bold text-white font-display">NAP Colombia central</h3>
            <p class="text-xs text-slate-300 font-body leading-relaxed">Peering directo con ETB Fibra, Claro y Movistar para productoras de cine, televisión y firmas de ingeniería en la capital.</p>
          </div>
          <div class="p-6 rounded-2xl apple-glass border border-white/10 space-y-2">
            <span class="text-xs text-gold-400 font-mono font-bold">MDE • MEDELLÍN</span>
            <h3 class="text-lg font-bold text-white font-display">Hub de innovación en Antioquia</h3>
            <p class="text-xs text-slate-300 font-body leading-relaxed">Transferencia acelerada para estudios creativos, arquitectura BIM y levantamientos con drones en el Valle de Aburrá.</p>
          </div>
          <div class="p-6 rounded-2xl apple-glass border border-white/10 space-y-2">
            <span class="text-xs text-gold-400 font-mono font-bold">CLO & BAQ • PACÍFICO Y CARIBE</span>
            <h3 class="text-lg font-bold text-white font-display">Cali y Barranquilla</h3>
            <p class="text-xs text-slate-300 font-body leading-relaxed">Baja latencia costera y conexión directa a cables submarinos para envíos nacionales e internacionales sin caídas.</p>
          </div>
        </div>
      </section>

      <section class="my-20">
        <SavingsCalculatorEs client:visible />
      </section>

      <section class="my-16">
        <h2 class="text-2xl font-bold text-white mb-6 font-display">Preguntas frecuentes en Colombia</h2>
        <div class="space-y-4">
          {faqs.map((faq, idx) => (
            <details open={idx === 0} class="group rounded-2xl apple-subtle-glass border border-white/10 p-5">
              <summary class="font-semibold text-white cursor-pointer list-none flex justify-between items-center text-base font-display min-h-[36px]">
                <span>{faq.question}</span>
                <span class="transition-transform group-open:rotate-180 text-gold-400 text-lg">▾</span>
              </summary>
              <p class="mt-3 text-slate-300 text-sm leading-relaxed border-t border-white/10 pt-3 font-body">{faq.answer}</p>
            </details>
          ))}
        </div>
      </section>

      <section class="mt-16 pt-12 border-t border-white/10 space-y-6">
        <h2 class="text-2xl font-bold text-white font-display">Flujos destacados en Colombia</h2>
        <div class="flex flex-wrap gap-2.5">
          <a href="/es/enviar-archivos-50gb" class="min-h-[44px] px-4 py-2.5 inline-flex items-center rounded-xl bg-ocean-900/70 hover:bg-ocean-800 border border-white/10 text-xs text-slate-200 hover:text-gold-400 transition-colors tap-tactile">Cómo mandar archivos de 50 GB</a>
          <a href="/es/enviar-carpetas-pesadas" class="min-h-[44px] px-4 py-2.5 inline-flex items-center rounded-xl bg-ocean-900/70 hover:bg-ocean-800 border border-white/10 text-xs text-slate-200 hover:text-gold-400 transition-colors tap-tactile">Enviar carpetas pesadas por internet</a>
          <a href="/es/enviar-videos-sin-perder-calidad" class="min-h-[44px] px-4 py-2.5 inline-flex items-center rounded-xl bg-ocean-900/70 hover:bg-ocean-800 border border-white/10 text-xs text-slate-200 hover:text-gold-400 transition-colors tap-tactile">Enviar videos 4K sin perder calidad</a>
          <a href="/es/enviar-archivos-mas-de-2gb" class="min-h-[44px] px-4 py-2.5 inline-flex items-center rounded-xl bg-ocean-900/70 hover:bg-ocean-800 border border-white/10 text-xs text-slate-200 hover:text-gold-400 transition-colors tap-tactile">Enviar archivos de más de 2 GB</a>
        </div>
      </section>
    </main>

    <EsFooter />
  </div>
</BaseLayout>
