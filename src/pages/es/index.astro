---
export const prerender = true;
import BaseLayout from "../../layouts/BaseLayout.astro";
import EsHeader from "../../components/EsHeader.astro";
import EsFooter from "../../components/EsFooter.astro";
import TransferEmbed from "@/src/components/TransferEmbed";
import { esSeoLandingPages } from "../../data/esSeoLandingPages";
import { brand } from "@/lib/brand";

const groupedSpanishPages = esSeoLandingPages.reduce((acc: Record<string, typeof esSeoLandingPages>, p) => {
  const cat = p.category || "Guías en español";
  if (!acc[cat]) acc[cat] = [];
  acc[cat].push(p);
  return acc;
}, {});
const categoryEntries = Object.entries(groupedSpanishPages);
const totalSpanishCount = esSeoLandingPages.length + 7;

const pageTitle = "Enviar archivos grandes gratis (hasta 10 GB) | Gigasend";
const pageDescription =
  "Comparte vídeos 4K, carpetas pesadas y proyectos creativos de hasta 5 TB sin comprimir. Tus primeros 10 GB son gratis (retención de 3 días) y el destinatario descarga sin registrarse.";
const canonical = `${brand.siteUrl}/es`;

const faqs = [
  {
    question: "¿Cómo enviar archivos grandes o vídeos pesados sin perder calidad?",
    answer:
      "Arrastra tu archivo o carpeta directamente a Gigasend. Tus datos se transfieren bit a bit con verificación SHA-256 sin comprimir, recodificar ni alterar la calidad original de tus vídeos.",
  },
  {
    question: "¿Cuánto cuesta y qué opciones de pago existen en España y Latinoamérica?",
    answer:
      "Envías hasta 10 GB completamente gratis con retención de 3 días. Para archivos más pesados, ofrecemos planes mensuales desde 10 US$/mes (30 GB, retención de 30 días) o paquetes prepagos válidos por 12 meses sin cargos recurrentes: 50 GB (10 US$ · 0,20 US$/GB), 100 GB (20 US$ · 0,20 US$/GB), 1 TB (180 US$ · 0,18 US$/GB) y 5 TB (800 US$ · 0,16 US$/GB).",
  },
  {
    question: "¿El destinatario necesita crear una cuenta para descargar?",
    answer:
      "No. Tu destinatario no necesita registrarse ni instalar programas. Solo abre el enlace y descarga el archivo completo en un clic sin cargos adicionales por descarga.",
  },
  {
    question: "¿Qué pasa si mi conexión a internet se corta durante la subida?",
    answer:
      "Gigasend cuenta con subida con reanudación automática en el navegador. Si tu conexión se interrumpe, la transferencia continúa exactamente donde se quedó sin empezar desde cero.",
  },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": `${canonical}/#webpage`,
      url: canonical,
      name: pageTitle,
      description: pageDescription,
      inLanguage: "es",
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${canonical}/#breadcrumb`,
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: brand.productName,
          item: `${brand.siteUrl}/`,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Español",
          item: canonical,
        },
      ],
    },
    {
      "@type": "FAQPage",
      "@id": `${canonical}/#faq`,
      mainEntity: faqs.map((faq) => ({
        "@type": "Question",
        name: faq.question,
        acceptedAnswer: {
          "@type": "Answer",
          text: faq.answer,
        },
      })),
    },
  ],
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonical={canonical}
  lang="es"
  hreflang={[
    { lang: "en", href: `${brand.siteUrl}/` },
    { lang: "es", href: canonical },
    { lang: "pt-BR", href: `${brand.siteUrl}/pt` },
    { lang: "x-default", href: `${brand.siteUrl}/` },
  ]}
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <div class="relative overflow-hidden bg-ocean-950 text-slate-100 min-h-screen font-body">
    <EsHeader activeNav="hub" enHref="/?lang=en" esHref="/es" ptHref="/pt" />

    <main id="main-content" class="relative max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-12 pb-24">
      <!-- Hero + Immediate Uploader -->
      <header class="text-center max-w-3xl mx-auto mb-10 space-y-5">
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-ocean-900/80 border border-gold-500/30 text-gold-400 text-xs font-semibold">
          <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
          Hasta 10 GB gratis • Retención de 3 días • Sin registro para descargar
        </div>

        <h1 class="text-4xl sm:text-6xl font-extrabold text-white tracking-tight leading-[1.08] font-display">
          Envía archivos grandes. <span class="text-gold-400">Así de simple.</span>
        </h1>

        <p class="text-lg sm:text-xl text-slate-300 max-w-2xl mx-auto leading-relaxed font-body">
          Comparte vídeos 4K, carpetas pesadas y proyectos creativos de hasta 5 TB sin comprimir. Tus primeros 10 GB son gratis y el destinatario descarga sin registrarse.
        </p>
      </header>

      <!-- Primary Dropzone Stage -->
      <section id="uploader" class="max-w-3xl mx-auto mb-20">
        <div id="uploader-stage" class="apple-glass rounded-3xl p-4 sm:p-6 relative z-10 shadow-2xl shadow-ocean-950/90 border border-white/10">
          <TransferEmbed client:idle />
        </div>

        <div class="grid grid-cols-3 gap-4 mt-6 text-center text-xs text-slate-300">
          <div class="p-3.5 rounded-xl apple-subtle-glass border border-white/10">
            <span class="block text-gold-400 font-bold text-sm mb-0.5 font-display">Hasta 10 GB gratis</span>
            Retención de 3 días
          </div>
          <div class="p-3.5 rounded-xl apple-subtle-glass border border-white/10">
            <span class="block text-white font-bold text-sm mb-0.5 font-display">Calidad original</span>
            Sin compresión ni pérdida
          </div>
          <div class="p-3.5 rounded-xl apple-subtle-glass border border-white/10">
            <span class="block text-white font-bold text-sm mb-0.5 font-display">Descarga en 1 clic</span>
            Sin cuenta para el cliente
          </div>
        </div>
      </section>

      <!-- Clean Comparison Section -->
      <section id="comparativa-espanol" class="max-w-4xl mx-auto mb-20">
        <div class="text-center mb-10 space-y-2">
          <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-white font-display">
            Por qué los equipos eligen Gigasend
          </h2>
          <p class="text-slate-400 text-sm font-body max-w-xl mx-auto">
            Compara Gigasend frente a WeTransfer y las nubes tradicionales.
          </p>
        </div>

        <div class="overflow-x-auto rounded-2xl border border-white/10 bg-ocean-900/50">
          <table class="w-full min-w-[600px] text-left text-xs sm:text-sm divide-y divide-white/10">
            <thead class="bg-ocean-950/90 text-slate-300">
              <tr>
                <th scope="col" class="p-4 font-bold text-white">Característica</th>
                <th scope="col" class="p-4 font-bold text-gold-400">Gigasend</th>
                <th scope="col" class="p-4 font-bold text-slate-300">WeTransfer</th>
                <th scope="col" class="p-4 font-bold text-slate-300">Google Drive / Dropbox</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-white/10 text-slate-200">
              <tr>
                <th scope="row" class="p-4 font-semibold text-white">Envío gratuito</th>
                <td class="p-4 text-emerald-400 font-semibold">Hasta 10 GB gratis (3 días)</td>
                <td class="p-4 text-slate-300">2 GB a 3 GB</td>
                <td class="p-4 text-slate-300">Comparte la cuota de tu cuenta</td>
              </tr>
              <tr>
                <th scope="row" class="p-4 font-semibold text-white">Opciones de pago</th>
                <td class="p-4 text-emerald-400 font-semibold">Desde 10 US$ (50 GB por 12 meses o 30 GB/mes)</td>
                <td class="p-4 text-slate-300">Suscripción mensual fija (~23 US$/mes)</td>
                <td class="p-4 text-slate-300">Suscripción mensual obligatoria</td>
              </tr>
              <tr>
                <th scope="row" class="p-4 font-semibold text-white">Experiencia del destinatario</th>
                <td class="p-4 text-emerald-400 font-semibold">Descarga en 1 clic sin registro</td>
                <td class="p-4 text-slate-300">Enlace con vencimiento corto</td>
                <td class="p-4 text-slate-300">Suele pedir cuenta o permisos</td>
              </tr>
              <tr>
                <th scope="row" class="p-4 font-semibold text-white">Estabilidad de subida</th>
                <td class="p-4 text-emerald-400 font-semibold">Subida con reanudación automática</td>
                <td class="p-4 text-slate-300">Sensible a microcortes</td>
                <td class="p-4 text-slate-300">Lento con carpetas grandes</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      <!-- Regional Hubs & Core Guides -->
      <section class="max-w-5xl mx-auto mb-20 pt-8 border-t border-white/10">
        <div class="text-center mb-10 space-y-2">
          <h2 class="text-2xl sm:text-3xl font-extrabold text-white font-display">
            Regiones y guías destacadas
          </h2>
          <p class="text-slate-400 text-sm font-body max-w-2xl mx-auto">
            Servidores locales de alta velocidad en España y Latinoamérica con precios claros en cada país.
          </p>
        </div>

        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
          <a href="/es/mexico" class="group p-6 rounded-2xl apple-glass border border-white/10 hover:border-gold-500/50 transition-all flex flex-col justify-between space-y-3">
            <div class="space-y-2">
              <div class="flex items-center justify-between">
                <span class="text-xs font-mono font-bold text-gold-400">México</span>
                <span class="text-lg">🇲🇽</span>
              </div>
              <h3 class="text-lg font-bold text-white group-hover:text-gold-400 transition-colors font-display">
                Enviar archivos en México
              </h3>
              <p class="text-xs text-slate-300 font-body leading-relaxed">
                Servidores locales de alta velocidad en Ciudad de México, Guadalajara, Monterrey y Querétaro.
              </p>
            </div>
            <span class="text-xs font-semibold text-gold-400">Ver guía de México →</span>
          </a>

          <a href="/es/espana" class="group p-6 rounded-2xl apple-glass border border-white/10 hover:border-gold-500/50 transition-all flex flex-col justify-between space-y-3">
            <div class="space-y-2">
              <div class="flex items-center justify-between">
                <span class="text-xs font-mono font-bold text-gold-400">España</span>
                <span class="text-lg">🇪🇸</span>
              </div>
              <h3 class="text-lg font-bold text-white group-hover:text-gold-400 transition-colors font-display">
                Enviar archivos en España
              </h3>
              <p class="text-xs text-slate-300 font-body leading-relaxed">
                Servidores locales de alta velocidad en Madrid, Barcelona y Valencia con cumplimiento del RGPD.
              </p>
            </div>
            <span class="text-xs font-semibold text-gold-400">Ver guía de España →</span>
          </a>

          <a href="/es/colombia" class="group p-6 rounded-2xl apple-glass border border-white/10 hover:border-gold-500/50 transition-all flex flex-col justify-between space-y-3">
            <div class="space-y-2">
              <div class="flex items-center justify-between">
                <span class="text-xs font-mono font-bold text-gold-400">Colombia</span>
                <span class="text-lg">🇨🇴</span>
              </div>
              <h3 class="text-lg font-bold text-white group-hover:text-gold-400 transition-colors font-display">
                Enviar archivos en Colombia
              </h3>
              <p class="text-xs text-slate-300 font-body leading-relaxed">
                Servidores locales de alta velocidad en Bogotá, Medellín, Cali y Barranquilla con subida estable.
              </p>
            </div>
            <span class="text-xs font-semibold text-gold-400">Ver guía de Colombia →</span>
          </a>

          <a href="/es/argentina" class="group p-6 rounded-2xl apple-glass border border-white/10 hover:border-gold-500/50 transition-all flex flex-col justify-between space-y-3">
            <div class="space-y-2">
              <div class="flex items-center justify-between">
                <span class="text-xs font-mono font-bold text-gold-400">Argentina</span>
                <span class="text-lg">🇦🇷</span>
              </div>
              <h3 class="text-lg font-bold text-white group-hover:text-gold-400 transition-colors font-display">
                Enviar archivos en Argentina
              </h3>
              <p class="text-xs text-slate-300 font-body leading-relaxed">
                Servidores locales en Buenos Aires, Córdoba y Rosario con paquetes prepagos de 12 meses sin cargos mensuales fijos.
              </p>
            </div>
            <span class="text-xs font-semibold text-gold-400">Ver guía de Argentina →</span>
          </a>

          <a href="/es/enviar-videos-sin-perder-calidad" class="group p-6 rounded-2xl apple-glass border border-gold-500/30 hover:border-gold-400 transition-all flex flex-col justify-between space-y-3">
            <div class="space-y-2">
              <div class="flex items-center justify-between">
                <span class="text-xs font-mono font-bold text-emerald-400">4K / 8K RAW</span>
                <span class="text-xs px-2 py-0.5 rounded-full bg-gold-500/20 text-gold-400 font-bold">Guía destacada</span>
              </div>
              <h3 class="text-lg font-bold text-white group-hover:text-gold-400 transition-colors font-display">
                Enviar vídeos sin perder calidad
              </h3>
              <p class="text-xs text-slate-300 font-body leading-relaxed">
                Comparte archivos ProRes, BRAW, R3D y MP4 en su calidad original sin compresión ni recodificación.
              </p>
            </div>
            <span class="text-xs font-semibold text-gold-400">Ver guía de vídeo →</span>
          </a>

          <a href="/es/enviar-archivos-mas-de-2gb" class="group p-6 rounded-2xl apple-glass border border-gold-500/30 hover:border-gold-400 transition-all flex flex-col justify-between space-y-3">
            <div class="space-y-2">
              <div class="flex items-center justify-between">
                <span class="text-xs font-mono font-bold text-emerald-400">5 GB a 5 TB</span>
                <span class="text-xs px-2 py-0.5 rounded-full bg-gold-500/20 text-gold-400 font-bold">Guía destacada</span>
              </div>
              <h3 class="text-lg font-bold text-white group-hover:text-gold-400 transition-colors font-display">
                Enviar archivos de más de 2 GB
              </h3>
              <p class="text-xs text-slate-300 font-body leading-relaxed">
                Supera el límite de 2 GB con 10 GB gratis y paquetes prepagos válidos por 12 meses.
              </p>
            </div>
            <span class="text-xs font-semibold text-gold-400">Ver guía de más de 2 GB →</span>
          </a>
        </div>
      </section>

      <!-- FAQ Section -->
      <section class="max-w-3xl mx-auto mb-16">
        <div class="text-center mb-8 space-y-2">
          <h2 class="text-2xl sm:text-3xl font-extrabold text-white font-display">Preguntas frecuentes</h2>
        </div>
        <div class="space-y-4">
          {faqs.map((faq, idx) => (
            <details open={idx === 0} class="group rounded-2xl apple-subtle-glass border border-white/10 p-5 transition-all hover:border-gold-500/30">
              <summary class="font-semibold text-white cursor-pointer list-none flex justify-between items-center text-base font-display min-h-[36px]">
                <span>{faq.question}</span>
                <span class="transition-transform group-open:rotate-180 text-gold-400 text-lg">▾</span>
              </summary>
              <p class="mt-3 text-slate-300 text-sm leading-relaxed border-t border-white/10 pt-3 font-body">
                {faq.answer}
              </p>
            </details>
          ))}
        </div>
      </section>

      <!-- Collapsible Workflow Directory (#guias-completas) -->
      <section id="guias-completas" class="max-w-5xl mx-auto mb-12 pt-8 border-t border-white/10">
        <div class="text-center mb-8 space-y-2">
          <h2 class="text-2xl sm:text-3xl font-extrabold text-white font-display">
            Guías por flujo de trabajo ({totalSpanishCount})
          </h2>
          <p class="text-slate-400 text-sm font-body max-w-2xl mx-auto">
            Selecciona una categoría para explorar guías específicas por tamaño de archivo, formato profesional o industria.
          </p>
        </div>

        <div class="space-y-3">
          {categoryEntries.map(([category, items]) => (
            <details class="group rounded-2xl apple-subtle-glass p-5 border border-white/10">
              <summary class="font-bold text-white cursor-pointer list-none flex justify-between items-center text-base font-display min-h-[44px]">
                <span class="flex items-center gap-3">
                  <span class="w-2 h-2 rounded-full bg-gold-400"></span>
                  <span>{category}</span>
                  <span class="text-xs font-mono px-2.5 py-0.5 rounded-full bg-ocean-900/90 text-gold-400 border border-gold-500/20">
                    {items.length} {items.length === 1 ? "guía" : "guías"}
                  </span>
                </span>
                <span class="transition-transform group-open:rotate-180 text-gold-400 text-lg">▾</span>
              </summary>
              <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-2.5 pt-4 mt-2 border-t border-white/10">
                {items.map((p) => (
                  <a
                    href={`/es/${p.slug}`}
                    class="min-h-[44px] px-4 py-3 rounded-xl bg-ocean-900/40 hover:bg-ocean-800/70 border border-white/10 hover:border-gold-500/40 text-xs text-slate-200 hover:text-gold-400 transition-all flex items-center justify-between gap-2 font-body tap-tactile"
                  >
                    <span class="line-clamp-1">{p.h1}</span>
                    <span class="text-gold-400/70 shrink-0">→</span>
                  </a>
                ))}
              </div>
            </details>
          ))}
        </div>
      </section>
    </main>

    <EsFooter />
  </div>
</BaseLayout>
