---
import BaseLayout from "../layouts/BaseLayout.astro";
import ContactApp from "@/src/components/ContactApp";
import { brand } from "@/lib/brand";
---

<BaseLayout
  title={`Contact Us | ${brand.productName}`}
  description={`Get in touch with the ${brand.productName} team. Send us your questions, feedback, or support inquiries.`}
>
  <div class="bg-ocean-950 text-slate-100 min-h-screen">
    <ContactApp client:load />
  </div>
</BaseLayout>
