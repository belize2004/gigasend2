---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PtHeader from "../../components/PtHeader.astro";
import PtFooter from "../../components/PtFooter.astro";
import {
  ptSeoLandingPages,
  ptSeoLandingPageMap,
} from "../../data/ptSeoLandingPages";
import { getLanguageSwitchPaths } from "../../data/languageSwitchPaths";
import { brand } from "@/lib/brand";
import TransferEmbed from "@/src/components/TransferEmbed";

export const prerender = true;

export function getStaticPaths() {
  return ptSeoLandingPages.map((page) => ({
    params: { slug: page.slug },
  }));
}

const { slug } = Astro.params;
const landingPage = slug ? ptSeoLandingPageMap.get(slug) : undefined;

if (!landingPage) {
  return Astro.redirect("/pt");
}

const langPaths = getLanguageSwitchPaths(`/pt/${landingPage.slug}`);
const canonical = `${brand.siteUrl}/pt/${landingPage.slug}`;
const enCanonical = `${brand.siteUrl}${landingPage.enEquivalent}`;

const hreflang = landingPage.isCanonicalEnPair
  ? [
      { lang: "en", href: enCanonical },
      { lang: "pt-BR", href: canonical },
      { lang: "x-default", href: enCanonical },
    ]
  : [{ lang: "pt-BR", href: canonical }];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: landingPage.faqs.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: faq.answer,
    },
  })),
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Brasil (Português)",
      item: `${brand.siteUrl}/pt`,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: landingPage.clusterLabel,
      item: `${brand.siteUrl}/pt#cluster-${landingPage.cluster}`,
    },
    {
      "@type": "ListItem",
      position: 3,
      name: landingPage.h1,
      item: canonical,
    },
  ],
};

const relatedPages = ptSeoLandingPages
  .filter((p) => p.cluster === landingPage.cluster && p.slug !== landingPage.slug)
  .slice(0, 3);
---

<BaseLayout
  title={landingPage.title}
  description={landingPage.metaDescription}
  canonical={canonical}
  lang="pt-BR"
  hreflang={hreflang}
>
  <Fragment slot="head">
    <link rel="alternate" hreflang="es" href={`https://gigasend.us${langPaths.esPath}`} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </Fragment>

  <main id="main-content" class="min-h-screen bg-ocean-950 text-slate-100 font-body">
    <PtHeader
      activeNav="slug"
      enHref={langPaths.enHref}
      esHref={langPaths.esHref}
      ptHref={langPaths.ptHref}
    />

    <!-- Section 1: Clean 2-Column Hero + Immediate Uploader -->
    <section class="relative bg-gradient-to-b from-ocean-950 via-ocean-900 to-ocean-950 border-b border-white/10">
      <div class="mx-auto grid max-w-7xl gap-10 px-4 py-12 sm:px-6 lg:grid-cols-[1.05fr_0.95fr] lg:px-8 lg:py-16 items-start">
        <div class="space-y-5">
          <nav aria-label="Caminho de navegação" class="flex flex-wrap items-center gap-1.5 text-xs text-slate-400">
            <a href="/pt" class="inline-flex min-h-[40px] items-center hover:text-gold-400 transition-colors">Brasil</a>
            <span aria-hidden="true">/</span>
            <a href={`/pt#cluster-${landingPage.cluster}`} class="inline-flex min-h-[40px] items-center hover:text-gold-400 transition-colors">
              {landingPage.clusterLabel}
            </a>
            <span aria-hidden="true">/</span>
            <span class="font-medium text-slate-200 truncate max-w-[240px]" aria-current="page">
              {landingPage.h1}
            </span>
          </nav>

          <h1 class="text-3xl font-black leading-tight text-white font-display tracking-tight sm:text-5xl">
            {landingPage.h1}
          </h1>

          <p class="text-base sm:text-lg leading-relaxed text-slate-300">
            {landingPage.intro}
          </p>

          {landingPage.personaCtaNote && (
            <p class="rounded-xl border border-emerald-500/25 bg-emerald-950/25 px-4 py-3 text-xs text-emerald-300 font-medium">
              ✓ {landingPage.personaCtaNote}
            </p>
          )}

          <div class="flex flex-wrap gap-3 pt-2">
            <a href="#uploader-stage" class="btn-gold inline-flex min-h-[48px] items-center justify-center rounded-xl px-6 py-3.5 text-sm font-bold shadow-xl shadow-gold-500/20 tap-tactile">
              {landingPage.cta}
            </a>
            <a href="/pt/planos" class="btn-outline-gold inline-flex min-h-[48px] items-center justify-center rounded-xl px-6 py-3.5 text-sm font-bold tap-tactile">
              Ver planos e pacotes
            </a>
          </div>
        </div>

        <div id="uploader-stage" class="scroll-mt-24">
          <div class="apple-glass rounded-3xl p-4 sm:p-6 border border-white/10 shadow-2xl">
            <TransferEmbed client:load />
          </div>
          <p class="mt-3 text-center text-xs text-slate-400">
            Até 10 GB grátis (retenção de 3 dias) • Download em 1 clique sem cadastro • Criptografia TLS 1.3 + AES-256
          </p>
        </div>
      </div>
    </section>

    <!-- Section 2: 3 Why Gigasend Cards + 4-Row Comparison Table -->
    <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8 space-y-12">
      <div>
        <h2 class="text-2xl sm:text-3xl font-black text-white font-display mb-6">
          Por que equipes migram para o {brand.productName}
        </h2>
        <div class="grid gap-6 lg:grid-cols-3">
          {landingPage.sections.slice(0, 3).map((section) => (
            <article class="apple-glass rounded-2xl p-6">
              <h3 class="text-lg font-bold text-white font-display">{section.heading}</h3>
              <p class="mt-3 leading-relaxed text-slate-300 text-sm">{section.body}</p>
            </article>
          ))}
        </div>
      </div>

      <div class="overflow-hidden rounded-2xl border border-white/10 bg-ocean-900/50">
        <div class="overflow-x-auto">
          <table class="min-w-[680px] w-full divide-y divide-white/10 text-left text-sm">
            <thead class="bg-ocean-950/95">
              <tr>
                <th scope="col" class="sticky left-0 z-10 bg-ocean-950/95 p-4 font-semibold text-white text-xs border-r border-white/10">Recurso / plataforma</th>
                <th scope="col" class="p-4 font-semibold text-white text-xs">Melhor para</th>
                <th scope="col" class="p-4 font-semibold text-white text-xs">Limitação comum</th>
                <th scope="col" class="p-4 font-semibold text-gold-400 text-xs">Vantagem {brand.productName}</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-white/10 bg-ocean-900/40">
              {landingPage.comparison.slice(0, 4).map((row) => (
                <tr>
                  <th scope="row" class="sticky left-0 z-10 bg-ocean-950/95 p-4 font-bold text-white font-display border-r border-white/10">{row.method}</th>
                  <td class="p-4 text-slate-300">{row.bestFor}</td>
                  <td class="p-4 text-rose-300">{row.limitation}</td>
                  <td class="p-4 font-semibold text-gold-400">{row.gigaSendAngle}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Section 3: FAQ Section -->
    <section class="mx-auto max-w-5xl px-4 py-12 sm:px-6 lg:px-8">
      <h2 class="text-2xl sm:text-3xl font-bold text-white font-display">Perguntas frequentes</h2>
      <div class="mt-6 space-y-4">
        {landingPage.faqs.map((faq, index) => (
          <details
            class="apple-glass rounded-2xl p-5 group"
            open={index === 0}
          >
            <summary class="flex min-h-[44px] cursor-pointer list-none items-center justify-between gap-4 font-semibold text-white font-display group-hover:text-gold-400 transition-colors">
              <span>{faq.question}</span>
              <span class="shrink-0 text-gold-400 transition-transform duration-200 group-open:rotate-180" aria-hidden="true">
                ▼
              </span>
            </summary>
            <p class="mt-3 border-t border-white/10 pt-3 leading-relaxed text-slate-300 text-sm">{faq.answer}</p>
          </details>
        ))}
      </div>
    </section>

    <!-- Section 4: 3 Related Workflow Cards -->
    <section class="border-t border-white/10 bg-ocean-900/40 py-14">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="flex flex-wrap items-center justify-between gap-4 mb-6">
          <h2 class="text-xl sm:text-2xl font-bold text-white font-display">
            Soluções relacionadas
          </h2>
          <a href={`/pt#cluster-${landingPage.cluster}`} class="inline-flex min-h-[44px] items-center text-xs font-semibold text-gold-400 hover:underline">
            Ver todas as soluções em português →
          </a>
        </div>

        <div class="grid gap-4 sm:grid-cols-3">
          {relatedPages.map((p) => (
            <a
              href={`/pt/${p.slug}`}
              class="group rounded-2xl border border-white/10 bg-ocean-900/85 p-5 transition hover:border-gold-500/50 hover:bg-ocean-900 tap-tactile flex flex-col justify-between"
            >
              <div>
                <span class="text-[11px] font-mono text-gold-400">{p.clusterLabel}</span>
                <h3 class="mt-1.5 font-bold text-white group-hover:text-gold-400 font-display text-base transition-colors">
                  {p.h1}
                </h3>
                <p class="mt-2 text-xs text-slate-300 line-clamp-2 leading-relaxed">
                  {p.metaDescription}
                </p>
              </div>
              <span class="mt-4 text-xs font-semibold text-gold-400">Acessar solução →</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <PtFooter />
  </main>
</BaseLayout>
