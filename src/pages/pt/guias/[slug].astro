---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PtHeader from "../../../components/PtHeader.astro";
import PtFooter from "../../../components/PtFooter.astro";
import { PT_ENGINEERING_GUIDES, ptGuideMap } from "../../../data/ptGuides";
import { getLanguageSwitchPaths } from "../../../data/languageSwitchPaths";
import { brand } from "@/lib/brand";

export const prerender = true;

export function getStaticPaths() {
  return PT_ENGINEERING_GUIDES.map((g) => ({
    params: { slug: g.slug },
  }));
}

const { slug } = Astro.params;
const guide = slug ? ptGuideMap.get(slug) : undefined;

if (!guide) {
  return Astro.redirect("/pt/guias");
}

const langPaths = getLanguageSwitchPaths(`/pt/guias/${guide.slug}`);
const canonical = `${brand.siteUrl}/pt/guias/${guide.slug}`;
const enCanonical = `${brand.siteUrl}${guide.enEquivalent}`;
const hreflang = [
  { lang: "en", href: enCanonical },
  { lang: "pt-BR", href: canonical },
  { lang: "x-default", href: enCanonical },
];

const otherGuides = PT_ENGINEERING_GUIDES.filter((g) => g.slug !== guide.slug).slice(0, 3);

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "TechArticle",
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": canonical,
  },
  headline: guide.h1,
  description: guide.metaDescription,
  image: `${brand.siteUrl}/og-image.png`,
  datePublished: "2025-02-01T08:00:00-03:00",
  dateModified: new Date().toISOString(),
  url: canonical,
  inLanguage: "pt-BR",
  author: {
    "@type": "Organization",
    name: `${brand.productName} Brasil`,
    url: `${brand.siteUrl}/pt`,
  },
  publisher: {
    "@type": "Organization",
    name: brand.productName,
    url: brand.siteUrl,
    logo: {
      "@type": "ImageObject",
      url: `${brand.siteUrl}/favicon.svg`,
    },
  },
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Brasil", item: `${brand.siteUrl}/pt` },
    { "@type": "ListItem", position: 2, name: "Guias", item: `${brand.siteUrl}/pt/guias` },
    { "@type": "ListItem", position: 3, name: guide.h1, item: canonical },
  ],
};
---

<BaseLayout
  title={guide.title}
  description={guide.metaDescription}
  canonical={canonical}
  lang="pt-BR"
  hreflang={hreflang}
>
  <Fragment slot="head">
    <link rel="alternate" hreflang="es" href={`https://gigasend.us${langPaths.esPath}`} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </Fragment>

  <main id="main-content" class="min-h-screen bg-ocean-950 text-slate-100 font-body">
    <PtHeader
      activeNav="guias"
      enHref={langPaths.enHref}
      esHref={langPaths.esHref}
      ptHref={langPaths.ptHref}
    />

    <article class="mx-auto max-w-4xl px-4 py-12 sm:px-6 lg:px-8">
      <nav aria-label="Caminho de navegação" class="text-xs text-slate-300 mb-6 flex flex-wrap items-center gap-1">
        <a href="/pt" class="inline-flex min-h-[36px] items-center px-1.5 hover:text-gold-400">Brasil</a>
        <span class="text-slate-500">/</span>
        <a href="/pt/guias" class="inline-flex min-h-[36px] items-center px-1.5 hover:text-gold-400">Guias</a>
        <span class="text-slate-500">/</span>
        <span class="text-gold-400 px-1.5" aria-current="page">{guide.primaryKeyword}</span>
      </nav>

      <div class="inline-flex items-center gap-2 rounded-full bg-gold-500/10 border border-gold-500/30 px-3.5 py-1 text-xs font-semibold text-gold-400">
        <span>{guide.eyebrow}</span>
        <span>•</span>
        <span>{guide.readTime}</span>
      </div>

      <h1 class="mt-4 text-3xl sm:text-5xl font-black text-white font-display leading-tight">
        {guide.h1}
      </h1>
      <p class="mt-5 max-w-3xl text-lg text-slate-300 leading-relaxed">
        {guide.summary}
      </p>

      <div class="mt-10 space-y-8">
        {guide.sections.map((s) => (
          <section class="apple-glass rounded-2xl p-6 sm:p-8">
            <h2 class="text-xl sm:text-2xl font-bold text-gold-400 font-display">{s.heading}</h2>
            <p class="mt-3 max-w-3xl text-sm sm:text-base text-slate-200 leading-7">{s.body}</p>
          </section>
        ))}
      </div>

      <!-- Compact CTA Callout Banner -->
      <div class="mt-12 rounded-3xl border border-gold-500/30 bg-ocean-900/80 p-6 sm:p-8 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6">
        <div class="space-y-2 max-w-xl">
          <h2 class="text-xl sm:text-2xl font-black text-white font-display">
            Envie até 10 GB grátis agora mesmo
          </h2>
          <p class="text-sm text-slate-300">
            Compartilhe arquivos e pastas de até 5 TB com servidores locais em São Paulo e Rio de Janeiro e download em 1 clique sem cadastro.
          </p>
        </div>
        <a
          href="/pt#uploader-stage"
          class="btn-gold shrink-0 inline-flex min-h-[48px] items-center justify-center rounded-xl px-6 py-3.5 text-sm font-bold shadow-xl shadow-gold-500/20 tap-tactile"
        >
          Enviar arquivos grátis →
        </a>
      </div>

      <!-- 3 Related Guides -->
      <section class="mt-14 border-t border-white/10 pt-10">
        <h2 class="text-xl font-bold text-white font-display">Outros guias práticos</h2>
        <div class="mt-5 grid gap-4 sm:grid-cols-3">
          {otherGuides.map((g) => (
            <a
              href={`/pt/guias/${g.slug}`}
              class="rounded-2xl border border-white/10 bg-ocean-900/75 p-5 hover:border-gold-500/50 transition flex flex-col justify-between tap-tactile"
            >
              <div>
                <span class="text-[11px] font-mono text-gold-400">{g.readTime}</span>
                <h3 class="mt-1 text-base font-bold text-white font-display">{g.h1}</h3>
                <p class="mt-1.5 text-xs text-slate-300 line-clamp-2">{g.summary}</p>
              </div>
              <span class="mt-4 text-xs font-bold text-gold-400">Ler guia →</span>
            </a>
          ))}
        </div>
      </section>
    </article>

    <PtFooter />
  </main>
</BaseLayout>
