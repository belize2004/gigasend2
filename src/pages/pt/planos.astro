---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PtHeader from "../../components/PtHeader.astro";
import PtFooter from "../../components/PtFooter.astro";
import { PT_CORE_VALUE_PROPOSITIONS } from "../../data/ptSeoLandingPages";
import { brand } from "@/lib/brand";
import TransferEmbed from "@/src/components/TransferEmbed";

export const prerender = true;

const canonical = `${brand.siteUrl}/pt/planos`;
const hreflang = [
  { lang: "en", href: `${brand.siteUrl}/plans` },
  { lang: "pt-BR", href: canonical },
  { lang: "x-default", href: `${brand.siteUrl}/plans` },
];

const pricingSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: `${brand.productName} Brasil — Planos Pré-Pagos Sem Assinatura Mensal`,
  applicationCategory: "BusinessApplication",
  operatingSystem: "All",
  url: canonical,
  inLanguage: "pt-BR",
  offers: {
    "@type": "AggregateOffer",
    lowPrice: "0.00",
    highPrice: "180.00",
    priceCurrency: "USD",
    offerCount: 4,
    offers: [
      {
        "@type": "Offer",
        name: "Plano Grátis (Até 25GB por Transferência)",
        price: "0.00",
        priceCurrency: "USD",
        description: "Envie até 25GB gratuitamente com download direto sem cadastro para o cliente e CDN em São Paulo e Rio.",
      },
      {
        "@type": "Offer",
        name: "Pacote Pré-Pago 50GB (Validade 12 Meses)",
        price: "10.00",
        priceCurrency: "USD",
        description: "Pacote de 50GB válido por 12 meses inteiros sem assinatura mensal.",
      },
      {
        "@type": "Offer",
        name: "Pacote Pré-Pago 100GB (Validade 12 Meses)",
        price: "20.00",
        priceCurrency: "USD",
        description: "Pacote de 100GB por $20 válido por 12 meses inteiros sem assinatura mensal.",
      },
      {
        "@type": "Offer",
        name: "Pacote Pré-Pago 1TB / 1.000GB (Validade 12 Meses)",
        price: "180.00",
        priceCurrency: "USD",
        description: "Pacote profissional de 1TB por $180 válido por 12 meses inteiros para produtoras, drones e engenharia.",
      },
    ],
  },
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Brasil (pt-BR)", item: `${brand.siteUrl}/pt` },
    { "@type": "ListItem", position: 2, name: "Planos Pré-Pagos", item: canonical },
  ],
};

const plans = [
  {
    name: "Grátis (Avaliação Real)",
    price: "$0",
    period: "Sem cartão • Imediato",
    capacity: "Até 25 GB",
    badge: "12,5x Maior que o WeTransfer Grátis",
    highlight: false,
    ctaText: "Começar Grátis (Até 25GB)",
    ctaHref: "/transfer",
    features: [
      "Envie arquivos ou pastas de até 25 GB grátis",
      "Zero Cadastro para o Cliente baixar (1 clique)",
      "Servidores CDN locais em São Paulo (GRU) e Rio (GIG)",
      "Retomada automática contra quedas (Claro, Vivo, Starlink)",
      "Validação de integridade SHA-256 bit a bit",
    ],
  },
  {
    name: "Pacote 50 GB",
    price: "$10",
    period: "Pagamento único • Válido por 12 meses",
    capacity: "50 GB de Transferência",
    badge: "Sem Assinatura Mensal",
    highlight: false,
    ctaText: "Ativar Pacote de 50 GB ($10)",
    ctaHref: "/plans",
    features: [
      "Transfira até 50 GB em um único link ou vários envios",
      "Créditos válidos por 12 meses inteiros (não expiram no fim do mês)",
      "Zero Cadastro para o Cliente (download direto sem login)",
      "CDN de alta velocidade em São Paulo e Rio de Janeiro",
      "Ideal para projetos pontuais de vídeo 4K, BIM e topografia",
    ],
  },
  {
    name: "Pacote 100 GB",
    price: "$20",
    period: "Pagamento único • Válido por 12 meses",
    capacity: "100 GB de Transferência",
    badge: "Mais Popular no Brasil",
    highlight: true,
    ctaText: "Ativar Pacote de 100 GB ($20)",
    ctaHref: "/plans",
    features: [
      "Apenas $0,20 por GB (20% mais barato que o MASV)",
      "Sem cobrança extra quando vários clientes baixam o mesmo link",
      "Validade de 12 meses inteiros — zero mensalidade recorrente",
      "Zero Cadastro para o Cliente + página limpa corporativa",
      "Perfeito para produtoras audiovisuais, drones ANAC e agências",
    ],
  },
  {
    name: "Pacote Pro 1 TB",
    price: "$180",
    period: "Pagamento único • Válido por 12 meses",
    capacity: "1 TB (1.024 GB)",
    badge: "Melhor Custo por GB ($0,18/GB)",
    highlight: false,
    ctaText: "Ativar Pacote de 1 TB ($180)",
    ctaHref: "/plans",
    features: [
      "Transfira pacotes massivos de 100GB, 250GB ou 500GB+ num único link",
      "Substitui o envio de HDs externos e SSDs via Sedex/Motoboy",
      "Validade de 12 meses inteiros para usar conforme a demanda de obras/voos",
      "Aceleração máxima HTTP/3 nos nós de São Paulo (GRU) e Rio (GIG)",
      "Suporte prioritário para fluxos RAW, LiDAR, DCP e bancos SQL",
    ],
  },
];
---

<BaseLayout
  title={`Planos Pré-Pagos ($20/100GB • $180/1TB) | ${brand.productName} Brasil`}
  description="Pague apenas pelo que enviar no Brasil: até 25GB grátis ou pacotes de 12 meses ($10/50GB, $20/100GB, $180/1TB). Zero cadastro para o cliente e CDN SP/RJ."
  canonical={canonical}
  lang="pt-BR"
  hreflang={hreflang}
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(pricingSchema)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </Fragment>

  <main class="min-h-screen bg-ocean-950 text-slate-100 font-body">
    <PtHeader activeNav="planos" enHref="/plans?lang=en" ptHref="/pt/planos?lang=pt" />

    <section class="mx-auto max-w-7xl px-4 py-14 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto">
        <span class="inline-flex items-center gap-2 rounded-full bg-gold-500/10 border border-gold-500/30 px-3.5 py-1 text-xs font-semibold uppercase tracking-wider text-gold-400">
          🇧🇷 Pague Pelo Que Enviar • Zero Assinatura Mensal
        </span>
        <h1 class="mt-4 text-3xl sm:text-5xl font-black text-white font-display tracking-tight">
          Chega de Pagar Mensalidades em Meses Sem Gravações ou Obras.
        </h1>
        <p class="mt-4 text-base sm:text-lg text-slate-300 leading-relaxed">
          Comece enviando <strong>até 25 GB grátis</strong>. Quando precisar transferir 50GB, 100GB ou 500GB+, ative um pacote pré-pago com <strong>validade de 12 meses inteiros</strong> e <strong>Zero Cadastro para o Cliente</strong>.
        </p>
      </div>

      <div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
        {plans.map((p) => (
          <div class={`rounded-3xl p-6 flex flex-col justify-between border ${p.highlight ? "border-gold-400 bg-ocean-900/95 shadow-2xl shadow-gold-500/15" : "border-white/10 bg-ocean-900/70"}`}>
            <div>
              <span class="inline-block rounded-md bg-gold-500/15 border border-gold-500/30 px-2.5 py-0.5 text-[11px] font-mono font-semibold text-gold-300">
                {p.badge}
              </span>
              <h2 class="mt-4 text-xl font-bold text-white font-display">{p.name}</h2>
              <div class="mt-3 flex items-baseline gap-2">
                <span class="text-4xl font-black text-gold-400 font-display tabular-nums">{p.price}</span>
                <span class="text-xs text-slate-300">{p.period}</span>
              </div>
              <p class="mt-2 text-sm font-semibold text-emerald-400">{p.capacity}</p>
              <ul class="mt-6 space-y-3 text-xs text-slate-300">
                {p.features.map((f) => (
                  <li class="flex items-start gap-2">
                    <span class="text-gold-400 font-bold">✓</span>
                    <span>{f}</span>
                  </li>
                ))}
              </ul>
            </div>
            <a
              href={p.ctaHref}
              class={`mt-8 inline-flex min-h-[44px] w-full items-center justify-center rounded-xl px-4 py-3 text-xs font-bold transition tap-tactile ${p.highlight ? "btn-gold shadow-lg shadow-gold-500/20" : "btn-outline-gold"}`}
            >
              {p.ctaText}
            </a>
          </div>
        ))}
      </div>

      <div class="mt-14 grid gap-6 lg:grid-cols-4">
        {PT_CORE_VALUE_PROPOSITIONS.map((prop) => (
          <div class="apple-glass rounded-2xl p-6">
            <span class="inline-block rounded-md bg-gold-500/15 border border-gold-500/30 px-2 py-0.5 text-[11px] font-mono font-semibold text-gold-300">
              {prop.badge}
            </span>
            <h3 class="mt-2 text-base font-bold text-gold-400 font-display">{prop.title}</h3>
            <p class="mt-2 text-xs leading-relaxed text-slate-300">{prop.description}</p>
          </div>
        ))}
      </div>

      <div class="mt-14 rounded-3xl border border-gold-500/30 bg-ocean-900/80 p-6 sm:p-10">
        <div class="grid gap-8 lg:grid-cols-[1fr_1fr] items-center">
          <div>
            <h2 class="text-2xl sm:text-3xl font-black text-white font-display">
              Teste Agora Mesmo: Envie Até 25 GB Grátis Direto do Navegador
            </h2>
            <p class="mt-3 text-sm text-slate-300 leading-relaxed">
              Sem cartão de crédito e sem obrigar seu cliente a criar conta. Conectado diretamente aos servidores CDN de São Paulo (GRU) e Rio de Janeiro (GIG).
            </p>
            <div class="mt-6 flex flex-wrap gap-3 text-xs">
              <a href="/pt/comparar" class="inline-flex min-h-[44px] items-center rounded-xl border border-white/15 bg-ocean-950 px-4 py-2 text-gold-400 hover:border-gold-400 font-semibold tap-tactile">
                Ver Comparativo vs WeTransfer/Drive/MASV →
              </a>
              <a href="/pt/calculadora-tempo-upload" class="inline-flex min-h-[44px] items-center rounded-xl border border-white/15 bg-ocean-950 px-4 py-2 text-slate-200 hover:border-gold-400 hover:text-gold-400 tap-tactile">
                Calcular Tempo de Upload na Fibra →
              </a>
            </div>
          </div>
          <div class="rounded-2xl border border-white/10 bg-ocean-950/90 p-4">
            <TransferEmbed client:load />
          </div>
        </div>
      </div>
    </section>

    <PtFooter />
  </main>
</BaseLayout>
