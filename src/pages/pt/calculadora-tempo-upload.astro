---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PtHeader from "../../components/PtHeader.astro";
import PtFooter from "../../components/PtFooter.astro";
import { getLanguageSwitchPaths } from "../../data/languageSwitchPaths";
import { brand } from "@/lib/brand";

export const prerender = true;

const langPaths = getLanguageSwitchPaths("/pt/calculadora-tempo-upload");
const canonical = `${brand.siteUrl}/pt/calculadora-tempo-upload`;
const hreflang = [
  { lang: "en", href: `${brand.siteUrl}/tools/transfer-speed-calculator` },
  { lang: "pt-BR", href: canonical },
  { lang: "x-default", href: `${brand.siteUrl}/tools/transfer-speed-calculator` },
];

const faqs = [
  {
    question: "Como é calculado o tempo estimado de upload?",
    answer:
      "Multiplicamos o tamanho do arquivo em gigabytes por 8.192 megabits e dividimos pela velocidade efetiva da sua conexão de fibra ou satélite usando nossos servidores locais em São Paulo e Rio de Janeiro.",
  },
  {
    question: "O que acontece se a minha internet oscilar durante um envio grande?",
    answer:
      "O Gigasend envia seus arquivos em partes independentes com retomada automática no navegador. Se a conexão cair, o envio continua exatamente de onde parou sem reiniciar do zero.",
  },
  {
    question: "Quanto custa enviar arquivos maiores que 10 GB?",
    answer:
      "Você envia até 10 GB grátis (retenção de 3 dias). Para arquivos maiores, pode escolher planos mensais a partir de US$ 10/mês (30 GB) ou pacotes pré-pagos válidos por 12 meses: 50 GB (US$ 10), 100 GB (US$ 20), 1 TB (US$ 180) ou 5 TB (US$ 800).",
  },
];

const calcSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: `${brand.productName} Brasil — Calculadora de tempo de upload`,
  applicationCategory: "UtilitiesApplication",
  operatingSystem: "All",
  url: canonical,
  inLanguage: "pt-BR",
  description:
    "Calcule o tempo estimado para enviar arquivos de 5 GB, 10 GB, 50 GB, 100 GB, 500 GB e 1 TB nas operadoras brasileiras.",
  offers: {
    "@type": "Offer",
    price: "0.00",
    priceCurrency: "USD",
  },
};
---

<BaseLayout
  title={`Calculadora de tempo de upload no Brasil | ${brand.productName}`}
  description="Calcule o tempo estimado para enviar arquivos de 5 GB, 10 GB, 50 GB, 100 GB, 500 GB e 1 TB na Claro Fibra, Vivo Fibra, Oi e Starlink."
  canonical={canonical}
  lang="pt-BR"
  hreflang={hreflang}
>
  <Fragment slot="head">
    <link rel="alternate" hreflang="es" href={`https://gigasend.us${langPaths.esPath}`} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(calcSchema)} />
  </Fragment>

  <main id="main-content" class="min-h-screen bg-ocean-950 text-slate-100 font-body">
    <PtHeader activeNav="calculadora" enHref={langPaths.enHref} esHref={langPaths.esHref} ptHref={langPaths.ptHref} />

    <section class="mx-auto max-w-6xl px-4 py-14 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <span class="inline-flex items-center gap-2 rounded-full bg-gold-500/10 border border-gold-500/30 px-3.5 py-1 text-xs font-semibold text-gold-400">
          ⚡ Simulador de tempo e custo de transferência
        </span>
        <h1 class="mt-4 text-3xl sm:text-5xl font-black text-white font-display tracking-tight">
          Calculadora de tempo de upload
        </h1>
        <p class="mt-4 text-base sm:text-lg text-slate-300 leading-relaxed">
          Descubra quanto tempo leva para transferir seus vídeos 4K, pastas de fotos ou projetos pesados usando nossos servidores locais de alta velocidade em São Paulo e Rio de Janeiro.
        </p>
      </div>

      <!-- Interactive Calculator -->
      <div class="mt-10 grid gap-8 lg:grid-cols-[1.05fr_0.95fr] rounded-3xl border border-gold-500/30 bg-ocean-900/80 p-6 sm:p-8 shadow-2xl">
        <div class="space-y-6">
          <div>
            <label for="calc-size-gb" class="block text-xs font-mono text-gold-400">
              1. Tamanho total do arquivo ou pasta: <span id="size-val" class="text-white font-bold tabular-nums">50 GB</span>
            </label>
            <input
              id="calc-size-gb"
              type="range"
              min="1"
              max="1000"
              value="50"
              aria-label="Tamanho total do arquivo ou pasta em gigabytes"
              class="mt-3 h-7 w-full accent-amber-400 cursor-pointer touch-pan-y"
            />
            <div class="mt-2 grid grid-cols-3 sm:grid-cols-6 gap-2">
              <button type="button" data-size="5" aria-pressed="false" class="preset-size tap-tactile min-h-[40px] rounded-xl border border-white/15 bg-ocean-950 px-2.5 py-1.5 text-xs font-mono text-slate-300 hover:border-gold-400 transition">5 GB</button>
              <button type="button" data-size="10" aria-pressed="false" class="preset-size tap-tactile min-h-[40px] rounded-xl border border-white/15 bg-ocean-950 px-2.5 py-1.5 text-xs font-mono text-slate-300 hover:border-gold-400 transition">10 GB</button>
              <button type="button" data-size="50" aria-pressed="true" class="preset-size tap-tactile min-h-[40px] rounded-xl border border-gold-400 bg-gold-500/15 px-2.5 py-1.5 text-xs font-mono font-bold text-gold-300 transition">50 GB</button>
              <button type="button" data-size="100" aria-pressed="false" class="preset-size tap-tactile min-h-[40px] rounded-xl border border-white/15 bg-ocean-950 px-2.5 py-1.5 text-xs font-mono text-slate-300 hover:border-gold-400 transition">100 GB</button>
              <button type="button" data-size="500" aria-pressed="false" class="preset-size tap-tactile min-h-[40px] rounded-xl border border-white/15 bg-ocean-950 px-2.5 py-1.5 text-xs font-mono text-slate-300 hover:border-gold-400 transition">500 GB</button>
              <button type="button" data-size="1000" aria-pressed="false" class="preset-size tap-tactile min-h-[40px] rounded-xl border border-white/15 bg-ocean-950 px-2.5 py-1.5 text-xs font-mono text-slate-300 hover:border-gold-400 transition">1 TB</button>
            </div>
          </div>

          <div>
            <label for="calc-speed-mbps" class="block text-xs font-mono text-gold-400">
              2. Velocidade de upload da internet: <span id="speed-val" class="text-white font-bold tabular-nums">300 Mbps</span>
            </label>
            <input
              id="calc-speed-mbps"
              type="range"
              min="20"
              max="1000"
              step="10"
              value="300"
              aria-label="Velocidade de upload da operadora em megabits por segundo"
              class="mt-3 h-7 w-full accent-amber-400 cursor-pointer touch-pan-y"
            />
            <div class="mt-3 grid grid-cols-1 sm:grid-cols-2 gap-2.5">
              <button type="button" data-speed="100" aria-pressed="false" class="preset-speed tap-tactile min-h-[44px] rounded-xl border border-white/15 bg-ocean-950 px-3.5 py-2.5 text-left text-xs text-slate-300 hover:border-gold-400 transition">Starlink / 100 Mbps</button>
              <button type="button" data-speed="300" aria-pressed="true" class="preset-speed tap-tactile min-h-[44px] rounded-xl border border-gold-400 bg-gold-500/15 px-3.5 py-2.5 text-left text-xs font-bold text-gold-300 transition">Vivo / Claro Fibra (300 Mbps)</button>
              <button type="button" data-speed="600" aria-pressed="false" class="preset-speed tap-tactile min-h-[44px] rounded-xl border border-white/15 bg-ocean-950 px-3.5 py-2.5 text-left text-xs text-slate-300 hover:border-gold-400 transition">Fibra 600 Mbps</button>
              <button type="button" data-speed="1000" aria-pressed="false" class="preset-speed tap-tactile min-h-[44px] rounded-xl border border-white/15 bg-ocean-950 px-3.5 py-2.5 text-left text-xs text-slate-300 hover:border-gold-400 transition">Fibra 1 Gbps</button>
            </div>
          </div>
        </div>

        <div class="rounded-2xl border border-white/10 bg-ocean-950/90 p-6 flex flex-col justify-between" aria-live="polite">
          <div>
            <span class="text-[11px] font-mono text-emerald-400">Estimativa de envio</span>
            <div class="mt-3 grid grid-cols-2 gap-4">
              <div class="rounded-xl border border-white/10 bg-ocean-900/70 p-4">
                <div class="text-xs text-slate-300">Com {brand.productName}</div>
                <div id="res-giga-time" class="mt-1 text-2xl sm:text-3xl font-black text-emerald-400 font-display tabular-nums">~22 min</div>
              </div>
              <div class="rounded-xl border border-white/10 bg-ocean-900/70 p-4">
                <div class="text-xs text-slate-300">Nuvem comum</div>
                <div id="res-cloud-time" class="mt-1 text-2xl sm:text-3xl font-black text-rose-300 font-display tabular-nums">~58 min</div>
              </div>
            </div>
            <div class="mt-4 rounded-xl border border-gold-500/30 bg-gold-500/10 p-4">
              <div class="text-xs text-gold-300 font-mono">Opção recomendada:</div>
              <div id="res-plan" class="mt-1 text-base font-bold text-white">Pacote Starter 50 GB (US$ 10 • Válido por 12 meses)</div>
            </div>
          </div>
          <a href="/pt#uploader-stage" class="mt-6 btn-gold inline-flex min-h-[48px] w-full items-center justify-center rounded-xl px-5 py-3.5 text-xs font-bold tap-tactile">
            Enviar arquivos agora (até 10 GB grátis)
          </a>
        </div>
      </div>

      <!-- 3 Concise Benefit Cards -->
      <div class="mt-14 grid gap-6 sm:grid-cols-3">
        <div class="apple-glass rounded-2xl p-6">
          <h2 class="text-lg font-bold text-white font-display">Servidores locais no Brasil</h2>
          <p class="mt-2 text-sm text-slate-300 leading-relaxed">
            Seus arquivos são recebidos diretamente em São Paulo e Rio de Janeiro para aproveitar toda a velocidade da sua fibra.
          </p>
        </div>
        <div class="apple-glass rounded-2xl p-6">
          <h2 class="text-lg font-bold text-white font-display">Retomada automática</h2>
          <p class="mt-2 text-sm text-slate-300 leading-relaxed">
            Se a conexão oscilar no Wi-Fi ou na Starlink, o envio continua exatamente de onde parou sem perder o progresso.
          </p>
        </div>
        <div class="apple-glass rounded-2xl p-6">
          <h2 class="text-lg font-bold text-white font-display">Download sem cadastro</h2>
          <p class="mt-2 text-sm text-slate-300 leading-relaxed">
            Seu destinatário não precisa criar conta nem instalar aplicativos: basta um clique para baixar o arquivo original.
          </p>
        </div>
      </div>

      <!-- 3 FAQs -->
      <div class="mt-16 max-w-3xl">
        <h2 class="text-2xl font-bold text-white font-display mb-6">Perguntas frequentes</h2>
        <div class="space-y-4">
          {faqs.map((faq, idx) => (
            <details open={idx === 0} class="apple-glass rounded-2xl p-5 group">
              <summary class="flex min-h-[40px] cursor-pointer list-none items-center justify-between gap-4 font-semibold text-white font-display">
                <span>{faq.question}</span>
                <span class="text-gold-400 transition-transform group-open:rotate-180">▼</span>
              </summary>
              <p class="mt-3 border-t border-white/10 pt-3 text-sm text-slate-300 leading-relaxed">{faq.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <PtFooter />
  </main>

  <script is:inline>
    (function () {
      const sizeInput = document.getElementById("calc-size-gb");
      const speedInput = document.getElementById("calc-speed-mbps");
      const sizeVal = document.getElementById("size-val");
      const speedVal = document.getElementById("speed-val");
      const gigaTime = document.getElementById("res-giga-time");
      const cloudTime = document.getElementById("res-cloud-time");
      const resPlan = document.getElementById("res-plan");
      const speedPresets = document.querySelectorAll(".preset-speed");
      const sizePresets = document.querySelectorAll(".preset-size");

      function fmtSeconds(sec) {
        if (sec < 60) return "~" + Math.max(5, Math.round(sec)) + " seg";
        const mins = Math.round(sec / 60);
        if (mins < 60) return "~" + mins + " min";
        const h = Math.floor(mins / 60);
        const m = mins % 60;
        return "~" + h + "h " + (m > 0 ? m + "m" : "");
      }

      function syncPillHighlight(buttons, attrName, activeValue) {
        buttons.forEach((btn) => {
          const isMatch = Number(btn.getAttribute(attrName)) === activeValue;
          btn.setAttribute("aria-pressed", isMatch ? "true" : "false");
          btn.classList.toggle("border-gold-400", isMatch);
          btn.classList.toggle("bg-gold-500/15", isMatch);
          btn.classList.toggle("text-gold-300", isMatch);
          btn.classList.toggle("font-bold", isMatch);
          btn.classList.toggle("border-white/15", !isMatch);
          btn.classList.toggle("bg-ocean-950", !isMatch);
          btn.classList.toggle("text-slate-300", !isMatch);
        });
      }

      function update() {
        const gb = Number(sizeInput.value || 50);
        const mbps = Number(speedInput.value || 300);
        sizeVal.textContent = gb === 1000 ? "1 TB (1.000 GB)" : gb + " GB";
        speedVal.textContent = mbps + " Mbps";

        syncPillHighlight(sizePresets, "data-size", gb);
        syncPillHighlight(speedPresets, "data-speed", mbps);

        const megabits = gb * 8192;
        const gigaSec = megabits / (mbps * 0.9);
        const cloudSec = megabits / (mbps * 0.35);

        gigaTime.textContent = fmtSeconds(gigaSec);
        cloudTime.textContent = fmtSeconds(cloudSec);

        if (gb <= 10) {
          resPlan.textContent = "Grátis (até 10 GB por envio • Retenção de 3 dias)";
        } else if (gb <= 50) {
          resPlan.textContent = "Pacote Starter 50 GB (US$ 10 • Válido por 12 meses)";
        } else if (gb <= 100) {
          resPlan.textContent = "Pacote Creator 100 GB (US$ 20 • Válido por 12 meses)";
        } else {
          resPlan.textContent = "Pacote Studio 1 TB (US$ 180 • Válido por 12 meses)";
        }
      }

      if (sizeInput && speedInput) {
        sizeInput.addEventListener("input", update);
        speedInput.addEventListener("input", update);
        speedPresets.forEach((btn) => {
          btn.addEventListener("click", () => {
            speedInput.value = btn.getAttribute("data-speed") || "300";
            update();
          });
        });
        sizePresets.forEach((btn) => {
          btn.addEventListener("click", () => {
            sizeInput.value = btn.getAttribute("data-size") || "50";
            update();
          });
        });
        update();
      }
    })();
  </script>
</BaseLayout>
