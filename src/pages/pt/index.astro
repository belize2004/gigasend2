---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PtHeader from "../../components/PtHeader.astro";
import PtFooter from "../../components/PtFooter.astro";
import {
  ptSeoLandingPages,
  PT_CORE_VALUE_PROPOSITIONS,
  PT_CLUSTER_METADATA,
} from "../../data/ptSeoLandingPages";
import { PT_ENGINEERING_GUIDES } from "../../data/ptGuides";
import { brand } from "@/lib/brand";
import TransferEmbed from "@/src/components/TransferEmbed";

export const prerender = true;

const canonical = `${brand.siteUrl}/pt`;
const hreflang = [
  { lang: "en", href: `${brand.siteUrl}/` },
  { lang: "pt-BR", href: canonical },
  { lang: "x-default", href: `${brand.siteUrl}/` },
];

const clusters = PT_CLUSTER_METADATA.map((meta) => ({
  ...meta,
  pages: ptSeoLandingPages.filter((p) => p.cluster === meta.id),
}));

const collectionSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: `${brand.productName} Brasil — Central de Transferência de Arquivos Pesados (${ptSeoLandingPages.length} Soluções)`,
  description:
    "Envie arquivos pesados de até 25GB grátis ou 50GB–500GB+ no Brasil sem cadastro para o cliente. Pacotes de 12 meses ($20/100GB • $180/1TB) e CDN SP/RJ.",
  url: canonical,
  inLanguage: "pt-BR",
  hasPart: [
    ...PT_ENGINEERING_GUIDES.map((g) => ({
      "@type": "TechArticle",
      headline: g.h1,
      url: `${brand.siteUrl}/pt/guias/${g.slug}`,
    })),
    ...ptSeoLandingPages.map((p) => ({
      "@type": "WebPage",
      name: p.h1,
      url: `${brand.siteUrl}/pt/${p.slug}`,
    })),
  ],
};
---

<BaseLayout
  title={`Enviar Arquivos Pesados no Brasil (Até 25GB Grátis) | ${brand.productName}`}
  description="Transfira 50GB, 100GB ou 500GB num único link no Brasil (até 25GB grátis). Zero cadastro para o cliente, CDN SP/RJ e pacotes de 12 meses ($20/100GB • $180/1TB)."
  canonical={canonical}
  lang="pt-BR"
  hreflang={hreflang}
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(collectionSchema)} />
  </Fragment>

  <main class="min-h-screen bg-ocean-950 text-slate-100 font-body">
    <PtHeader activeNav="hub" enHref="/?lang=en" ptHref="/pt?lang=pt" />

    <section class="relative bg-gradient-to-b from-ocean-950 via-ocean-900 to-ocean-950 border-b border-white/10">
      <div class="mx-auto grid max-w-7xl gap-10 px-4 py-14 sm:px-6 lg:grid-cols-[1.1fr_0.9fr] lg:px-8 lg:py-20">
        <div>
          <div class="mb-4 inline-flex items-center gap-2 rounded-full bg-gold-500/10 border border-gold-500/30 px-3.5 py-1.5 text-xs font-semibold uppercase tracking-wider text-gold-400 label-caps">
            <span>🇧🇷</span>
            <span>CDN Local São Paulo & Rio de Janeiro • Sem Timeouts (Claro, Vivo, Starlink)</span>
          </div>
          <h1 class="max-w-4xl text-4xl font-black leading-tight text-white font-display tracking-tight sm:text-5xl">
            Transferência de Arquivos Pesados no <span class="text-gold-400">Brasil.</span>
          </h1>
          <p class="mt-6 max-w-3xl text-lg leading-8 text-slate-300">
            Transfira <strong>50GB, 100GB ou 500GB em um único link seguro</strong> (com até <strong>25 GB grátis</strong>) e <strong>Zero Cadastro para o Cliente</strong>: o cliente clica no link e o download começa direto na velocidade máxima, sem exigir login ou criação de conta. Pacotes pré-pagos (<strong>$20 por 100GB / $180 por 1TB</strong>) válidos por 12 meses inteiros — chega de pagar mensalidades em meses sem gravações.
          </p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row">
            <a href="/transfer" class="btn-gold inline-flex min-h-[48px] items-center justify-center rounded-xl px-6 py-3.5 text-sm font-bold shadow-xl shadow-gold-500/20 tap-tactile">
              Enviar Arquivos Agora (Até 25 GB Grátis)
            </a>
            <a href="/pt/planos" class="btn-outline-gold inline-flex min-h-[48px] items-center justify-center rounded-xl px-6 py-3.5 text-sm font-bold tap-tactile">
              Pacotes Pré-Pagos ($20 / 100GB • $180 / 1TB)
            </a>
          </div>
          <div class="mt-8 grid max-w-2xl grid-cols-2 sm:grid-cols-4 gap-3 text-center text-sm">
            <div class="apple-glass rounded-xl p-3.5">
              <div class="text-lg font-black text-gold-400 font-display">Zero Login</div>
              <div class="mt-1 text-[11px] text-slate-300">Download direto p/ cliente</div>
            </div>
            <div class="apple-glass rounded-xl p-3.5">
              <div class="text-lg font-black text-gold-400 font-display">$20 / 100GB</div>
              <div class="mt-1 text-[11px] text-slate-300">$180 / 1TB (12 meses)</div>
            </div>
            <div class="apple-glass rounded-xl p-3.5">
              <div class="text-lg font-black text-gold-400 font-display">SP & RJ</div>
              <div class="mt-1 text-[11px] text-slate-300">CDN na borda sem timeout</div>
            </div>
            <div class="apple-glass rounded-xl p-3.5">
              <div class="text-lg font-black text-gold-400 font-display">500 GB+</div>
              <div class="mt-1 text-[11px] text-slate-300">Em um único link seguro</div>
            </div>
          </div>

          <div class="mt-8">
            <p class="text-[11px] font-mono uppercase tracking-wider text-slate-300 mb-2.5">
              Navegue pelos 6 Clusters de Transferência ({ptSeoLandingPages.length} Fluxos Dedicados):
            </p>
            <div class="flex flex-wrap gap-2">
              {clusters.map((cluster) => (
                <a
                  href={`#cluster-${cluster.id}`}
                  class="inline-flex min-h-[44px] items-center gap-2 rounded-xl border border-white/10 bg-ocean-900/85 px-3.5 py-2 text-xs font-mono text-slate-200 hover:border-gold-500/50 hover:text-gold-400 transition tap-tactile"
                >
                  <span>{cluster.icon}</span>
                  <span>{cluster.shortLabel}</span>
                  <span class="rounded bg-ocean-950 px-1.5 py-0.5 text-[11px] text-gold-400">{cluster.pages.length}</span>
                </a>
              ))}
            </div>
          </div>
        </div>

        <div class="flex flex-col gap-6">
          <TransferEmbed client:load />
        </div>
      </div>
    </section>

    <section class="border-b border-white/10 bg-ocean-900/50 py-14">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl">
          <span class="label-caps text-gold-400 text-xs">Por Que Produtoras e Engenheiros no Brasil Escolhem o {brand.productName}</span>
          <h2 class="mt-1 text-2xl sm:text-3xl font-black text-white font-display">
            4 Diferenciais de Borda para Entregas Pesadas no Brasil
          </h2>
        </div>
        <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
          {PT_CORE_VALUE_PROPOSITIONS.map((prop) => (
            <div class="apple-glass rounded-2xl p-6">
              <span class="inline-block rounded-full bg-gold-500/10 border border-gold-500/30 px-2.5 py-0.5 text-[11px] font-mono uppercase tracking-wider text-gold-400">
                {prop.badge}
              </span>
              <h3 class="mt-3 text-base font-bold text-white font-display">{prop.title}</h3>
              <p class="mt-2 text-xs leading-relaxed text-slate-300">{prop.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8 space-y-16">
      {clusters.map((cluster) => (
        <div id={`cluster-${cluster.id}`} class="space-y-6 scroll-mt-28">
          <div class="border-b border-white/10 pb-4 flex flex-col sm:flex-row sm:items-end sm:justify-between gap-3">
            <div>
              <div class="flex items-center gap-3">
                <span class="text-2xl">{cluster.icon}</span>
                <h2 class="text-2xl sm:text-3xl font-black text-white font-display">{cluster.title}</h2>
              </div>
              <p class="mt-2 max-w-3xl text-sm text-slate-300 leading-relaxed">{cluster.description}</p>
            </div>
            <span class="inline-flex items-center self-start sm:self-auto rounded-full bg-gold-500/10 border border-gold-500/30 px-3 py-1 text-xs font-mono text-gold-400">
              {cluster.pages.length} páginas especializadas
            </span>
          </div>

          <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
            {cluster.pages.slice(0, 8).map((page) => (
              <a
                href={`/pt/${page.slug}`}
                class="group flex flex-col justify-between rounded-2xl border border-white/10 bg-ocean-900/85 p-6 shadow-[inset_0_1px_0_0_rgba(255,255,255,0.1)] transition hover:border-gold-500/50 hover:bg-ocean-900 tap-tactile"
              >
                <div>
                  <span class="inline-block rounded-full bg-gold-500/10 border border-gold-500/20 px-2.5 py-0.5 text-[11px] font-mono uppercase tracking-wider text-gold-400">
                    {page.primaryKeyword}
                  </span>
                  <h3 class="mt-3 text-base font-bold text-white group-hover:text-gold-400 font-display transition-colors">
                    {page.h1}
                  </h3>
                  <p class="mt-2 text-xs text-slate-300 leading-relaxed line-clamp-3">
                    {page.intro}
                  </p>
                </div>
                <div class="mt-5 flex items-center justify-between border-t border-white/10 pt-3 text-xs font-semibold text-gold-400">
                  <span>Acessar solução</span>
                  <span class="group-hover:translate-x-1 transition-transform" aria-hidden="true">→</span>
                </div>
              </a>
            ))}
          </div>

          {cluster.pages.length > 8 && (
            <details class="group rounded-2xl border border-white/10 bg-ocean-900/50 p-4">
              <summary class="flex min-h-[44px] cursor-pointer list-none items-center justify-between px-2 text-xs font-bold uppercase tracking-wider text-gold-400 hover:text-gold-300 tap-tactile">
                <span>Explorar mais {cluster.pages.length - 8} soluções especializadas em {cluster.shortLabel}</span>
                <span class="transition-transform duration-200 group-open:rotate-180" aria-hidden="true">▼</span>
              </summary>
              <div class="mt-4 grid gap-4 border-t border-white/10 pt-4 sm:grid-cols-2 lg:grid-cols-4">
                {cluster.pages.slice(8).map((page) => (
                  <a
                    href={`/pt/${page.slug}`}
                    class="group flex flex-col justify-between rounded-xl border border-white/10 bg-ocean-900/80 p-4 transition hover:border-gold-500/50 hover:bg-ocean-900 tap-tactile"
                  >
                    <div>
                      <span class="text-[11px] font-mono uppercase tracking-wider text-gold-400">{page.primaryKeyword}</span>
                      <h3 class="mt-1.5 text-sm font-bold text-white group-hover:text-gold-400 font-display transition-colors">
                        {page.h1}
                      </h3>
                    </div>
                    <span class="mt-3 text-xs font-semibold text-gold-400">Acessar solução →</span>
                  </a>
                ))}
              </div>
            </details>
          )}
        </div>
      ))}
    </section>

    <section class="border-t border-white/10 bg-ocean-900/40 py-16">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4">
          <div>
            <span class="label-caps text-gold-400 text-xs">Biblioteca de Engenharia & Redes no Brasil</span>
            <h2 class="mt-1 text-2xl sm:text-3xl font-black text-white font-display">
              Guias Técnicos de Transferência de Arquivos Pesados
            </h2>
          </div>
          <a href="/pt/guias" class="inline-flex min-h-[44px] items-center text-xs font-bold text-gold-400 hover:underline">
            Ver todos os 5 guias técnicos →
          </a>
        </div>
        <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-5">
          {PT_ENGINEERING_GUIDES.map((guide) => (
            <a
              href={`/pt/guias/${guide.slug}`}
              class="group flex flex-col justify-between rounded-2xl border border-white/10 bg-ocean-900/85 p-5 transition hover:border-gold-500/50 tap-tactile"
            >
              <div>
                <span class="text-[11px] font-mono text-gold-400">{guide.readTime}</span>
                <h3 class="mt-2 text-sm font-bold text-white group-hover:text-gold-400 font-display leading-snug">
                  {guide.h1}
                </h3>
              </div>
              <span class="mt-4 text-xs font-bold text-gold-400">Ler guia →</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <PtFooter />
  </main>
</BaseLayout>
