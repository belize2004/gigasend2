---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PtHeader from "../../components/PtHeader.astro";
import PtFooter from "../../components/PtFooter.astro";
import {
  ptSeoLandingPages,
  PT_CORE_VALUE_PROPOSITIONS,
  PT_CLUSTER_METADATA,
} from "../../data/ptSeoLandingPages";
import { PT_ENGINEERING_GUIDES } from "../../data/ptGuides";
import { getLanguageSwitchPaths } from "../../data/languageSwitchPaths";
import { brand } from "@/lib/brand";
import TransferEmbed from "@/src/components/TransferEmbed";

export const prerender = true;

const langPaths = getLanguageSwitchPaths("/pt");
const canonical = `${brand.siteUrl}/pt`;
const hreflang = [
  { lang: "en", href: `${brand.siteUrl}/` },
  { lang: "pt-BR", href: canonical },
  { lang: "x-default", href: `${brand.siteUrl}/` },
];

const clusters = PT_CLUSTER_METADATA.map((meta) => ({
  ...meta,
  pages: ptSeoLandingPages.filter((p) => p.cluster === meta.id),
}));

const collectionSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: `${brand.productName} Brasil — Transferência de arquivos grandes`,
  description:
    "Compartilhe vídeos 4K, pastas pesadas e projetos criativos de até 5 TB sem compressão. Seus primeiros 10 GB são grátis (retenção de 3 dias) e o destinatário baixa sem cadastro.",
  url: canonical,
  inLanguage: "pt-BR",
};
---

<BaseLayout
  title={`Enviar arquivos pesados no Brasil (até 10 GB grátis) | ${brand.productName}`}
  description="Compartilhe vídeos 4K, pastas pesadas e projetos criativos de até 5 TB sem compressão. Seus primeiros 10 GB são grátis (retenção de 3 dias) e o destinatário baixa sem cadastro."
  canonical={canonical}
  lang="pt-BR"
  hreflang={hreflang}
>
  <Fragment slot="head">
    <link rel="alternate" hreflang="es" href={`https://gigasend.us${langPaths.esPath}`} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(collectionSchema)} />
  </Fragment>

  <main id="main-content" class="min-h-screen bg-ocean-950 text-slate-100 font-body">
    <PtHeader activeNav="hub" enHref={langPaths.enHref} esHref={langPaths.esHref} ptHref={langPaths.ptHref} />

    <!-- Hero + Immediate Uploader -->
    <section class="relative bg-gradient-to-b from-ocean-950 via-ocean-900 to-ocean-950 border-b border-white/10">
      <div class="mx-auto grid max-w-7xl gap-10 px-4 py-14 sm:px-6 lg:grid-cols-[1.05fr_0.95fr] lg:px-8 lg:py-20 items-center">
        <div>
          <div class="mb-4 inline-flex items-center gap-2 rounded-full bg-gold-500/10 border border-gold-500/30 px-3.5 py-1.5 text-xs font-semibold text-gold-400">
            <span>🇧🇷</span>
            <span>Até 10 GB grátis • Retenção de 3 dias • Download sem cadastro</span>
          </div>
          <h1 class="max-w-4xl text-4xl font-black leading-tight text-white font-display tracking-tight sm:text-6xl">
            Envie arquivos grandes. <span class="text-gold-400">Com simplicidade.</span>
          </h1>
          <p class="mt-5 max-w-2xl text-lg leading-relaxed text-slate-300">
            Compartilhe vídeos 4K, pastas pesadas e projetos criativos de até 5 TB sem compressão. Seus primeiros 10 GB são grátis e o destinatário baixa sem cadastro.
          </p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row">
            <a href="#uploader-stage" class="btn-gold inline-flex min-h-[48px] items-center justify-center rounded-xl px-6 py-3.5 text-sm font-bold shadow-xl shadow-gold-500/20 tap-tactile">
              Enviar arquivos grátis
            </a>
            <a href="/pt/planos" class="btn-outline-gold inline-flex min-h-[48px] items-center justify-center rounded-xl px-6 py-3.5 text-sm font-bold tap-tactile">
              Ver planos e pacotes pré-pagos
            </a>
          </div>
        </div>

        <div id="uploader-stage" class="scroll-mt-24">
          <div class="apple-glass rounded-3xl p-4 sm:p-6 border border-white/10 shadow-2xl">
            <TransferEmbed client:load />
          </div>
        </div>
      </div>
    </section>

    <!-- Core Benefits -->
    <section class="border-b border-white/10 bg-ocean-900/50 py-14">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl">
          <h2 class="text-2xl sm:text-3xl font-black text-white font-display">
            Por que equipes criativas e empresas escolhem o {brand.productName}
          </h2>
          <p class="mt-2 text-sm text-slate-300">
            Servidores locais de alta velocidade em São Paulo e Rio de Janeiro com preços claros e sem mensalidades obrigatórias.
          </p>
        </div>
        <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
          {PT_CORE_VALUE_PROPOSITIONS.map((prop) => (
            <div class="apple-glass rounded-2xl p-6">
              <span class="inline-block rounded-full bg-gold-500/10 border border-gold-500/30 px-2.5 py-0.5 text-[11px] font-mono text-gold-400">
                {prop.badge}
              </span>
              <h3 class="mt-3 text-base font-bold text-white font-display">{prop.title}</h3>
              <p class="mt-2 text-xs leading-relaxed text-slate-300">{prop.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Practical Guides -->
    <section class="border-b border-white/10 bg-ocean-900/30 py-14">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4">
          <div>
            <h2 class="text-2xl sm:text-3xl font-black text-white font-display">
              Guias práticos de transferência
            </h2>
            <p class="mt-1 text-sm text-slate-300">
              Aprenda como enviar vídeos, projetos de engenharia e arquivos pesados com máxima velocidade.
            </p>
          </div>
          <a href="/pt/guias" class="inline-flex min-h-[44px] items-center text-xs font-bold text-gold-400 hover:underline">
            Ver todos os guias →
          </a>
        </div>
        <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {PT_ENGINEERING_GUIDES.slice(0, 3).map((guide) => (
            <a
              href={`/pt/guias/${guide.slug}`}
              class="group flex flex-col justify-between rounded-2xl border border-white/10 bg-ocean-900/85 p-5 transition hover:border-gold-500/50 tap-tactile"
            >
              <div>
                <span class="text-[11px] font-mono text-gold-400">{guide.readTime}</span>
                <h3 class="mt-2 text-base font-bold text-white group-hover:text-gold-400 font-display leading-snug">
                  {guide.h1}
                </h3>
                <p class="mt-2 text-xs text-slate-300 line-clamp-2">{guide.summary}</p>
              </div>
              <span class="mt-4 text-xs font-bold text-gold-400">Ler guia →</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Collapsible Workflow Directory -->
    <section id="solucoes" class="mx-auto max-w-5xl px-4 py-16 sm:px-6 lg:px-8">
      <div class="text-center mb-10 space-y-2">
        <h2 class="text-2xl sm:text-3xl font-black text-white font-display">
          Soluções por fluxo de trabalho ({ptSeoLandingPages.length})
        </h2>
        <p class="text-sm text-slate-300 max-w-2xl mx-auto">
          Selecione uma categoria para explorar guias dedicados por tamanho de arquivo, formato profissional ou área de atuação.
        </p>
      </div>

      <div class="space-y-3">
        {clusters.map((cluster) => (
          <details id={`cluster-${cluster.id}`} class="group rounded-2xl border border-white/10 bg-ocean-900/50 p-5">
            <summary class="flex min-h-[44px] cursor-pointer list-none items-center justify-between text-base font-bold text-white font-display">
              <span class="flex items-center gap-3">
                <span>{cluster.icon}</span>
                <span>{cluster.title}</span>
                <span class="rounded-full bg-ocean-950 px-2.5 py-0.5 text-xs font-mono text-gold-400 border border-gold-500/20">
                  {cluster.pages.length}
                </span>
              </span>
              <span class="transition-transform duration-200 group-open:rotate-180 text-gold-400" aria-hidden="true">▾</span>
            </summary>
            <div class="mt-4 grid gap-3 border-t border-white/10 pt-4 sm:grid-cols-2 lg:grid-cols-3">
              {cluster.pages.map((page) => (
                <a
                  href={`/pt/${page.slug}`}
                  class="min-h-[44px] rounded-xl border border-white/10 bg-ocean-900/80 px-4 py-3 text-xs text-slate-200 hover:border-gold-500/50 hover:text-gold-400 transition flex items-center justify-between gap-2 tap-tactile"
                >
                  <span class="line-clamp-1">{page.h1}</span>
                  <span class="text-gold-400/70 shrink-0">→</span>
                </a>
              ))}
            </div>
          </details>
        ))}
      </div>
    </section>

    <PtFooter />
  </main>
</BaseLayout>
