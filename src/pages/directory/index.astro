---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { seoLandingPages } from "../../data/seoLandingPages";
import { ptSeoLandingPages, PT_CLUSTER_METADATA } from "../../data/ptSeoLandingPages";
import { brand } from "@/lib/brand";

export const prerender = true;

const canonical = `${brand.siteUrl}/directory`;

const categories = [
  {
    id: "video-cinema",
    title: "Cinema & Video Post-Production",
    icon: "🎬",
    description: "Transfer raw camera masters, multi-camera sequences, and NLE project bundles without compression.",
    keywords: ["braw", "r3d", "arri", "mxf", "davinci", "premiere", "final-cut", "video"],
  },
  {
    id: "vfx-3d",
    title: "3D Animation, VFX & Simulation",
    icon: "🏢",
    description: "Send multi-gigabyte 3D project files, simulation caches, and frame sequences directly to render nodes.",
    keywords: ["maya", "blender", "cinema-4d", "houdini", "unreal", "openexr", "revit"],
  },
  {
    id: "audio-music",
    title: "Audio Engineering & Music Stems",
    icon: "🎚️",
    description: "Collaborate on DAWs and send uncompressed 24-bit/96kHz multitrack audio stems with zero data loss.",
    keywords: ["protools", "ableton", "logic-pro", "stems"],
  },
  {
    id: "competitor-bypass",
    title: "Quota Bypass & Cloud Alternatives",
    icon: "⚡",
    description: "Instant alternatives when legacy cloud storage, email, or free tools hit hard upload and download limits.",
    keywords: ["wetransfer", "google-drive", "dropbox", "email-attachment", "alternative", "bypass"],
  },
  {
    id: "sizes",
    title: "File Size Capacity Tiers",
    icon: "📦",
    description: "Direct upload channels optimized for exact capacity limits from 5GB free tiers to 2TB multi-part transfers.",
    keywords: ["5gb", "10gb", "15gb", "20gb", "25gb", "30gb", "50gb", "100gb", "500gb", "1tb", "2tb", "larger-than-2gb"],
  },
];

// Group landing pages by category
const groupedPages = categories.map((cat) => {
  const pages = seoLandingPages.filter((page) =>
    cat.keywords.some((kw) => page.slug.toLowerCase().includes(kw))
  );
  return {
    ...cat,
    pages,
  };
});

// Any pages not explicitly matched go to general
const matchedSlugs = new Set(groupedPages.flatMap((g) => g.pages.map((p) => p.slug)));
const generalPages = seoLandingPages.filter((page) => !matchedSlugs.has(page.slug));

const collectionSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: `${brand.productName} File Transfer Directory`,
  description: "Browse optimized transfer destinations for high-capacity media files, 3D projects, cinema RAW codecs, and cloud quota bypasses.",
  url: canonical,
};
---

<BaseLayout
  title={`File Transfer Directory & Codec Solutions | ${brand.productName}`}
  description="Browse specialized high-capacity file transfer destinations. Send BRAW, RED R3D, Blender, DaVinci, Ableton, and bypass 2GB upload quotas directly."
  canonical={canonical}
  hreflang={[
    { lang: "en", href: canonical },
    { lang: "es", href: `${brand.siteUrl}/es` },
    { lang: "pt-BR", href: `${brand.siteUrl}/pt` },
    { lang: "x-default", href: canonical },
  ]}
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(collectionSchema)} />
  </Fragment>

  <main class="min-h-screen bg-ocean-950 text-slate-100 font-body">
    <header class="sticky top-0 z-50 border-b border-white/10 bg-ocean-950/85 backdrop-blur-2xl">
      <nav class="mx-auto flex max-w-7xl items-center justify-between px-4 py-4 sm:px-6 lg:px-8" aria-label="Primary">
        <a href="/" class="flex items-center gap-3 text-xl font-extrabold font-display tracking-tight text-white group tap-tactile">
          <span class="flex h-8 w-8 items-center justify-center rounded-xl bg-gradient-to-tr from-gold-500 to-amber-300 text-ocean-900 font-black font-display text-base shadow-lg shadow-gold-500/20 group-hover:scale-105 transition-transform">G</span>
          <span class="group-hover:text-gold-400 transition-colors">{brand.productName}</span>
        </a>
        <div class="flex items-center gap-4 sm:gap-6 text-xs font-medium text-slate-300">
          <a class="hidden md:inline hover:text-gold-400 transition-colors" href="/transfer">Transfer</a>
          <a class="hidden md:inline hover:text-gold-400 transition-colors" href="/plans">Plans</a>
          <a class="hidden lg:inline hover:text-gold-400 transition-colors" href="/compare">Compare</a>
          <a class="hidden sm:inline text-gold-400 font-bold" href="/directory">Directory</a>
          <a class="hidden lg:inline hover:text-gold-400 transition-colors" href="/guides">Guides</a>
          <a class="hidden xl:inline hover:text-gold-400 transition-colors" href="/tools/transfer-speed-calculator">Speed Calculator</a>
          <a class="hidden lg:inline hover:text-gold-400 transition-colors" href="/blogs">Blog</a>
          <a class="hidden lg:inline hover:text-gold-400 transition-colors" href="/contact">Contact</a>
          <div class="inline-flex items-center rounded-xl border border-white/15 bg-ocean-900/90 p-1 text-xs font-mono" role="group" aria-label="Language switcher">
            <a
              href="/directory?lang=en"
              onclick="document.cookie='gigasend_lang=en; path=/; max-age=31536000; SameSite=Lax'"
              class="inline-flex min-h-[36px] min-w-[36px] items-center justify-center rounded-lg px-2.5 py-1.5 font-bold bg-gold-500/15 text-gold-400"
              aria-current="true"
            >
              EN
            </a>
            <span class="mx-0.5 text-slate-600" aria-hidden="true">|</span>
            <a
              href="/es?lang=es"
              onclick="document.cookie='gigasend_lang=es; path=/; max-age=31536000; SameSite=Lax'"
              class="inline-flex min-h-[36px] min-w-[36px] items-center justify-center rounded-lg px-2.5 py-1.5 text-slate-300 hover:text-white transition-colors"
            >
              ES
            </a>
            <span class="mx-0.5 text-slate-600" aria-hidden="true">|</span>
            <a
              href="/pt?lang=pt"
              onclick="document.cookie='gigasend_lang=pt; path=/; max-age=31536000; SameSite=Lax'"
              class="inline-flex min-h-[36px] min-w-[36px] items-center justify-center rounded-lg px-2.5 py-1.5 text-slate-300 hover:text-white transition-colors"
            >
              PT
            </a>
          </div>
          <a class="btn-gold px-3.5 py-2 rounded-xl text-xs font-bold shadow-md shadow-gold-500/10 tap-tactile" href="/transfer">Send Files</a>
        </div>
      </nav>
    </header>

    <!-- Breadcrumb Navigation -->
    <nav aria-label="Breadcrumb" class="border-b border-white/10 bg-ocean-950/90 px-4 py-3 sm:px-6 lg:px-8">
      <ol class="mx-auto flex max-w-7xl items-center gap-2 text-xs font-mono text-slate-400">
        <li><a href="/" class="hover:text-gold-400 transition-colors">Home</a></li>
        <li>/</li>
        <li class="text-gold-400 font-semibold" aria-current="page">Directory</li>
      </ol>
    </nav>

    <!-- Hero Section -->
    <section class="relative pt-20 pb-16 px-6 bg-gradient-to-b from-ocean-950 via-ocean-900 to-ocean-950 text-center border-b border-white/10">
      <div class="mx-auto max-w-4xl space-y-5">
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-ocean-800/80 border border-gold-500/30 text-gold-400 label-caps text-xs shadow-lg shadow-ocean-950/60">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          Enterprise Transfer Index • 335+ Edge PoPs
        </div>
        <h1 class="text-4xl sm:text-6xl font-black tracking-tight text-white font-display">
          Large File Transfer <span class="text-gold-400">Directory.</span>
        </h1>
        <p class="mx-auto max-w-2xl text-lg text-slate-300 leading-relaxed">
          Engineered transfer channels optimized for exact media formats, creative applications, and high-volume data payloads up to 5TB. Powered by Cloudflare's 335+ edge PoPs with zero file compression.
        </p>

        <!-- Category Quick Navigation Pills -->
        <div class="pt-4 flex flex-wrap items-center justify-center gap-3">
          {groupedPages.map((cat) => (
            <a
              href={`#${cat.id}`}
              class="px-4 py-2 rounded-xl bg-ocean-900/80 border border-white/10 hover:border-gold-500/60 text-slate-200 hover:text-gold-400 transition text-xs font-mono flex items-center gap-2 shadow-sm tap-tactile"
            >
              <span>{cat.icon}</span>
              <span class="font-bold">{cat.title}</span>
              <span class="text-gold-400 text-[10px] bg-ocean-950 px-1.5 py-0.5 rounded-md border border-ocean-800">{cat.pages.length}</span>
            </a>
          ))}
        </div>

        <div class="pt-4 flex flex-wrap justify-center gap-4">
          <a href="/transfer" class="btn-gold inline-flex items-center justify-center rounded-xl px-7 py-3.5 text-xs font-bold shadow-xl shadow-gold-500/20 tap-tactile">
            Transfer files now
          </a>
          <a href="/plans" class="btn-outline-gold inline-flex items-center justify-center rounded-xl px-7 py-3.5 text-xs font-bold tap-tactile">
            View storage tiers
          </a>
        </div>
      </div>
    </section>

    <!-- Categories Grid -->
    <section class="py-16 sm:py-20 bg-ocean-950">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 space-y-16">
        {groupedPages.map((cat) => (
          <div id={cat.id} class="apple-glass rounded-3xl border border-white/10 bg-ocean-900/80 p-8 shadow-2xl">
            <div class="border-b border-white/10 pb-5 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
              <div>
                <div class="flex items-center gap-3">
                  <span class="text-2xl">{cat.icon}</span>
                  <h2 class="text-2xl font-black text-white font-display">{cat.title}</h2>
                  <span class="px-2.5 py-0.5 rounded-full bg-ocean-800 border border-gold-500/30 text-gold-400 text-xs font-mono">
                    {cat.pages.length} Guides
                  </span>
                </div>
                <p class="mt-2 text-sm text-slate-300">{cat.description}</p>
              </div>
            </div>
            <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
              {cat.pages.map((page) => (
                <a
                  href={`/${page.slug}`}
                  class="group flex flex-col justify-between rounded-2xl border border-white/10 bg-ocean-950/60 p-5 transition hover:border-gold-500/50 hover:bg-ocean-900 hover:shadow-xl tap-tactile"
                >
                  <div>
                    <span class="inline-block rounded-md bg-gold-500/10 border border-gold-500/30 px-2.5 py-0.5 text-[10px] font-semibold uppercase tracking-wider text-gold-400 font-mono">
                      {page.eyebrow}
                    </span>
                    <h3 class="mt-3 text-base font-bold text-white group-hover:text-gold-400 font-display transition-colors">
                      {page.h1}
                    </h3>
                    <p class="mt-2 text-xs leading-relaxed text-slate-300 line-clamp-2">
                      {page.intro}
                    </p>
                  </div>
                  <div class="mt-4 pt-3 border-t border-white/10 flex items-center justify-between text-xs font-mono font-semibold text-gold-400">
                    <span>Send this format</span>
                    <span class="transition-transform group-hover:translate-x-1">→</span>
                  </div>
                </a>
              ))}
            </div>
          </div>
        ))}

        {generalPages.length > 0 && (
          <div class="apple-glass rounded-3xl border border-white/10 bg-ocean-900/80 p-8 shadow-2xl">
            <div class="border-b border-white/10 pb-5">
              <div class="flex items-center gap-3">
                <span class="text-2xl">🚀</span>
                <h2 class="text-2xl font-black text-white font-display">Core Transfer Utilities</h2>
                <span class="px-2.5 py-0.5 rounded-full bg-ocean-800 border border-gold-500/30 text-gold-400 text-xs font-mono">
                  {generalPages.length} Guides
                </span>
              </div>
              <p class="mt-2 text-sm text-slate-300">General high-performance large file dispatch solutions.</p>
            </div>
            <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
              {generalPages.map((page) => (
                <a
                  href={`/${page.slug}`}
                  class="group flex flex-col justify-between rounded-2xl border border-white/10 bg-ocean-950/60 p-5 transition hover:border-gold-500/50 hover:bg-ocean-900 hover:shadow-xl tap-tactile"
                >
                  <div>
                    <span class="inline-block rounded-md bg-gold-500/10 border border-gold-500/30 px-2.5 py-0.5 text-[10px] font-semibold uppercase tracking-wider text-gold-400 font-mono">
                      {page.eyebrow}
                    </span>
                    <h3 class="mt-3 text-base font-bold text-white group-hover:text-gold-400 font-display transition-colors">
                      {page.h1}
                    </h3>
                    <p class="mt-2 text-xs leading-relaxed text-slate-300 line-clamp-2">
                      {page.intro}
                    </p>
                  </div>
                  <div class="mt-4 pt-3 border-t border-white/10 flex items-center justify-between text-xs font-mono font-semibold text-gold-400">
                    <span>Send now</span>
                    <span class="transition-transform group-hover:translate-x-1">→</span>
                  </div>
                </a>
              ))}
            </div>
          </div>
        )}
      </div>
    </section>

    <!-- Engineering Guides, Cost Calculators & Architecture Comparisons -->
    <section class="border-t border-white/10 bg-ocean-900/60 py-16 sm:py-20">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 border-b border-white/10 pb-6">
          <div>
            <span class="label-caps text-gold-400 text-xs">Technical Resource Hub</span>
            <h2 class="mt-1 text-3xl font-black text-white font-display">
              Engineering Guides, Cost Calculators & Architecture Comparisons
            </h2>
            <p class="mt-2 text-sm text-slate-300 max-w-2xl">
              Explore deep-dive WAN latency diagnostics, zero-egress cost models, and interactive throughput tools for post-production and engineering teams.
            </p>
          </div>
          <a href="/guides" class="inline-flex items-center gap-2 text-xs font-mono font-bold text-gold-400 hover:text-gold-300 transition-colors">
            <span>All Production & Engineering Guides</span>
            <span>→</span>
          </a>
        </div>

        <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          <a href="/guides" class="group apple-glass flex flex-col justify-between rounded-2xl border border-white/10 bg-ocean-900/80 p-6 shadow-xl transition hover:border-gold-500/50 hover:bg-ocean-900 tap-tactile">
            <div>
              <span class="inline-block rounded-md bg-gold-500/10 border border-gold-500/30 px-2.5 py-0.5 text-[10px] font-semibold uppercase tracking-wider text-gold-400 font-mono">Resource Index</span>
              <h3 class="mt-3 text-base font-bold text-white group-hover:text-gold-400 font-display transition-colors">All Production & Engineering Guides</h3>
              <p class="mt-2 text-xs text-slate-300 leading-relaxed">Browse all technical architecture guides, WAN latency tutorials, and studio workflow breakdowns.</p>
            </div>
            <div class="mt-4 pt-3 border-t border-white/10 flex items-center justify-between text-xs font-mono font-semibold text-gold-400">
              <span>Explore Guides Hub</span>
              <span class="transition-transform group-hover:translate-x-1">→</span>
            </div>
          </a>

          <a href="/guides/why-large-file-transfers-are-slow" class="group apple-glass flex flex-col justify-between rounded-2xl border border-white/10 bg-ocean-900/80 p-6 shadow-xl transition hover:border-gold-500/50 hover:bg-ocean-900 tap-tactile">
            <div>
              <span class="inline-block rounded-md bg-gold-500/10 border border-gold-500/30 px-2.5 py-0.5 text-[10px] font-semibold uppercase tracking-wider text-gold-400 font-mono">WAN & Infrastructure</span>
              <h3 class="mt-3 text-base font-bold text-white group-hover:text-gold-400 font-display transition-colors">Why Large File Transfers Are So Slow (And How to Fix It)</h3>
              <p class="mt-2 text-xs text-slate-300 leading-relaxed">Diagnose TCP window scaling, peering latency, and packet loss bottlenecks on 25GB–2TB file transfers.</p>
            </div>
            <div class="mt-4 pt-3 border-t border-white/10 flex items-center justify-between text-xs font-mono font-semibold text-gold-400">
              <span>Read Engineering Guide</span>
              <span class="transition-transform group-hover:translate-x-1">→</span>
            </div>
          </a>

          <a href="/guides/large-file-transfer-cost-calculator" class="group apple-glass flex flex-col justify-between rounded-2xl border border-white/10 bg-ocean-900/80 p-6 shadow-xl transition hover:border-gold-500/50 hover:bg-ocean-900 tap-tactile">
            <div>
              <span class="inline-block rounded-md bg-gold-500/10 border border-gold-500/30 px-2.5 py-0.5 text-[10px] font-semibold uppercase tracking-wider text-gold-400 font-mono">Cost & Billing</span>
              <h3 class="mt-3 text-base font-bold text-white group-hover:text-gold-400 font-display transition-colors">Large File Transfer Cost Calculator (PAYG vs. Subscriptions)</h3>
              <p class="mt-2 text-xs text-slate-300 leading-relaxed">Compare pay-as-you-go pricing vs WeTransfer, Dropbox, and cloud egress surcharges for 50GB–5TB deliveries.</p>
            </div>
            <div class="mt-4 pt-3 border-t border-white/10 flex items-center justify-between text-xs font-mono font-semibold text-gold-400">
              <span>Read Cost Analysis</span>
              <span class="transition-transform group-hover:translate-x-1">→</span>
            </div>
          </a>

          <a href="/guides/transfer-large-files-without-failed-uploads" class="group apple-glass flex flex-col justify-between rounded-2xl border border-white/10 bg-ocean-900/80 p-6 shadow-xl transition hover:border-gold-500/50 hover:bg-ocean-900 tap-tactile">
            <div>
              <span class="inline-block rounded-md bg-gold-500/10 border border-gold-500/30 px-2.5 py-0.5 text-[10px] font-semibold uppercase tracking-wider text-gold-400 font-mono">Reliability & Resilience</span>
              <h3 class="mt-3 text-base font-bold text-white group-hover:text-gold-400 font-display transition-colors">How to Transfer Large Files Without Failed Uploads</h3>
              <p class="mt-2 text-xs text-slate-300 leading-relaxed">How client-side chunking, multi-part parallel streams, and automatic resumption prevent failed 50GB+ uploads.</p>
            </div>
            <div class="mt-4 pt-3 border-t border-white/10 flex items-center justify-between text-xs font-mono font-semibold text-gold-400">
              <span>Read Reliability Guide</span>
              <span class="transition-transform group-hover:translate-x-1">→</span>
            </div>
          </a>

          <a href="/guides/file-transfer-vs-cloud-storage-vs-media-review" class="group apple-glass flex flex-col justify-between rounded-2xl border border-white/10 bg-ocean-900/80 p-6 shadow-xl transition hover:border-gold-500/50 hover:bg-ocean-900 tap-tactile">
            <div>
              <span class="inline-block rounded-md bg-gold-500/10 border border-gold-500/30 px-2.5 py-0.5 text-[10px] font-semibold uppercase tracking-wider text-gold-400 font-mono">Workflow Architecture</span>
              <h3 class="mt-3 text-base font-bold text-white group-hover:text-gold-400 font-display transition-colors">File Transfer vs Cloud Storage vs Media Review</h3>
              <p class="mt-2 text-xs text-slate-300 leading-relaxed">When to use ephemeral point-to-point transfer vs persistent cloud sync vs frame-accurate review tools.</p>
            </div>
            <div class="mt-4 pt-3 border-t border-white/10 flex items-center justify-between text-xs font-mono font-semibold text-gold-400">
              <span>Read Workflow Guide</span>
              <span class="transition-transform group-hover:translate-x-1">→</span>
            </div>
          </a>

          <a href="/guides/send-large-files-without-filling-computer" class="group apple-glass flex flex-col justify-between rounded-2xl border border-white/10 bg-ocean-900/80 p-6 shadow-xl transition hover:border-gold-500/50 hover:bg-ocean-900 tap-tactile">
            <div>
              <span class="inline-block rounded-md bg-gold-500/10 border border-gold-500/30 px-2.5 py-0.5 text-[10px] font-semibold uppercase tracking-wider text-gold-400 font-mono">Storage Optimization</span>
              <h3 class="mt-3 text-base font-bold text-white group-hover:text-gold-400 font-display transition-colors">How to Send Large Files Without Filling Up Your Hard Drive</h3>
              <p class="mt-2 text-xs text-slate-300 leading-relaxed">Stop cloud sync apps from cloning 200GB project folders onto your local SSD with direct browser streaming.</p>
            </div>
            <div class="mt-4 pt-3 border-t border-white/10 flex items-center justify-between text-xs font-mono font-semibold text-gold-400">
              <span>Read Storage Guide</span>
              <span class="transition-transform group-hover:translate-x-1">→</span>
            </div>
          </a>

          <a href="/tools/transfer-speed-calculator" class="group apple-glass flex flex-col justify-between rounded-2xl border border-white/10 bg-ocean-900/80 p-6 shadow-xl transition hover:border-gold-500/50 hover:bg-ocean-900 tap-tactile">
            <div>
              <span class="inline-block rounded-md bg-gold-500/10 border border-gold-500/30 px-2.5 py-0.5 text-[10px] font-semibold uppercase tracking-wider text-gold-400 font-mono">Interactive Telemetry</span>
              <h3 class="mt-3 text-base font-bold text-white group-hover:text-gold-400 font-display transition-colors">Large File Transfer Speed Calculator</h3>
              <p class="mt-2 text-xs text-slate-300 leading-relaxed">Calculate exact upload times for 1GB to 2TB payloads across 10 Mbps to 10 Gbps pipes with TCP overhead.</p>
            </div>
            <div class="mt-4 pt-3 border-t border-white/10 flex items-center justify-between text-xs font-mono font-semibold text-gold-400">
              <span>Launch Calculator</span>
              <span class="transition-transform group-hover:translate-x-1">→</span>
            </div>
          </a>

          <a href="/compare" class="group apple-glass flex flex-col justify-between rounded-2xl border border-white/10 bg-ocean-900/80 p-6 shadow-xl transition hover:border-gold-500/50 hover:bg-ocean-900 tap-tactile">
            <div>
              <span class="inline-block rounded-md bg-gold-500/10 border border-gold-500/30 px-2.5 py-0.5 text-[10px] font-semibold uppercase tracking-wider text-gold-400 font-mono">Architecture Matrix</span>
              <h3 class="mt-3 text-base font-bold text-white group-hover:text-gold-400 font-display transition-colors">Cloudflare Edge vs AWS Relays Comparison</h3>
              <p class="mt-2 text-xs text-slate-300 leading-relaxed">Compare Gigasend's zero-egress edge architecture against MASV, WeTransfer, Dropbox, and Google Drive.</p>
            </div>
            <div class="mt-4 pt-3 border-t border-white/10 flex items-center justify-between text-xs font-mono font-semibold text-gold-400">
              <span>View Comparison Matrix</span>
              <span class="transition-transform group-hover:translate-x-1">→</span>
            </div>
          </a>

          <a href="/blogs" class="group apple-glass flex flex-col justify-between rounded-2xl border border-white/10 bg-ocean-900/80 p-6 shadow-xl transition hover:border-gold-500/50 hover:bg-ocean-900 tap-tactile">
            <div>
              <span class="inline-block rounded-md bg-gold-500/10 border border-gold-500/30 px-2.5 py-0.5 text-[10px] font-semibold uppercase tracking-wider text-gold-400 font-mono">Engineering Dispatches</span>
              <h3 class="mt-3 text-base font-bold text-white group-hover:text-gold-400 font-display transition-colors">Gigasend Engineering & Workflow Blog</h3>
              <p class="mt-2 text-xs text-slate-300 leading-relaxed">Read articles on zero-egress infrastructure, post-production file delivery, and remote studio pipelines.</p>
            </div>
