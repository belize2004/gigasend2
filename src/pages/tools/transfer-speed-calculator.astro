---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SpeedCalculator from "../../components/SpeedCalculator";
import { brand } from "@/lib/brand";

export const prerender = true;

const canonical = `${brand.siteUrl}/tools/transfer-speed-calculator`;

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: "Gigasend Large File Transfer Speed Calculator",
  url: canonical,
  applicationCategory: "UtilitiesApplication",
  operatingSystem: "All",
  browserRequirements: "Requires JavaScript",
  offers: {
    "@type": "Offer",
    price: "0.00",
    priceCurrency: "USD",
  },
};

const howToSchema = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  name: "How to Estimate Large File Transfer Times",
  description: "Estimate realistic upload durations by selecting your file size and internet upload speed.",
  step: [
    {
      "@type": "HowToStep",
      name: "Select your file size",
      text: "Choose your file or archive size from 1 GB up to 2 TB.",
    },
    {
      "@type": "HowToStep",
      name: "Select your upload speed",
      text: "Choose your internet upload connection speed in Mbps or Gbps.",
    },
    {
      "@type": "HowToStep",
      name: "Compare transfer times",
      text: "Review the estimated transfer duration with parallel multi-stream upload compared to a standard single-stream cloud upload.",
    },
  ],
};

const faqs = [
  {
    question: "How long does it take to upload a 10 GB file on gigabit internet?",
    answer: "On a 1 Gbps fiber connection, a 10 GB file uploads in about 90 seconds with Gigasend's parallel multi-stream uploader.",
  },
  {
    question: "Why is my upload slower than my internet speed test?",
    answer: "Speed tests connect to a nearby local server, while standard cloud uploads use a single connection to a distant data center.",
  },
  {
    question: "What happens if my internet connection drops during a large upload?",
    answer: "Gigasend splits files into smaller blocks and automatically retries interrupted blocks without restarting your entire upload.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: faq.answer,
    },
  })),
};
---

<BaseLayout
  title={`File Transfer Speed Calculator — Estimate Upload Times | ${brand.productName}`}
  description="Estimate upload and download times for 1 GB to 2 TB files across 10 Mbps to 10 Gbps connections. Compare parallel multi-stream transfers with standard cloud uploads."
  canonical={canonical}
  hreflang={[
    { lang: "en", href: canonical },
    { lang: "es", href: `${brand.siteUrl}/es/enviar-archivos-mas-de-2gb` },
    { lang: "pt-BR", href: `${brand.siteUrl}/pt/calculadora-tempo-upload` },
    { lang: "x-default", href: canonical },
  ]}
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(webAppSchema)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(howToSchema)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <main class="min-h-screen bg-ocean-950 text-slate-100 font-body">
    <!-- Header -->
    <header class="sticky top-0 z-50 border-b border-white/10 bg-ocean-950/85 backdrop-blur-2xl">
      <nav class="mx-auto flex max-w-7xl items-center justify-between px-4 py-4 sm:px-6 lg:px-8" aria-label="Primary">
        <a href="/" class="flex items-center gap-3 text-xl font-extrabold font-display tracking-tight text-white group tap-tactile">
          <span class="flex h-8 w-8 items-center justify-center rounded-xl bg-gradient-to-tr from-gold-500 to-amber-300 text-ocean-900 font-black font-display text-base shadow-lg shadow-gold-500/20 group-hover:scale-105 transition-transform">G</span>
          <span class="group-hover:text-gold-400 transition-colors">{brand.productName}</span>
        </a>
        <div class="flex items-center gap-4 sm:gap-6 text-xs font-medium text-slate-300">
          <a class="hidden md:inline hover:text-gold-400 transition-colors" href="/transfer">Transfer</a>
          <a class="hidden md:inline hover:text-gold-400 transition-colors" href="/plans">Plans</a>
          <a class="hidden lg:inline hover:text-gold-400 transition-colors" href="/compare">Compare</a>
          <a class="hidden lg:inline hover:text-gold-400 transition-colors" href="/directory">Directory</a>
          <a class="hidden lg:inline hover:text-gold-400 transition-colors" href="/guides">Guides</a>
          <a class="hidden sm:inline text-gold-400 font-bold" href="/tools/transfer-speed-calculator">Speed Calculator</a>
          <a class="hidden lg:inline hover:text-gold-400 transition-colors" href="/contact">Contact</a>
          <div class="inline-flex items-center rounded-xl border border-white/15 bg-ocean-900/90 p-1 text-xs font-mono" role="group" aria-label="Language switcher">
            <a href="/tools/transfer-speed-calculator?lang=en" onclick="document.cookie='gigasend_lang=en; path=/; max-age=31536000; SameSite=Lax'" class="inline-flex min-h-[36px] min-w-[36px] items-center justify-center rounded-lg px-2.5 py-1.5 font-bold bg-gold-500/15 text-gold-400" aria-current="true">EN</a>
            <span class="mx-0.5 text-slate-600" aria-hidden="true">|</span>
            <a href="/es/enviar-archivos-mas-de-2gb?lang=es" onclick="document.cookie='gigasend_lang=es; path=/; max-age=31536000; SameSite=Lax'" class="inline-flex min-h-[36px] min-w-[36px] items-center justify-center rounded-lg px-2.5 py-1.5 text-slate-300 hover:text-white transition-colors">ES</a>
            <span class="mx-0.5 text-slate-600" aria-hidden="true">|</span>
            <a href="/pt/calculadora-tempo-upload?lang=pt" onclick="document.cookie='gigasend_lang=pt; path=/; max-age=31536000; SameSite=Lax'" class="inline-flex min-h-[36px] min-w-[36px] items-center justify-center rounded-lg px-2.5 py-1.5 text-slate-300 hover:text-white transition-colors">PT</a>
          </div>
          <a class="btn-gold px-3.5 py-2 rounded-xl text-xs font-bold shadow-md shadow-gold-500/10 tap-tactile" href="/transfer">Send Files</a>
        </div>
      </nav>
    </header>

    <!-- Breadcrumb Navigation -->
    <nav aria-label="Breadcrumb" class="border-b border-white/10 bg-ocean-950/90 px-4 py-3 sm:px-6 lg:px-8">
      <ol class="mx-auto flex max-w-7xl items-center gap-2 text-xs font-mono text-slate-400">
        <li><a href="/" class="hover:text-gold-400 transition-colors">Home</a></li>
        <li aria-hidden="true">/</li>
        <li><a href="/guides" class="hover:text-gold-400 transition-colors">Tools & Guides</a></li>
        <li aria-hidden="true">/</li>
        <li class="text-gold-400 font-semibold" aria-current="page">Transfer Speed Calculator</li>
      </ol>
    </nav>

    <!-- Calculator Hero -->
    <section class="py-12 sm:py-16 bg-gradient-to-b from-ocean-950 via-ocean-900 to-ocean-950">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="mx-auto max-w-3xl text-center mb-10">
          <span class="label-caps text-gold-400 text-xs">Free Transfer Utility</span>
          <h1 class="mt-2 text-3xl font-black tracking-tight text-white font-display sm:text-5xl">
            File Transfer Speed Calculator
          </h1>
          <p class="mt-3 text-base text-slate-300">
            See how long your large files will take to upload and how parallel streaming speeds up delivery.
          </p>
        </div>
        <SpeedCalculator client:load />
      </div>
    </section>

    <!-- Reference Table -->
    <section class="border-t border-white/10 bg-ocean-950 py-16">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <span class="label-caps text-gold-400 text-xs">Quick Reference</span>
        <h2 class="mt-1 text-3xl font-black tracking-tight text-white font-display">
          Upload Time Reference Chart
        </h2>
        <p class="mt-2 text-base text-slate-300">
          Estimated upload times across common home and studio internet speeds.
        </p>

        <div class="mt-8 overflow-hidden rounded-3xl border border-white/10 bg-ocean-900/80 shadow-2xl apple-glass backdrop-blur-2xl">
          <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-white/10 text-left text-sm text-slate-300">
              <thead class="bg-ocean-950/90 text-slate-300 font-semibold">
                <tr>
                  <th scope="col" class="px-6 py-4 text-white label-caps text-xs">File Size</th>
                  <th scope="col" class="px-6 py-4 text-slate-300 label-caps text-xs">50 Mbps</th>
                  <th scope="col" class="px-6 py-4 text-slate-300 label-caps text-xs">100 Mbps</th>
                  <th scope="col" class="px-6 py-4 text-slate-300 label-caps text-xs">500 Mbps</th>
                  <th scope="col" class="px-6 py-4 text-gold-400 label-caps text-xs border-l border-gold-500/30 bg-ocean-900/90">1 Gbps</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-white/10 bg-ocean-900/40 text-slate-300 font-mono text-xs sm:text-sm">
                <tr class="hover:bg-ocean-800/40 transition-colors">
                  <td class="px-6 py-4 font-bold text-white font-display">2 GB</td>
                  <td class="px-6 py-4">~6 min</td>
                  <td class="px-6 py-4">~3 min</td>
                  <td class="px-6 py-4">~35 sec</td>
                  <td class="px-6 py-4 font-bold text-gold-400 border-l border-gold-500/30 bg-ocean-900/60">~18 sec</td>
                </tr>
                <tr class="hover:bg-ocean-800/40 transition-colors">
                  <td class="px-6 py-4 font-bold text-white font-display">10 GB</td>
                  <td class="px-6 py-4">~28 min</td>
                  <td class="px-6 py-4">~14 min</td>
                  <td class="px-6 py-4">~3 min</td>
                  <td class="px-6 py-4 font-bold text-gold-400 border-l border-gold-500/30 bg-ocean-900/60">~1.5 min</td>
                </tr>
                <tr class="hover:bg-ocean-800/40 transition-colors">
                  <td class="px-6 py-4 font-bold text-white font-display">50 GB</td>
                  <td class="px-6 py-4">~2 hr 20 min</td>
                  <td class="px-6 py-4">~1 hr 10 min</td>
                  <td class="px-6 py-4">~15 min</td>
                  <td class="px-6 py-4 font-bold text-gold-400 border-l border-gold-500/30 bg-ocean-900/60">~7 min</td>
                </tr>
                <tr class="hover:bg-ocean-800/40 transition-colors">
                  <td class="px-6 py-4 font-bold text-white font-display">250 GB</td>
                  <td class="px-6 py-4">~11.5 hr</td>
                  <td class="px-6 py-4">~5 hr 50 min</td>
                  <td class="px-6 py-4">~1 hr 10 min</td>
                  <td class="px-6 py-4 font-bold text-gold-400 border-l border-gold-500/30 bg-ocean-900/60">~35 min</td>
                </tr>
                <tr class="hover:bg-ocean-800/40 transition-colors">
                  <td class="px-6 py-4 font-bold text-white font-display">1 TB</td>
                  <td class="px-6 py-4">~48 hr</td>
                  <td class="px-6 py-4">~24 hr</td>
                  <td class="px-6 py-4">~4 hr 45 min</td>
                  <td class="px-6 py-4 font-bold text-gold-400 border-l border-gold-500/30 bg-ocean-900/60">~2.5 hr</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </section>

    <!-- 3 Concise Human-Benefit Cards + 3 Concise FAQs -->
    <section class="border-t border-white/10 bg-ocean-900/50 py-16">
      <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 space-y-16">
        <div>
          <div class="text-center max-w-2xl mx-auto">
            <span class="label-caps text-gold-400 text-xs">Built for Speed</span>
            <h2 class="mt-1 text-2xl font-black text-white font-display sm:text-3xl">
              Why {brand.productName} Uploads Faster
            </h2>
          </div>

          <div class="mt-8 grid gap-6 md:grid-cols-3">
            <div class="apple-glass rounded-2xl border border-white/10 bg-ocean-900/80 p-6 shadow-lg">
              <h3 class="text-lg font-bold text-white font-display">Nearest Regional Server</h3>
              <p class="mt-2 text-sm text-slate-300 leading-relaxed">
                Files upload directly to the closest server among 335+ global locations, minimizing long-distance lag.
              </p>
            </div>

            <div class="apple-glass rounded-2xl border border-white/10 bg-ocean-900/80 p-6 shadow-lg">
              <h3 class="text-lg font-bold text-white font-display">Parallel Multi-Stream Upload</h3>
              <p class="mt-2 text-sm text-slate-300 leading-relaxed">
                Large files are split into concurrent blocks that upload simultaneously to maximize your internet speed.
              </p>
            </div>

            <div class="apple-glass rounded-2xl border border-white/10 bg-ocean-900/80 p-6 shadow-lg">
              <h3 class="text-lg font-bold text-white font-display">Automatic Pause & Resume</h3>
              <p class="mt-2 text-sm text-slate-300 leading-relaxed">
                If your Wi-Fi drops briefly, only the affected block retries—your upload never restarts from zero.
              </p>
            </div>
          </div>
        </div>

        <!-- 3 Concise FAQs -->
        <div class="max-w-3xl mx-auto">
          <div class="text-center">
            <span class="label-caps text-gold-400 text-xs">Common Questions</span>
            <h2 class="mt-1 text-2xl font-black text-white font-display">Transfer Speed FAQs</h2>
          </div>
          <dl class="mt-8 space-y-4">
            {faqs.map((faq) => (
              <div class="apple-glass rounded-2xl border border-white/10 bg-ocean-900/80 p-6 shadow-md">
                <dt class="text-base font-bold text-white font-display">{faq.question}</dt>
                <dd class="mt-2 text-sm text-slate-300 leading-relaxed">{faq.answer}</dd>
              </div>
            ))}
          </dl>
        </div>
      </div>
    </section>

    <!-- Bottom Action CTA -->
    <section class="border-t border-white/10 bg-gradient-to-b from-ocean-900 to-ocean-950 py-20">
      <div class="mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
        <span class="label-caps text-gold-400 text-xs">10 GB Free • 3-Day Retention</span>
        <h2 class="mt-2 text-3xl font-black tracking-tight text-white font-display sm:text-4xl">
          Test Your Transfer Speed Now
        </h2>
        <p class="mx-auto mt-4 max-w-2xl text-base sm:text-lg text-slate-300">
          Send up to 10 GB free with no account required, or scale up to 5 TB with monthly plans and pay-as-you-go credit packs.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-4">
          <a href="/transfer" class="btn-gold rounded-xl px-8 py-4 text-xs font-bold shadow-xl shadow-gold-500/20 tap-tactile">
            Send 10 GB Free
          </a>
          <a href="/plans" class="btn-outline-gold rounded-xl px-8 py-4 text-xs font-bold tap-tactile">
            View Plans & Pricing
          </a>
        </div>
      </div>
    </section>

    <!-- Apple HIG Dark Blue SEO Footer -->
    <footer class="border-t border-white/10 bg-ocean-950 py-14 text-xs text-slate-400">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
          <div>
            <a href="/" class="flex items-center gap-2.5 text-base font-extrabold font-display text-white">
              <span class="flex h-7 w-7 items-center justify-center rounded-lg bg-gradient-to-tr from-gold-500 to-amber-300 text-ocean-900 font-black text-sm">G</span>
              <span>{brand.productName}</span>
            </a>
            <p class="mt-3 text-slate-400 leading-relaxed">
              Fast, reliable large file transfer across 335+ global server locations. Send up to 10 GB free.
            </p>
          </div>
          <div>
            <h3 class="font-bold text-white uppercase tracking-wider font-mono text-[11px]">Platform & Tools</h3>
            <ul class="mt-3 space-y-2">
              <li><a href="/transfer" class="hover:text-gold-400 transition-colors">Send Large Files</a></li>
              <li><a href="/plans" class="hover:text-gold-400 transition-colors">Plans & Pricing</a></li>
              <li><a href="/compare" class="hover:text-gold-400 transition-colors">Provider Comparison</a></li>
              <li><a href="/tools/transfer-speed-calculator" class="hover:text-gold-400 transition-colors">Transfer Speed Calculator</a></li>
              <li><a href="/directory" class="hover:text-gold-400 transition-colors">Workflow & Codec Directory</a></li>
            </ul>
          </div>
          <div>
            <h3 class="font-bold text-white uppercase tracking-wider font-mono text-[11px]">Guides</h3>
            <ul class="mt-3 space-y-2">
              <li><a href="/guides" class="hover:text-gold-400 transition-colors">All Guides</a></li>
              <li><a href="/guides/why-large-file-transfers-are-slow" class="hover:text-gold-400 transition-colors">Why Transfers Are Slow</a></li>
              <li><a href="/guides/large-file-transfer-cost-calculator" class="hover:text-gold-400 transition-colors">Transfer Cost Calculator</a></li>
              <li><a href="/guides/transfer-large-files-without-failed-uploads" class="hover:text-gold-400 transition-colors">Prevent Failed Uploads</a></li>
              <li><a href="/guides/file-transfer-vs-cloud-storage-vs-media-review" class="hover:text-gold-400 transition-colors">Transfer vs. Cloud vs. Review</a></li>
              <li><a href="/guides/send-large-files-without-filling-computer" class="hover:text-gold-400 transition-colors">Send Without Filling Disk Space</a></li>
            </ul>
          </div>
          <div>
            <h3 class="font-bold text-white uppercase tracking-wider font-mono text-[11px]">Popular Workflows & Support</h3>
            <ul class="mt-3 space-y-2">
              <li><a href="/send-large-files-free" class="hover:text-gold-400 transition-colors">Send Large Files Free (10 GB)</a></li>
              <li><a href="/wetransfer-alternative" class="hover:text-gold-400 transition-colors">WeTransfer Alternative</a></li>
              <li><a href="/send-large-video-files" class="hover:text-gold-400 transition-colors">Send Large Video Files</a></li>
              <li><a href="/blogs" class="hover:text-gold-400 transition-colors">Blog</a></li>
              <li><a href="/contact" class="hover:text-gold-400 transition-colors">Contact Support</a></li>
              <li><a href="/terms" class="hover:text-gold-400 transition-colors">Terms</a> · <a href="/privacy-policy" class="hover:text-gold-400 transition-colors">Privacy</a></li>
            </ul>
          </div>
        </div>
        <div class="mt-10 border-t border-white/10 pt-6 flex flex-col sm:flex-row items-center justify-between gap-4">
          <p>© {new Date().getFullYear()} {brand.productName}. All rights reserved.</p>
          <div class="flex gap-4">
            <a href="/security" class="hover:text-gold-400 transition-colors">Security</a>
            <a href="/privacy-policy" class="hover:text-gold-400 transition-colors">Privacy Policy</a>
            <a href="/terms" class="hover:text-gold-400 transition-colors">Terms of Service</a>
            <a href="/contact" class="hover:text-gold-400 transition-colors">Contact</a>
          </div>
        </div>
      </div>
    </footer>
  </main>
</BaseLayout>

