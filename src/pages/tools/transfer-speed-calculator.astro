---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SpeedCalculator from "../../components/SpeedCalculator";
import { brand } from "@/lib/brand";

export const prerender = true;

const canonical = `${brand.siteUrl}/tools/transfer-speed-calculator`;

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: "Gigasend Large File Transfer Speed Calculator",
  url: canonical,
  applicationCategory: "UtilitiesApplication",
  operatingSystem: "All",
  browserRequirements: "Requires JavaScript",
  offers: {
    "@type": "Offer",
    price: "0.00",
    priceCurrency: "USD",
  },
};

const howToSchema = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  name: "How to Calculate Large File Transfer Times Over WAN",
  description: "Calculate your realistic upload duration by balancing payload size, network bandwidth, and edge multi-part efficiency.",
  step: [
    {
      "@type": "HowToStep",
      name: "Select your total file payload",
      text: "Convert your file or project archive size to Megabits (1 GB = 8,192 Megabits).",
    },
    {
      "@type": "HowToStep",
      name: "Determine sustained upload bandwidth",
      text: "Input your actual sustained upload speed in Mbps rather than peak burst advertised speed.",
    },
    {
      "@type": "HowToStep",
      name: "Account for protocol overhead and latency",
      text: "Factor in TCP handshakes, window scaling, and packet loss (standard HTTP transfers achieve ~65% efficiency, while edge multi-part achieves ~92%).",
    },
  ],
};

const faqs = [
  {
    question: "How long does it take to upload a 10GB file on gigabit internet?",
    answer: "On a full 1 Gbps fiber uplink, a 10GB file uploads in approximately 85 to 95 seconds under unthrottled line-rate conditions with ~92% edge multi-part efficiency.",
  },
  {
    question: "Why is my real upload speed slower than my internet speed test?",
    answer: "Speed tests measure ping to local ISP servers, whereas cloud uploads encounter WAN latency, single-stream TCP window limits, and server-side ingress throttling. Connecting directly to Anycast edge nodes minimizes this penalty.",
  },
  {
    question: "What is the fastest way to upload a 100GB file?",
    answer: "Multi-stream HTTP/3 parallel chunking connected to an Anycast edge point of presence is the fastest way, eliminating round-trip bottlenecks and packet drop penalties.",
  },
  {
    question: "How does file size affect transfer reliability?",
    answer: "As payload sizes grow beyond 10GB, single-stream HTTP uploads have an exponential probability of packet drop socket timeouts unless chunked resumability and multi-part upload streaming are used.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: faq.answer,
    },
  })),
};
---

<BaseLayout
  title={`File Transfer Speed Calculator: Estimate Upload Times | ${brand.productName}`}
  description="Calculate exact upload and download times for 1GB to 2TB files across 10 Mbps to 10 Gbps uplinks. Real-world transfer duration with TCP overhead calculations."
  canonical={canonical}
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(webAppSchema)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(howToSchema)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <main class="min-h-screen bg-slate-50 text-slate-950">
    <!-- Header -->
    <header class="border-b border-slate-200 bg-white">
      <nav class="mx-auto flex max-w-7xl items-center justify-between px-4 py-4 sm:px-6 lg:px-8" aria-label="Primary">
        <a href="/" class="flex items-center gap-2 text-xl font-bold text-slate-950">
          <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-blue-600 text-white">↑</span>
          {brand.productName}
        </a>
        <div class="hidden items-center gap-6 text-sm font-medium text-slate-700 sm:flex">
          <a class="hover:text-blue-700" href="/transfer">Transfer</a>
          <a class="hover:text-blue-700" href="/plans">Plans</a>
          <a class="hover:text-blue-700" href="/directory">Directory</a>
          <a class="hover:text-blue-700" href="/send-large-files-free">Free transfer</a>
        </div>
      </nav>
    </header>

    <!-- Calculator Hero -->
    <section class="py-12 sm:py-16">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <SpeedCalculator client:load />
      </div>
    </section>

    <!-- Reference Table -->
    <section class="border-t border-slate-200 bg-white py-16">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <h2 class="text-3xl font-bold tracking-tight text-slate-950">
          Quick Upload Time Reference Chart
        </h2>
        <p class="mt-2 text-base text-slate-600">
          Estimated real-world upload durations across standard studio and home fiber bandwidth tiers.
        </p>

        <div class="mt-8 overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
          <table class="min-w-full divide-y divide-slate-200 text-left text-sm">
            <thead class="bg-slate-50 text-slate-900 font-semibold">
              <tr>
                <th scope="col" class="px-6 py-4">Payload Size</th>
                <th scope="col" class="px-6 py-4">50 Mbps (Cable)</th>
                <th scope="col" class="px-6 py-4">100 Mbps (Broadband)</th>
                <th scope="col" class="px-6 py-4">300 Mbps (Fiber)</th>
                <th scope="col" class="px-6 py-4">1 Gbps (Gigabit)</th>
                <th scope="col" class="px-6 py-4">10 Gbps (Dedicated)</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-200 text-slate-700">
              <tr>
                <td class="px-6 py-4 font-bold text-slate-900">5 GB</td>
                <td class="px-6 py-4">~14 min</td>
                <td class="px-6 py-4">~7 min</td>
                <td class="px-6 py-4">~2.5 min</td>
                <td class="px-6 py-4">~45 sec</td>
                <td class="px-6 py-4 font-semibold text-blue-700">~5 sec</td>
              </tr>
              <tr>
                <td class="px-6 py-4 font-bold text-slate-900">10 GB</td>
                <td class="px-6 py-4">~28 min</td>
                <td class="px-6 py-4">~14 min</td>
                <td class="px-6 py-4">~5 min</td>
                <td class="px-6 py-4">~1.5 min</td>
                <td class="px-6 py-4 font-semibold text-blue-700">~9 sec</td>
              </tr>
              <tr>
                <td class="px-6 py-4 font-bold text-slate-900">25 GB</td>
                <td class="px-6 py-4">~1 hr 10 min</td>
                <td class="px-6 py-4">~35 min</td>
                <td class="px-6 py-4">~12 min</td>
                <td class="px-6 py-4">~3.5 min</td>
                <td class="px-6 py-4 font-semibold text-blue-700">~22 sec</td>
              </tr>
              <tr>
                <td class="px-6 py-4 font-bold text-slate-900">50 GB</td>
                <td class="px-6 py-4">~2 hr 20 min</td>
                <td class="px-6 py-4">~1 hr 10 min</td>
                <td class="px-6 py-4">~24 min</td>
                <td class="px-6 py-4">~7 min</td>
                <td class="px-6 py-4 font-semibold text-blue-700">~45 sec</td>
              </tr>
              <tr>
                <td class="px-6 py-4 font-bold text-slate-900">100 GB</td>
                <td class="px-6 py-4">~4 hr 40 min</td>
                <td class="px-6 py-4">~2 hr 20 min</td>
                <td class="px-6 py-4">~48 min</td>
                <td class="px-6 py-4">~14 min</td>
                <td class="px-6 py-4 font-semibold text-blue-700">~1.5 min</td>
              </tr>
              <tr>
                <td class="px-6 py-4 font-bold text-slate-900">1 TB (1000 GB)</td>
                <td class="px-6 py-4">~48 hr</td>
                <td class="px-6 py-4">~24 hr</td>
                <td class="px-6 py-4">~8 hr</td>
                <td class="px-6 py-4">~2.5 hr</td>
                <td class="px-6 py-4 font-semibold text-blue-700">~15 min</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Technical Guide / E-E-A-T Content -->
    <section class="border-t border-slate-200 bg-slate-50 py-16">
      <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 space-y-12">
        <div>
          <h2 class="text-2xl font-bold text-slate-950 sm:text-3xl">
            Why Do Large File Transfers Feel Slower Than Your Advertised Speed?
          </h2>
          <p class="mt-4 text-base leading-relaxed text-slate-600">
            When you purchase a 1 Gbps broadband plan, internet service providers quote line-rate burst speeds. However, when uploading massive 4K video clips, raw camera rushes, or 3D scene files, standard browser uploads rarely achieve full speed due to fundamental protocol bottlenecks:
          </p>
          <ul class="mt-6 space-y-4 text-sm text-slate-700">
            <li class="flex gap-3">
              <span class="font-bold text-blue-600">1.</span>
              <span><strong>Round-Trip Time (RTT) & TCP Slow-Start:</strong> Legacy cloud services (such as AWS S3 or Google Drive) terminate uploads in distant centralized data centers (e.g. us-east-1). If you are 50ms away, every lost packet forces TCP to halve its congestion window, drastically dropping throughput.</span>
            </li>
            <li class="flex gap-3">
              <span class="font-bold text-blue-600">2.</span>
              <span><strong>Single-Threaded HTTP Uploads:</strong> Traditional web forms upload entire files as a single continuous byte stream. If a 45GB upload encounters a 2-second Wi-Fi hiccup at 98%, the connection drops and must be restarted from zero.</span>
            </li>
            <li class="flex gap-3">
              <span class="font-bold text-blue-600">3.</span>
              <span><strong>The Gigasend Edge Advantage:</strong> Gigasend solves this by splitting files client-side into secure chunks and streaming them concurrently to the nearest Cloudflare Anycast edge node (over 335+ cities globally). Latency drops to &lt;15ms, eliminating packet-loss slowdowns and maximizing your pipe.</span>
            </li>
          </ul>
        </div>

        <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
          <h3 class="text-xl font-bold text-slate-950">How Gigasend Calculates Transfer Speed</h3>
          <p class="mt-3 text-sm text-slate-600 leading-relaxed">
            The formula calculates the wire-time in bits:
          </p>
          <pre class="mt-3 rounded-lg bg-slate-900 p-4 font-mono text-xs text-emerald-400 overflow-x-auto">Time (seconds) = (File Size in GB × 8,192 Megabits) ÷ (Upload Speed in Mbps × TCP Efficiency)</pre>
          <p class="mt-3 text-sm text-slate-600 leading-relaxed">
            While legacy web uploaders suffer from ~65% efficiency due to high RTT, Gigasend's multi-part parallel edge architecture maintains sustained efficiency near 92% of your physical bandwidth ceiling.
          </p>
        </div>

        <!-- FAQs -->
        <div>
          <h3 class="text-2xl font-bold text-slate-950">Transfer Speed & Network FAQs</h3>
          <dl class="mt-6 space-y-6">
            {faqs.map((faq) => (
              <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
                <dt class="text-base font-semibold text-slate-950">{faq.question}</dt>
                <dd class="mt-2 text-sm text-slate-600 leading-relaxed">{faq.answer}</dd>
              </div>
            ))}
          </dl>
        </div>
      </div>
    </section>

    <!-- Bottom Action CTA -->
    <section class="border-t border-slate-200 bg-white py-16">
      <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
        <h2 class="text-3xl font-bold tracking-tight text-slate-950 sm:text-4xl">
          Test Your Transfer Speed Now
        </h2>
        <p class="mx-auto mt-4 max-w-2xl text-lg text-slate-600">
          Send up to 25GB 100% free with zero registration, or transfer massive 2TB project payloads across global Anycast edge nodes.
        </p>
        <div class="mt-8 flex justify-center gap-4">
          <a href="/transfer" class="rounded-lg bg-blue-600 px-8 py-3.5 text-base font-semibold text-white shadow-sm hover:bg-blue-700">
            Send 25GB Free
          </a>
          <a href="/directory" class="rounded-lg border border-slate-300 bg-white px-8 py-3.5 text-base font-semibold text-slate-800 hover:border-blue-500">
            Explore Transfer Directory
          </a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
