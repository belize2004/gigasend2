---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { brand } from "@/lib/brand";

export const prerender = true;

const canonical = `${brand.siteUrl}/guides`;

const guides = [
  {
    slug: "why-large-file-transfers-are-slow",
    title: "Why Large File Transfers Are So Slow (And How to Fix It)",
    category: "WAN & Infrastructure",
    description: "Diagnosing TCP window scaling, peering latency, and packet loss bottlenecks on 25GB–2TB file transfers—plus how to achieve line-rate edge speeds.",
    readTime: "6 min read",
  },
  {
    slug: "large-file-transfer-cost-calculator",
    title: "Large File Transfer Cost Calculator (PAYG vs. Subscriptions)",
    category: "Cost & Billing",
    description: "Compare the real cost of sending 50GB to 5TB files. Pay-as-you-go pricing vs WeTransfer, Dropbox, and cloud storage egress fees.",
    readTime: "5 min read",
  },
  {
    slug: "transfer-large-files-without-failed-uploads",
    title: "How to Transfer Large Files Without Failed Uploads",
    category: "Reliability & Resilience",
    description: "How client-side chunking, multi-part parallel streams, and automatic resumption prevent failed 50GB+ uploads on unstable connections.",
    readTime: "4 min read",
  },
  {
    slug: "file-transfer-vs-cloud-storage-vs-media-review",
    title: "File Transfer vs Cloud Storage vs Media Review: The Right Tool for Creative Teams",
    category: "Workflow Architecture",
    description: "When to use ephemeral point-to-point transfer (Gigasend) versus persistent cloud storage (Google Drive/Dropbox) versus frame-by-frame review (Frame.io).",
    readTime: "7 min read",
  },
  {
    slug: "send-large-files-without-filling-computer",
    title: "How to Send Large Files Without Filling Up Your Hard Drive",
    category: "Storage Optimization",
    description: "Stop cloud sync apps from cloning 200GB project folders onto your local SSD. How direct browser streaming protects disk space.",
    readTime: "4 min read",
  },
];
---

<BaseLayout
  title={`Large File Transfer Engineering Guides | ${brand.productName}`}
  description="Technical guides, WAN latency diagnostics, and cost calculations for video editors, VFX studios, and remote creative teams transferring massive files."
  canonical={canonical}
  hreflang={[
    { lang: "en", href: canonical },
    { lang: "es", href: `${brand.siteUrl}/es` },
    { lang: "pt-BR", href: `${brand.siteUrl}/pt/guias` },
    { lang: "x-default", href: canonical },
  ]}
>
  <main class="min-h-screen bg-ocean-950 text-slate-100 font-body">
    <header class="sticky top-0 z-50 border-b border-white/10 bg-ocean-950/85 backdrop-blur-2xl">
      <nav class="mx-auto flex max-w-7xl items-center justify-between px-4 py-4 sm:px-6 lg:px-8" aria-label="Primary">
        <a href="/" class="flex items-center gap-3 text-xl font-extrabold font-display tracking-tight text-white group tap-tactile">
          <span class="flex h-8 w-8 items-center justify-center rounded-xl bg-gradient-to-tr from-gold-500 to-amber-300 text-ocean-900 font-black font-display text-base shadow-lg shadow-gold-500/20 group-hover:scale-105 transition-transform">G</span>
          <span class="group-hover:text-gold-400 transition-colors">{brand.productName}</span>
        </a>
        <div class="flex items-center gap-4 sm:gap-6 text-xs font-medium text-slate-300">
          <a class="hidden md:inline hover:text-gold-400 transition-colors" href="/transfer">Transfer</a>
          <a class="hidden md:inline hover:text-gold-400 transition-colors" href="/plans">Plans</a>
          <a class="hidden lg:inline hover:text-gold-400 transition-colors" href="/compare">Compare</a>
          <a class="hidden lg:inline hover:text-gold-400 transition-colors" href="/directory">Directory</a>
          <a class="hidden sm:inline text-gold-400 font-bold" href="/guides">Guides</a>
          <a class="hidden xl:inline hover:text-gold-400 transition-colors" href="/tools/transfer-speed-calculator">Speed Calculator</a>
          <a class="hidden lg:inline hover:text-gold-400 transition-colors" href="/contact">Contact</a>
          <div class="inline-flex items-center rounded-xl border border-white/15 bg-ocean-900/90 p-1 text-xs font-mono" role="group" aria-label="Language switcher">
            <a href="/guides?lang=en" onclick="document.cookie='gigasend_lang=en; path=/; max-age=31536000; SameSite=Lax'" class="inline-flex min-h-[36px] min-w-[36px] items-center justify-center rounded-lg px-2.5 py-1.5 font-bold bg-gold-500/15 text-gold-400" aria-current="true">EN</a>
            <span class="mx-0.5 text-slate-600" aria-hidden="true">|</span>
            <a href="/es?lang=es" onclick="document.cookie='gigasend_lang=es; path=/; max-age=31536000; SameSite=Lax'" class="inline-flex min-h-[36px] min-w-[36px] items-center justify-center rounded-lg px-2.5 py-1.5 text-slate-300 hover:text-white transition-colors">ES</a>
            <span class="mx-0.5 text-slate-600" aria-hidden="true">|</span>
            <a href="/pt/guias?lang=pt" onclick="document.cookie='gigasend_lang=pt; path=/; max-age=31536000; SameSite=Lax'" class="inline-flex min-h-[36px] min-w-[36px] items-center justify-center rounded-lg px-2.5 py-1.5 text-slate-300 hover:text-white transition-colors">PT</a>
          </div>
          <a class="btn-gold px-3.5 py-2 rounded-xl text-xs font-bold shadow-md shadow-gold-500/10 tap-tactile" href="/transfer">Send Files</a>
        </div>
      </nav>
    </header>

    <!-- Breadcrumb Navigation -->
    <nav aria-label="Breadcrumb" class="border-b border-white/10 bg-ocean-950/90 px-4 py-3 sm:px-6 lg:px-8">
      <ol class="mx-auto flex max-w-7xl items-center gap-2 text-xs font-mono text-slate-400">
        <li><a href="/" class="hover:text-gold-400 transition-colors">Home</a></li>
        <li>/</li>
        <li class="text-gold-400 font-semibold" aria-current="page">Guides</li>
      </ol>
    </nav>

    <section class="border-b border-white/10 bg-gradient-to-b from-ocean-950 via-ocean-900 to-ocean-950 py-16 sm:py-20">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl">
          <p class="inline-flex items-center gap-2 rounded-full bg-gold-500/10 border border-gold-500/30 px-3.5 py-1.5 text-xs font-semibold uppercase tracking-wider text-gold-400 label-caps">
            <span>⚡</span>
            <span>Technical Resource Center</span>
          </p>
          <h1 class="mt-4 text-4xl font-black tracking-tight text-white font-display sm:text-5xl">
            Large File Transfer Engineering Guides
          </h1>
          <p class="mt-4 text-lg text-slate-300 leading-relaxed">
            Deep technical insights on high-speed data transfer, TCP optimization, Cloudflare edge storage, and creator workflow architecture.
          </p>
        </div>
      </div>
    </section>

    <section class="py-16 bg-ocean-950">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
          {guides.map((guide) => (
            <a
              href={`/guides/${guide.slug}`}
              class="group apple-glass flex flex-col justify-between rounded-3xl border border-white/10 bg-ocean-900/80 p-8 shadow-xl transition hover:border-gold-500/50 hover:bg-ocean-900 tap-tactile"
            >
              <div>
                <div class="flex items-center justify-between text-xs font-semibold text-slate-400 font-mono">
                  <span class="rounded-md bg-gold-500/10 border border-gold-500/30 px-2.5 py-1 text-gold-400">{guide.category}</span>
                  <span>{guide.readTime}</span>
                </div>
                <h2 class="mt-4 text-xl font-bold text-white group-hover:text-gold-400 font-display transition-colors">
                  {guide.title}
                </h2>
                <p class="mt-3 text-sm leading-relaxed text-slate-300">
                  {guide.description}
                </p>
              </div>
              <div class="mt-6 pt-4 border-t border-white/10 flex items-center justify-between text-xs font-mono font-bold text-gold-400">
                <span>Read guide</span>
                <span class="transition-transform group-hover:translate-x-1">→</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Interactive Tools & Transfer Directory Cross-Links -->
    <section class="border-t border-white/10 bg-ocean-900/50 py-16">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 space-y-12">
        <div>
          <span class="label-caps text-gold-400 text-xs">Platform Telemetry & Hubs</span>
          <h2 class="mt-1 text-2xl font-black text-white font-display">Interactive Utilities & Transfer Solutions</h2>
          <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
            <a href="/tools/transfer-speed-calculator" class="group apple-glass rounded-2xl border border-white/10 bg-ocean-900/80 p-6 shadow-lg transition hover:border-gold-500/50 hover:bg-ocean-900 tap-tactile">
              <h3 class="font-bold text-white group-hover:text-gold-400 font-display transition-colors">Speed Calculator</h3>
              <p class="mt-2 text-sm text-slate-300">Simulate upload durations across 10 Mbps to 10 Gbps pipes with real-world TCP overhead.</p>
            </a>
            <a href="/directory" class="group apple-glass rounded-2xl border border-white/10 bg-ocean-900/80 p-6 shadow-lg transition hover:border-gold-500/50 hover:bg-ocean-900 tap-tactile">
              <h3 class="font-bold text-white group-hover:text-gold-400 font-display transition-colors">Codec & Software Directory</h3>
              <p class="mt-2 text-sm text-slate-300">Browse 46 optimized channels for BRAW, RED R3D, DaVinci, Blender, Ableton, and more.</p>
            </a>
            <a href="/compare" class="group apple-glass rounded-2xl border border-white/10 bg-ocean-900/80 p-6 shadow-lg transition hover:border-gold-500/50 hover:bg-ocean-900 tap-tactile">
              <h3 class="font-bold text-white group-hover:text-gold-400 font-display transition-colors">Competitor Matrix</h3>
              <p class="mt-2 text-sm text-slate-300">Compare free transfer caps and cloud egress costs across WeTransfer, Dropbox, Drive, and MASV.</p>
            </a>
            <a href="/blogs" class="group apple-glass rounded-2xl border border-white/10 bg-ocean-900/80 p-6 shadow-lg transition hover:border-gold-500/50 hover:bg-ocean-900 tap-tactile">
              <h3 class="font-bold text-white group-hover:text-gold-400 font-display transition-colors">Engineering Blog</h3>
              <p class="mt-2 text-sm text-slate-300">Dispatches on zero-egress edge infrastructure, production workflows, and media delivery.</p>
            </a>
          </div>
        </div>

        <div>
          <span class="label-caps text-gold-400 text-xs">Direct Workflow Channels</span>
          <h2 class="mt-1 text-2xl font-black text-white font-display">Key Production & Capacity Workflows</h2>
          <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            <a href="/send-large-files-free" class="group apple-subtle-glass rounded-2xl border border-white/10 bg-ocean-900/70 p-5 transition hover:border-gold-500/50 hover:bg-ocean-900 tap-tactile">
              <h3 class="font-bold text-white group-hover:text-gold-400 font-display text-sm transition-colors">Send Large Files Free (Up to 25GB)</h3>
              <p class="mt-1.5 text-xs text-slate-300">Zero-egress 25GB free transfers with 3-day retention and no account required.</p>
            </a>
            <a href="/free-large-file-transfer" class="group apple-subtle-glass rounded-2xl border border-white/10 bg-ocean-900/70 p-5 transition hover:border-gold-500/50 hover:bg-ocean-900 tap-tactile">
              <h3 class="font-bold text-white group-hover:text-gold-400 font-display text-sm transition-colors">Free Large File Transfer Service</h3>
              <p class="mt-1.5 text-xs text-slate-300">Instant browser-direct multipart uploads with pause, resume, and auto-retry.</p>
            </a>
            <a href="/wetransfer-alternative" class="group apple-subtle-glass rounded-2xl border border-white/10 bg-ocean-900/70 p-5 transition hover:border-gold-500/50 hover:bg-ocean-900 tap-tactile">
              <h3 class="font-bold text-white group-hover:text-gold-400 font-display text-sm transition-colors">WeTransfer Alternative</h3>
              <p class="mt-1.5 text-xs text-slate-300">Bypass the 2GB WeTransfer cap with 25GB free transfers and $0.16–$0.20/GB PAYG.</p>
            </a>
            <a href="/send-large-video-files" class="group apple-subtle-glass rounded-2xl border border-white/10 bg-ocean-900/70 p-5 transition hover:border-gold-500/50 hover:bg-ocean-900 tap-tactile">
              <h3 class="font-bold text-white group-hover:text-gold-400 font-display text-sm transition-colors">Send Large Video Files</h3>
              <p class="mt-1.5 text-xs text-slate-300">Deliver 4K/8K ProRes, DNxHR, and camera masters with zero transcoding or compression.</p>
            </a>
            <a href="/transfer-davinci-resolve-project" class="group apple-subtle-glass rounded-2xl border border-white/10 bg-ocean-900/70 p-5 transition hover:border-gold-500/50 hover:bg-ocean-900 tap-tactile">
              <h3 class="font-bold text-white group-hover:text-gold-400 font-display text-sm transition-colors">Transfer DaVinci Resolve Projects</h3>
              <p class="mt-1.5 text-xs text-slate-300">Send .dra project archives and graded camera media to colorists and finishing houses.</p>
            </a>
            <a href="/send-revit-rvt-bim-models" class="group apple-subtle-glass rounded-2xl border border-white/10 bg-ocean-900/70 p-5 transition hover:border-gold-500/50 hover:bg-ocean-900 tap-tactile">
              <h3 class="font-bold text-white group-hover:text-gold-400 font-display text-sm transition-colors">Send Revit (.RVT) & BIM Models</h3>
              <p class="mt-1.5 text-xs text-slate-300">Dispatch federated BIM models, point clouds, and CAD packages across engineering teams.</p>
            </a>
            <a href="/send-25gb-file" class="group apple-subtle-glass rounded-2xl border border-white/10 bg-ocean-900/70 p-5 transition hover:border-gold-500/50 hover:bg-ocean-900 tap-tactile">
              <h3 class="font-bold text-white group-hover:text-gold-400 font-display text-sm transition-colors">Send 25GB File Free</h3>
              <p class="mt-1.5 text-xs text-slate-300">Full 25GB capacity tier included free with sub-15ms Anycast edge ingestion.</p>
            </a>
            <a href="/send-100gb-file" class="group apple-subtle-glass rounded-2xl border border-white/10 bg-ocean-900/70 p-5 transition hover:border-gold-500/50 hover:bg-ocean-900 tap-tactile">
              <h3 class="font-bold text-white group-hover:text-gold-400 font-display text-sm transition-colors">Send 100GB File</h3>
              <p class="mt-1.5 text-xs text-slate-300">High-capacity 100GB multi-part delivery for commercial shoots and VFX turnovers.</p>
            </a>
            <a href="/send-1tb-file" class="group apple-subtle-glass rounded-2xl border border-white/10 bg-ocean-900/70 p-5 transition hover:border-gold-500/50 hover:bg-ocean-900 tap-tactile">
              <h3 class="font-bold text-white group-hover:text-gold-400 font-display text-sm transition-colors">Send 1TB File</h3>
              <p class="mt-1.5 text-xs text-slate-300">Enterprise terabyte-scale delivery saving $70/TB over AWS-taxed transfer tools.</p>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Apple HIG Dark Blue SEO Footer -->
    <footer class="border-t border-white/10 bg-ocean-950 py-14 text-xs text-slate-400">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
          <div>
            <a href="/" class="flex items-center gap-2.5 text-base font-extrabold font-display text-white">
              <span class="flex h-7 w-7 items-center justify-center rounded-lg bg-gradient-to-tr from-gold-500 to-amber-300 text-ocean-900 font-black text-sm">G</span>
              <span>{brand.productName}</span>
            </a>
            <p class="mt-3 text-slate-400 leading-relaxed">
              Zero-egress large file transfer powered by Cloudflare's 335+ Anycast edge network. Send up to 25GB free.
            </p>
          </div>
          <div>
            <h3 class="font-bold text-white uppercase tracking-wider font-mono text-[11px]">Platform & Tools</h3>
            <ul class="mt-3 space-y-2">
              <li><a href="/transfer" class="hover:text-gold-400 transition-colors">Send Large Files</a></li>
              <li><a href="/plans" class="hover:text-gold-400 transition-colors">Plans & Pricing</a></li>
              <li><a href="/compare" class="hover:text-gold-400 transition-colors">Architecture Comparison</a></li>
              <li><a href="/tools/transfer-speed-calculator" class="hover:text-gold-400 transition-colors">Transfer Speed Calculator</a></li>
              <li><a href="/directory" class="hover:text-gold-400 transition-colors">Codec & Format Directory</a></li>
            </ul>
          </div>
          <div>
            <h3 class="font-bold text-white uppercase tracking-wider font-mono text-[11px]">Engineering Guides</h3>
            <ul class="mt-3 space-y-2">
              <li><a href="/guides" class="hover:text-gold-400 transition-colors">All Engineering Guides</a></li>
              <li><a href="/guides/why-large-file-transfers-are-slow" class="hover:text-gold-400 transition-colors">Why Transfers Are Slow</a></li>
              <li><a href="/guides/large-file-transfer-cost-calculator" class="hover:text-gold-400 transition-colors">Transfer Cost Calculator</a></li>
              <li><a href="/guides/transfer-large-files-without-failed-uploads" class="hover:text-gold-400 transition-colors">Prevent Failed Uploads</a></li>
              <li><a href="/guides/file-transfer-vs-cloud-storage-vs-media-review" class="hover:text-gold-400 transition-colors">Transfer vs Cloud vs Review</a></li>
              <li><a href="/guides/send-large-files-without-filling-computer" class="hover:text-gold-400 transition-colors">Zero-Cache Browser Streaming</a></li>
            </ul>
          </div>
          <div>
            <h3 class="font-bold text-white uppercase tracking-wider font-mono text-[11px]">Popular Workflows & Support</h3>
            <ul class="mt-3 space-y-2">
              <li><a href="/send-large-files-free" class="hover:text-gold-400 transition-colors">Send Large Files Free (25GB)</a></li>
              <li><a href="/wetransfer-alternative" class="hover:text-gold-400 transition-colors">WeTransfer Alternative</a></li>
              <li><a href="/send-large-video-files" class="hover:text-gold-400 transition-colors">Send Large Video Files</a></li>
              <li><a href="/blogs" class="hover:text-gold-400 transition-colors">Engineering Blog</a></li>
              <li><a href="/contact" class="hover:text-gold-400 transition-colors">Contact Support</a></li>
              <li><a href="/terms" class="hover:text-gold-400 transition-colors">Terms</a> · <a href="/privacy-policy" class="hover:text-gold-400 transition-colors">Privacy</a></li>
            </ul>
          </div>
        </div>
        <div class="mt-10 border-t border-white/10 pt-6 flex flex-col sm:flex-row items-center justify-between gap-4">
          <p>© {new Date().getFullYear()} {brand.productName}. Engineered on Cloudflare Edge & R2.</p>
          <div class="flex gap-4">
            <a href="/security" class="hover:text-gold-400 transition-colors">Security</a>
            <a href="/privacy-policy" class="hover:text-gold-400 transition-colors">Privacy Policy</a>
            <a href="/terms" class="hover:text-gold-400 transition-colors">Terms of Service</a>
            <a href="/contact" class="hover:text-gold-400 transition-colors">Contact</a>
          </div>
        </div>
      </div>
    </footer>
  </main>
</BaseLayout>
