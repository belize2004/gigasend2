---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { seoLandingPages } from "../../data/seoLandingPages";
import { brand } from "@/lib/brand";
import TransferEmbed from "@/src/components/TransferEmbed";
import RelatedWorkflows from "@/src/components/seo/RelatedWorkflows.astro";

export const prerender = true;

export function getStaticPaths() {
  return seoLandingPages.map((page) => ({
    params: { slug: page.slug },
    props: { page },
  }));
}

const { page: landingPage } = Astro.props;
const canonical = `${brand.siteUrl}/${landingPage.slug}`;
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: landingPage.faqs.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: faq.answer,
    },
  })),
};
const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: `${brand.productName} — ${landingPage.h1}`,
  url: canonical,
  applicationCategory: "UtilitiesApplication",
  operatingSystem: "All",
  offers: {
    "@type": "Offer",
    price: "0.00",
    priceCurrency: "USD",
    description: "Free large file transfers up to 25GB with 3-day storage; high-capacity edge transfers from $0.16/GB.",
  },
};
---

<BaseLayout title={landingPage.title} description={landingPage.metaDescription} canonical={canonical}>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(webAppSchema)} />
  </Fragment>

  <main class="min-h-screen bg-slate-50 text-slate-950">
    <header class="border-b border-slate-200 bg-white">
      <nav class="mx-auto flex max-w-7xl items-center justify-between px-4 py-4 sm:px-6 lg:px-8" aria-label="Primary">
        <a href="/" class="flex items-center gap-2 text-xl font-bold text-slate-950">
          <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-blue-600 text-white">↑</span>
          {brand.productName}
        </a>
        <div class="hidden items-center gap-6 text-sm font-medium text-slate-700 sm:flex">
          <a class="hover:text-blue-700" href="/transfer">Transfer</a>
          <a class="hover:text-blue-700" href="/plans">Plans</a>
          <a class="hover:text-blue-700" href="/send-large-files-free">Free transfer</a>
        </div>
      </nav>
    </header>

    <section class="bg-white">
      <div class="mx-auto grid max-w-7xl gap-10 px-4 py-16 sm:px-6 lg:grid-cols-[1.1fr_0.9fr] lg:px-8 lg:py-20">
        <div>
          <p class="mb-4 text-sm font-semibold uppercase tracking-wide text-blue-700">{landingPage.eyebrow}</p>
          <h1 class="max-w-4xl text-4xl font-bold leading-tight text-slate-950 sm:text-5xl">{landingPage.h1}</h1>
          <p class="mt-6 max-w-3xl text-lg leading-8 text-slate-600">{landingPage.intro}</p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row">
            <a href="/transfer" class="inline-flex items-center justify-center rounded-lg bg-blue-600 px-6 py-3 text-base font-semibold text-white shadow-sm hover:bg-blue-700">
              {landingPage.cta}
            </a>
            <a href="/plans" class="inline-flex items-center justify-center rounded-lg border border-slate-300 bg-white px-6 py-3 text-base font-semibold text-slate-800 hover:border-blue-500 hover:text-blue-700">
              View plans
            </a>
          </div>
          <div class="mt-8 grid max-w-2xl grid-cols-3 gap-3 text-center text-sm">
            <div class="rounded-lg border border-slate-200 bg-slate-50 p-4">
              <div class="text-xl font-bold text-slate-950">25GB</div>
              <div class="mt-1 text-slate-600">Free transfers</div>
            </div>
            <div class="rounded-lg border border-slate-200 bg-slate-50 p-4">
              <div class="text-xl font-bold text-slate-950">3 days</div>
              <div class="mt-1 text-slate-600">Free storage</div>
            </div>
            <div class="rounded-lg border border-slate-200 bg-slate-50 p-4">
              <div class="text-xl font-bold text-slate-950">5TB</div>
              <div class="mt-1 text-slate-600">Enterprise</div>
            </div>
          </div>
        </div>

        <div class="flex flex-col gap-6">
          <TransferEmbed client:load />
          <aside class="rounded-2xl border border-slate-200 bg-slate-50 p-5 shadow-sm">
            <h2 class="text-sm font-bold text-slate-950 uppercase tracking-wide">Instant 3-Step Edge Transfer</h2>
            <ol class="mt-3 grid grid-cols-1 sm:grid-cols-3 gap-3 text-xs text-slate-700">
              <li class="flex items-center gap-2">
                <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-blue-600 text-xs font-bold text-white">1</span>
                <span><strong>Drop</strong> files above</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-blue-600 text-xs font-bold text-white">2</span>
                <span><strong>Line-speed</strong> upload</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-blue-600 text-xs font-bold text-white">3</span>
                <span><strong>Get 1-click link</strong></span>
              </li>
            </ol>
          </aside>
        </div>
      </div>
    </section>

    <section class="border-t border-slate-200 bg-slate-50 py-16">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <h2 class="text-3xl font-bold tracking-tight text-slate-950">Why choose {brand.productName} for large transfers</h2>
        <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {landingPage.sections.map((section) => (
            <article class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
              <h3 class="text-lg font-semibold text-slate-950">{section.heading}</h3>
              <p class="mt-3 text-sm leading-6 text-slate-600">{section.body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="border-t border-slate-200 bg-white py-16">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <h2 class="text-3xl font-bold tracking-tight text-slate-950">Compare delivery methods</h2>
        <div class="mt-8 overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
          <table class="min-w-full divide-y divide-slate-200 text-left text-sm">
            <thead class="bg-slate-50 text-slate-900">
              <tr>
                <th scope="col" class="px-6 py-4 font-semibold">Method</th>
                <th scope="col" class="px-6 py-4 font-semibold">Best for</th>
                <th scope="col" class="px-6 py-4 font-semibold">Limitation</th>
                <th scope="col" class="px-6 py-4 font-semibold">{brand.productName} advantage</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-200 bg-white text-slate-700">
              {landingPage.comparison.map((row) => (
                <tr>
                  <td class="whitespace-nowrap px-6 py-4 font-medium text-slate-950">{row.method}</td>
                  <td class="px-6 py-4">{row.bestFor}</td>
                  <td class="px-6 py-4 text-rose-700">{row.limitation}</td>
                  <td class="px-6 py-4 font-medium text-blue-700">{row.gigaSendAngle}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <section class="border-t border-slate-200 bg-slate-50 py-16">
      <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
        <h2 class="text-3xl font-bold tracking-tight text-slate-950">Frequently asked questions</h2>
        <dl class="mt-8 space-y-6">
          {landingPage.faqs.map((faq) => (
            <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
              <dt class="text-base font-semibold text-slate-950">{faq.question}</dt>
              <dd class="mt-3 text-sm leading-6 text-slate-600">{faq.answer}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <RelatedWorkflows
      currentSlug={landingPage.slug}
      internalLinks={landingPage.internalLinks}
      title="Related Transfer Solutions & Workflows"
    />
  </main>
</BaseLayout>
